@AbapCatalog.viewEnhancementCategory: [#NONE]
@AccessControl.authorizationCheck: #NOT_REQUIRED
@EndUserText.label: 'Monitor compras ASN'
@Metadata.ignorePropagatedAnnotations: true
define root view entity ZI_MM_MONCOMP
  as select from ZI_MM_MONCOMP_CALC as calc
{
  key calc.OC,
  key calc.Posicion,
  key calc.DeliveryDocument,
  key calc.FacturaRemision,
      calc.FechaOC,
      calc.StorageLoc,
      calc.ItemCateg,
      calc.Sociedad,
      calc.Material,
      calc.MatDesc,
      calc.Proveedor,
      calc.NombreProveedor,
      calc.Centro,
      calc.TipoDocumento,
      calc.IsNfm,
      @Semantics.quantity.unitOfMeasure: 'CantidadPedidaUnidad'
      calc.CantidadPedida,
      calc.CantidadPedidaUnidad,
      @Semantics.quantity.unitOfMeasure: 'CantidadRecebidaUnidad'
      calc.CantidadRecebida,
      calc.CantidadRecebidaUnidad,
      @Semantics.quantity.unitOfMeasure: 'CantidadPedidaUnidad'
      calc.CantidadPendiente,
      calc.PrecioOC,
      calc.PrecioOCTexto,
      calc.MonedaOC,
      calc.PrecioASN,
      calc.MonedaASN,
      calc.PrecioInforec,
      calc.PrecioInforecTexto,
      calc.MonedaInforec,
      calc.Cantidad,
      calc.DiferenciaOcAsn,
      calc.DiferenciaAsnInforec,
      calc.Estado,
      calc.UsuarioAprobador,
      calc.FechaAprobacion,
      calc.Nota,
      calc.FechaFactura,
      calc.PrecioUnitarioVigente,
      calc.UnidadPrecio,
      calc.UnidadBase,
      calc.FactorNfm,
      @EndUserText.label: 'Precio NFM'
      calc.PrecioNfm
}
where
  not(
       calc.PrecioASN is not null
   and calc.MonedaOC = calc.MonedaASN
   and(
         calc.PrecioOC = calc.PrecioASN
      or(
           calc.PrecioOC  <> calc.PrecioASN
       and calc.PrecioASN =  calc.PrecioInforec
       and(
             calc.MonedaInforec = calc.MonedaASN
          or calc.MonedaInforec is initial
       )
      )
   )
  )
