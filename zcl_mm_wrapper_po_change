CLASS zcl_mm_wrapper_po_change DEFINITION
  PUBLIC
  FINAL
  CREATE PUBLIC .

  PUBLIC SECTION.
    TYPES: BEGIN OF ty_poitem,
             po_item      TYPE ebelp,
             short_text   TYPE txz01,
             material     TYPE matnr18,
             plant        TYPE ewerk,
             stge_loc     TYPE lgort_d,
             item_cat     TYPE pstyp,
             net_price    TYPE bapicurext,
             price_unit   TYPE epein,
             quantity     TYPE bstmg,
             po_unit      TYPE bstme,
             no_more_gr   TYPE elikz,
             invoice_date TYPE dats,
           END OF ty_poitem,
           BEGIN OF ty_poitemx,
             po_item    TYPE ebelp,
             po_itemx   TYPE bapiupdate,
             short_text TYPE bapiupdate,
             material   TYPE bapiupdate,
             plant      TYPE bapiupdate,
             stge_loc   TYPE bapiupdate,
             item_cat   TYPE bapiupdate,
             net_price  TYPE bapiupdate,
             price_unit TYPE bapiupdate,
             quantity   TYPE bapiupdate,
             po_unit    TYPE bapiupdate,
             no_more_gr TYPE bapiupdate,
           END OF ty_poitemx,
           BEGIN OF ty_param,
             iv_purchaseorder TYPE vdm_purchaseorder,
             is_poheader      TYPE bapimepoheader,
             is_poheaderx     TYPE bapimepoheaderx,
             t_poitem         TYPE STANDARD TABLE OF ty_poitem  WITH DEFAULT KEY,
             t_poitemx        TYPE STANDARD TABLE OF ty_poitemx WITH DEFAULT KEY,
           END OF ty_param,
           BEGIN OF ty_posicion,
             posicion   TYPE vdm_purchaseorderitem,
             net_price  TYPE bapicurext,
             price_unit TYPE epein,
           END OF ty_posicion.

    TYPES: tt_posicion TYPE STANDARD TABLE OF ty_posicion WITH DEFAULT KEY,
           tt_return   TYPE STANDARD TABLE OF bapiret2    WITH DEFAULT KEY.

    CLASS-METHODS call_bapi_change_pos
      IMPORTING is_param         TYPE ty_param
      RETURNING VALUE(rt_return) TYPE tt_return.

    CLASS-METHODS call_bapi_new_pos
      IMPORTING is_param         TYPE ty_param
      EXPORTING et_posicion      TYPE tt_posicion
      RETURNING VALUE(rt_return) TYPE tt_return.
  PROTECTED SECTION.
  PRIVATE SECTION.
    TYPES: tt_poitemx TYPE HASHED TABLE OF ty_poitemx WITH UNIQUE KEY po_item,
           tt_cond    TYPE SORTED TABLE OF bapimepocond
                      WITH NON-UNIQUE KEY itm_number cond_type,
           tt_sched   TYPE SORTED TABLE OF bapimeposchedule
                      WITH NON-UNIQUE KEY po_item sched_line,
           tt_nfm     TYPE SORTED TABLE OF /nfm/bapidocitm
                      WITH NON-UNIQUE KEY itm_number nfmkey,
           tt_nfm_std TYPE STANDARD TABLE OF /nfm/bapidocitm WITH DEFAULT KEY,
           tt_torder  TYPE SORTED TABLE OF /nfm/torderpos
                      WITH NON-UNIQUE KEY belnr posnr nes.

    CLASS-METHODS get_gross_condition
      IMPORTING it_cond        TYPE tt_cond
                iv_po_item     TYPE ebelp
      RETURNING VALUE(rs_cond) TYPE bapimepocond.

    CLASS-METHODS apply_nfm_rates
      IMPORTING iv_purchaseorder TYPE vdm_purchaseorder
                iv_po_item       TYPE ebelp
                iv_invoice_date  TYPE dats
      CHANGING  ct_nfm           TYPE tt_nfm
                ct_nfm_ch        TYPE tt_nfm_std
                ct_return        TYPE tt_return.

    CLASS-METHODS select_nfm_oicqp
      IMPORTING iv_purchaseorder TYPE vdm_purchaseorder
                it_poitem        TYPE ty_param-t_poitem
                it_nfm           TYPE tt_nfm
      CHANGING  ct_nfm_ch        TYPE tt_nfm_std
                ct_return        TYPE tt_return.

    CLASS-METHODS persist_nfm_orderpos
      IMPORTING it_nfm_ch TYPE tt_nfm_std
                iv_bstyp  TYPE bstyp DEFAULT 'F'
      CHANGING  ct_return TYPE tt_return.

    CLASS-METHODS verify_nfm_orderpos
      IMPORTING it_nfm_ch TYPE tt_nfm_std
      CHANGING  ct_return TYPE tt_return.

    CLASS-METHODS ensure_nfm_currency
      IMPORTING iv_purchaseorder TYPE vdm_purchaseorder
                it_poitem        TYPE ty_param-t_poitem
                iv_bstyp         TYPE bstyp DEFAULT 'F'
      CHANGING  ct_return        TYPE tt_return.

    CLASS-METHODS fill_nfm_currency
      CHANGING cs_orderpos TYPE /nfm/orderpos_vb.

    CLASS-METHODS save_nfm_orderpos
      IMPORTING it_x             TYPE STANDARD TABLE
                it_y             TYPE STANDARD TABLE
                iv_bstyp         TYPE bstyp DEFAULT 'F'
      RETURNING VALUE(rs_return) TYPE bapiret2.

    CLASS-METHODS append_exc
      IMPORTING io_exc           TYPE REF TO cx_root
      RETURNING VALUE(rs_return) TYPE bapiret2.

    CLASS-METHODS append_nfm_currency_error
      IMPORTING iv_belnr         TYPE /nfm/torderpos-belnr
                iv_posnr         TYPE /nfm/torderpos-posnr
      RETURNING VALUE(rs_return) TYPE bapiret2.
ENDCLASS.

CLASS zcl_mm_wrapper_po_change IMPLEMENTATION.
  METHOD append_exc.
    DATA(lv_text) = io_exc->get_text( ).
    rs_return-type       = 'E'.
    rs_return-id         = 'ZCL_MSG_MM_003'.
    rs_return-number     = '016'.
    rs_return-message    = lv_text.
    rs_return-message_v1 = lv_text.
  ENDMETHOD.

  METHOD append_nfm_currency_error.
    rs_return-type       = 'E'.
    rs_return-id         = 'ZCL_MSG_MM_003'.
    rs_return-number     = '037'.
    rs_return-message_v1 = iv_belnr.
    rs_return-message_v2 = iv_posnr.
  ENDMETHOD.

  METHOD fill_nfm_currency.
    IF cs_orderpos-nkw IS INITIAL AND cs_orderpos-bcu IS NOT INITIAL.
      cs_orderpos-nkw = cs_orderpos-bcu.
    ENDIF.
    IF cs_orderpos-bcu IS INITIAL AND cs_orderpos-nkw IS NOT INITIAL.
      cs_orderpos-bcu = cs_orderpos-nkw.
    ENDIF.
    IF cs_orderpos-bkw IS INITIAL AND cs_orderpos-nkw IS NOT INITIAL.
      cs_orderpos-bkw = cs_orderpos-nkw.
    ENDIF.
    IF cs_orderpos-nks IS INITIAL AND cs_orderpos-nkw IS NOT INITIAL AND cs_orderpos-nkw = cs_orderpos-bcu.
      cs_orderpos-nks = 1.
    ENDIF.
  ENDMETHOD.

  METHOD save_nfm_orderpos.
    DATA: lt_x TYPE STANDARD TABLE OF /nfm/orderpos_vb,
          lt_y TYPE STANDARD TABLE OF /nfm/orderpos_vb.

    lt_x = it_x.
    lt_y = it_y.

    IF lt_x IS INITIAL.
      RETURN.
    ENDIF.

    TRY.
        CALL FUNCTION '/NFM/ORDERPOS_SAVE'
          EXPORTING
            i_vbtyp     = 'B'
            i_kappl     = 'M'
            i_vorgang   = 'V'
            i_bstyp     = iv_bstyp
          TABLES
            t_xorderpos = lt_x
            t_yorderpos = lt_y
          EXCEPTIONS
            OTHERS      = 1.
        IF sy-subrc <> 0.
          rs_return-type       = 'E'.
          rs_return-id         = 'ZCL_MSG_MM_003'.
          rs_return-number     = '016'.
          rs_return-message_v1 = |/NFM/ORDERPOS_SAVE subrc { sy-subrc }|.
        ENDIF.
      CATCH cx_root INTO DATA(lx_save).
        rs_return = append_exc( lx_save ).
    ENDTRY.
  ENDMETHOD.

  METHOD verify_nfm_orderpos.
    TYPES: BEGIN OF ty_chk,
             belnr TYPE /nfm/torderpos-belnr,
             posnr TYPE /nfm/torderpos-posnr,
             nes   TYPE /nfm/torderpos-nes,
             nkn   TYPE /nfm/torderpos-nkn,
             kta   TYPE /nfm/torderpos-kta,
             ndt   TYPE /nfm/torderpos-ndt,
           END OF ty_chk.

    DATA: lt_chk TYPE SORTED TABLE OF ty_chk WITH NON-UNIQUE KEY belnr posnr nes,
          lv_nkn TYPE /nfm/torderpos-nkn,
          lv_kta TYPE /nfm/torderpos-kta,
          lv_ndt TYPE /nfm/torderpos-ndt.

    IF it_nfm_ch IS INITIAL.
      RETURN.
    ENDIF.

    SELECT belnr, posnr, nes, nkn, kta, ndt
      FROM /nfm/torderpos
      FOR ALL ENTRIES IN @it_nfm_ch
      WHERE belnr = @it_nfm_ch-doc_number
        AND posnr = @it_nfm_ch-itm_number
        AND nes   = @it_nfm_ch-nfmkey
      INTO TABLE @lt_chk
      BYPASSING BUFFER.

    LOOP AT it_nfm_ch ASSIGNING FIELD-SYMBOL(<fs_nfm>).
      READ TABLE lt_chk ASSIGNING FIELD-SYMBOL(<fs_chk>)
          WITH TABLE KEY belnr = <fs_nfm>-doc_number
                         posnr = <fs_nfm>-itm_number
                         nes   = <fs_nfm>-nfmkey.

      IF sy-subrc IS NOT INITIAL.
        APPEND VALUE #( type       = 'E'
                        id         = 'ZCL_MSG_MM_003'
                        number     = '031'
                        message_v1 = <fs_nfm>-doc_number
                        message_v2 = <fs_nfm>-itm_number ) TO ct_return.
        CONTINUE.
      ENDIF.

      lv_nkn = <fs_nfm>-rate.
      lv_kta = <fs_nfm>-actratedat.
      lv_ndt = <fs_nfm>-ratedetdat.

      IF <fs_chk>-nkn <> lv_nkn OR <fs_chk>-kta <> lv_kta OR <fs_chk>-ndt <> lv_ndt.
        APPEND VALUE #( type       = 'E'
                        id         = 'ZCL_MSG_MM_003'
                        number     = '038'
                        message_v1 = <fs_nfm>-doc_number
                        message_v2 = <fs_nfm>-itm_number
                        message_v3 = |{ lv_nkn }|
                        message_v4 = |{ <fs_chk>-nkn }| ) TO ct_return.
      ENDIF.
    ENDLOOP.
  ENDMETHOD.

  METHOD ensure_nfm_currency.
    TYPES: BEGIN OF ty_tdef,
             nes TYPE /nfm/nes,
             nfs TYPE /nfm/nfs,
             bcu TYPE /nfm/bcu,
           END OF ty_tdef,
           BEGIN OF ty_pos,
             posnr TYPE /nfm/torderpos-posnr,
           END OF ty_pos.

    DATA: lt_db   TYPE tt_torder,
          lt_pos  TYPE STANDARD TABLE OF ty_pos,
          ls_old  TYPE /nfm/orderpos_vb,
          ls_new  TYPE /nfm/orderpos_vb,
          lt_x    TYPE STANDARD TABLE OF /nfm/orderpos_vb,
          lt_y    TYPE STANDARD TABLE OF /nfm/orderpos_vb,
          lt_tdef TYPE SORTED TABLE OF ty_tdef WITH UNIQUE KEY nes,
          ls_tdef TYPE ty_tdef,
          lv_vky  TYPE /nfm/vky,
          ls_save TYPE bapiret2.

    IF it_poitem IS INITIAL.
      RETURN.
    ENDIF.

    lv_vky = iv_purchaseorder.

    LOOP AT it_poitem ASSIGNING FIELD-SYMBOL(<fs_pos>).
      APPEND VALUE #( posnr = <fs_pos>-po_item ) TO lt_pos.
    ENDLOOP.

    SELECT *
      FROM /nfm/torderpos
      FOR ALL ENTRIES IN @lt_pos
      WHERE belnr = @iv_purchaseorder
        AND posnr = @lt_pos-posnr
      INTO TABLE @lt_db.

    IF lt_db IS INITIAL.
      RETURN.
    ENDIF.

    SELECT nes, nfs, bcu
      FROM /nfm/tdefault
      FOR ALL ENTRIES IN @lt_db
      WHERE vtp = 'E'
        AND vky = @lv_vky
        AND nes = @lt_db-nes
      INTO TABLE @lt_tdef.

    LOOP AT lt_db ASSIGNING FIELD-SYMBOL(<fs_db>).
      IF <fs_db>-nkw IS NOT INITIAL
         AND <fs_db>-bcu IS NOT INITIAL
         AND <fs_db>-nfs IS NOT INITIAL.
        CONTINUE.
      ENDIF.

      CLEAR: ls_old, ls_new, ls_tdef.
      MOVE-CORRESPONDING <fs_db> TO ls_old.
      fill_nfm_currency( CHANGING cs_orderpos = ls_old ).
      ls_old-updkz = 'U'.
      ls_new       = ls_old.

      READ TABLE lt_tdef INTO ls_tdef WITH TABLE KEY nes = <fs_db>-nes.
      IF sy-subrc IS INITIAL.
        IF ls_new-nfs IS INITIAL.
          ls_new-nfs = ls_tdef-nfs.
        ENDIF.
        IF ls_new-nkw IS INITIAL AND ls_tdef-bcu IS NOT INITIAL.
          ls_new-nkw = ls_tdef-bcu.
          ls_new-bcu = ls_tdef-bcu.
          ls_new-bkw = ls_tdef-bcu.
        ENDIF.
      ENDIF.

      fill_nfm_currency( CHANGING cs_orderpos = ls_new ).

      IF ls_new-nkw IS INITIAL.
        APPEND append_nfm_currency_error( iv_belnr = <fs_db>-belnr
                                          iv_posnr = <fs_db>-posnr ) TO ct_return.
        RETURN.
      ENDIF.

      fill_nfm_currency( CHANGING cs_orderpos = ls_old ).
      ls_new-updkz = 'U'.
      APPEND ls_old TO lt_y.
      APPEND ls_new TO lt_x.
    ENDLOOP.

    IF lt_x IS INITIAL.
      RETURN.
    ENDIF.

    ls_save = save_nfm_orderpos( it_x = lt_x it_y = lt_y iv_bstyp = iv_bstyp ).
    IF ls_save-type = 'E'.
      APPEND ls_save TO ct_return.
      RETURN.
    ENDIF.

    CALL FUNCTION 'BAPI_TRANSACTION_COMMIT'
      EXPORTING
        wait = abap_true.
  ENDMETHOD.

  METHOD persist_nfm_orderpos.
    TYPES: BEGIN OF ty_tdef,
             nes TYPE /nfm/nes,
             nfs TYPE /nfm/nfs,
             bcu TYPE /nfm/bcu,
           END OF ty_tdef.

    DATA: lt_db    TYPE tt_torder,
          ls_old   TYPE /nfm/orderpos_vb,
          ls_new   TYPE /nfm/orderpos_vb,
          lt_x     TYPE STANDARD TABLE OF /nfm/orderpos_vb,
          lt_y     TYPE STANDARD TABLE OF /nfm/orderpos_vb,
          lt_tdef  TYPE SORTED TABLE OF ty_tdef WITH UNIQUE KEY nes,
          ls_tdef  TYPE ty_tdef,
          lv_waers TYPE /nfm/nkw,
          lv_vky   TYPE /nfm/vky,
          ls_save  TYPE bapiret2.

    IF it_nfm_ch IS INITIAL.
      RETURN.
    ENDIF.

    LOOP AT it_nfm_ch ASSIGNING FIELD-SYMBOL(<fs_chk>).
      IF <fs_chk>-rate IS INITIAL AND <fs_chk>-ratedoccur IS INITIAL.
        APPEND VALUE #( type       = 'E'
                        id         = 'ZCL_MSG_MM_003'
                        number     = '034'
                        message_v1 = <fs_chk>-doc_number
                        message_v2 = <fs_chk>-itm_number ) TO ct_return.
        RETURN.
      ENDIF.
    ENDLOOP.

    lv_vky = it_nfm_ch[ 1 ]-doc_number.

    SELECT *
      FROM /nfm/torderpos
      FOR ALL ENTRIES IN @it_nfm_ch
      WHERE belnr = @it_nfm_ch-doc_number
        AND posnr = @it_nfm_ch-itm_number
        AND nes   = @it_nfm_ch-nfmkey
      INTO TABLE @lt_db.

    SELECT nes, nfs, bcu
      FROM /nfm/tdefault
      FOR ALL ENTRIES IN @it_nfm_ch
      WHERE vtp = 'E'
        AND vky = @lv_vky
        AND nes = @it_nfm_ch-nfmkey
      INTO TABLE @lt_tdef.

    LOOP AT it_nfm_ch ASSIGNING FIELD-SYMBOL(<fs_nfm>).
      READ TABLE lt_db ASSIGNING FIELD-SYMBOL(<fs_db>)
          WITH TABLE KEY belnr = <fs_nfm>-doc_number
                         posnr = <fs_nfm>-itm_number
                         nes   = <fs_nfm>-nfmkey.

      IF sy-subrc IS NOT INITIAL.
        APPEND VALUE #( type       = 'E'
                        id         = 'ZCL_MSG_MM_003'
                        number     = '031'
                        message_v1 = <fs_nfm>-doc_number
                        message_v2 = <fs_nfm>-itm_number ) TO ct_return.
        RETURN.
      ENDIF.

      CLEAR: ls_old, ls_new, lv_waers, ls_tdef.
      MOVE-CORRESPONDING <fs_db> TO ls_old.
      fill_nfm_currency( CHANGING cs_orderpos = ls_old ).
      ls_old-updkz = 'U'.
      ls_new       = ls_old.

      lv_waers = <fs_nfm>-ratecurky.
      IF lv_waers IS INITIAL.
        lv_waers = <fs_nfm>-bvalcurkyd.
      ENDIF.
      IF lv_waers IS INITIAL.
        READ TABLE lt_tdef INTO ls_tdef WITH TABLE KEY nes = <fs_nfm>-nfmkey.
        IF sy-subrc IS INITIAL.
          lv_waers = ls_tdef-bcu.
        ENDIF.
      ENDIF.
      IF lv_waers IS INITIAL.
        lv_waers = ls_old-nkw.
      ENDIF.
      IF lv_waers IS INITIAL.
        lv_waers = ls_old-bcu.
      ENDIF.
      IF lv_waers IS INITIAL.
        APPEND append_nfm_currency_error( iv_belnr = <fs_nfm>-doc_number
                                          iv_posnr = <fs_nfm>-itm_number ) TO ct_return.
        RETURN.
      ENDIF.

      ls_new-ndt = <fs_nfm>-ratedetdat.
      ls_new-kta = <fs_nfm>-actratedat.
      ls_new-nku = <fs_nfm>-ratedoccur.
      ls_new-nkn = <fs_nfm>-rate.
      ls_new-nno = <fs_nfm>-rate.
      ls_new-nkw = lv_waers.
      ls_new-bcu = lv_waers.
      ls_new-bkw = lv_waers.

      IF <fs_nfm>-ratedetkey IS NOT INITIAL.
        ls_new-nfs = <fs_nfm>-ratedetkey.
      ENDIF.
      IF ls_new-nfs IS INITIAL.
        ls_new-nfs = ls_old-nfs.
      ENDIF.
      IF ls_new-nfs IS INITIAL.
        IF ls_tdef IS INITIAL.
          READ TABLE lt_tdef INTO ls_tdef WITH TABLE KEY nes = <fs_nfm>-nfmkey.
        ENDIF.
        IF ls_tdef-nfs IS NOT INITIAL.
          ls_new-nfs = ls_tdef-nfs.
        ENDIF.
      ENDIF.

      IF <fs_nfm>-exchangekey IS NOT INITIAL.
        ls_new-bsl = <fs_nfm>-exchangekey.
      ENDIF.
      IF ls_new-bsl IS INITIAL.
        ls_new-bsl = ls_old-bsl.
      ENDIF.

      IF <fs_nfm>-basekey IS NOT INITIAL.
        ls_new-neb = <fs_nfm>-basekey.
      ENDIF.

      fill_nfm_currency( CHANGING cs_orderpos = ls_old ).
      fill_nfm_currency( CHANGING cs_orderpos = ls_new ).

      IF ls_old-nkw IS INITIAL OR ls_new-nkw IS INITIAL.
        APPEND append_nfm_currency_error( iv_belnr = <fs_nfm>-doc_number
                                          iv_posnr = <fs_nfm>-itm_number ) TO ct_return.
        RETURN.
      ENDIF.

      ls_new-updkz = 'U'.
      APPEND ls_old TO lt_y.
      APPEND ls_new TO lt_x.
    ENDLOOP.

    ls_save = save_nfm_orderpos( it_x = lt_x it_y = lt_y iv_bstyp = iv_bstyp ).
    IF ls_save-type = 'E'.
      APPEND ls_save TO ct_return.
    ENDIF.
  ENDMETHOD.

  METHOD call_bapi_change_pos.
    DATA: lt_poitem    TYPE STANDARD TABLE OF bapimepoitem,
          lt_poitemx   TYPE STANDARD TABLE OF bapimepoitemx,
          lt_pocond    TYPE STANDARD TABLE OF bapimepocond,
          lt_pocondx   TYPE STANDARD TABLE OF bapimepocondx,
          lt_cond      TYPE STANDARD TABLE OF bapimepocond,
          lt_cond_k    TYPE tt_cond,
          lt_itemx     TYPE tt_poitemx,
          ls_cond      TYPE bapimepocond,
          lv_need_pr   TYPE abap_bool,
          lv_has_fecha TYPE abap_bool,
          lv_got_sched TYPE abap_bool,
          lv_bstyp     TYPE bstyp,
          lv_gd1_err   TYPE abap_bool,
          lt_pos_fae   TYPE STANDARD TABLE OF /nfm/torderpos,
          lt_sched     TYPE STANDARD TABLE OF bapimeposchedule,
          lt_sched_k   TYPE tt_sched,
          lt_sched_ch  TYPE STANDARD TABLE OF bapimeposchedule,
          lt_schedx    TYPE STANDARD TABLE OF bapimeposchedulx,
          lv_found     TYPE abap_bool,
          lv_date_ext  TYPE bapimeposchedule-delivery_date,
          lt_nfm       TYPE tt_nfm_std,
          lt_nfm_k     TYPE tt_nfm,
          lt_nfm_ch    TYPE tt_nfm_std,
          lt_nfm_ret   TYPE tt_return,
          lt_db_nfm    TYPE tt_torder,
          ls_header    TYPE bapimepoheader,
          ls_headerx   TYPE bapimepoheaderx,
          lv_po_item   TYPE bapimeposchedule-po_item,
          lv_item_bapi TYPE bapimepoitem-po_item.

    lt_itemx = is_param-t_poitemx.
    lv_got_sched = abap_true.

    SELECT SINGLE PurchasingDocumentCategory
      FROM zi_mm_wrapper_ekpo
      WHERE PurchaseOrder = @is_param-iv_purchaseorder
      INTO @lv_bstyp.

    IF lv_bstyp IS INITIAL.
      lv_bstyp = 'F'.
    ENDIF.

    LOOP AT is_param-t_poitem ASSIGNING FIELD-SYMBOL(<fs_item>).
      READ TABLE lt_itemx ASSIGNING FIELD-SYMBOL(<fs_itemx>)
          WITH TABLE KEY po_item = <fs_item>-po_item.

      IF sy-subrc IS NOT INITIAL.
        CONTINUE.
      ENDIF.

      lv_item_bapi = |{ <fs_item>-po_item ALPHA = IN }|.

      IF <fs_itemx>-no_more_gr = abap_true.
        APPEND CORRESPONDING #( <fs_item> ) TO lt_poitem.
        APPEND CORRESPONDING #( <fs_itemx> ) TO lt_poitemx.
      ELSE.
        APPEND VALUE #( po_item = lv_item_bapi ) TO lt_poitem.
        APPEND VALUE #( po_item  = lv_item_bapi
                        po_itemx = abap_true ) TO lt_poitemx.
      ENDIF.

      IF <fs_itemx>-net_price = abap_true.
        lv_need_pr = abap_true.
      ENDIF.

      IF <fs_item>-invoice_date IS NOT INITIAL.
        lv_has_fecha = abap_true.
      ENDIF.
    ENDLOOP.

    IF lv_has_fecha = abap_true.
      ensure_nfm_currency( EXPORTING iv_purchaseorder = is_param-iv_purchaseorder
                                     it_poitem        = is_param-t_poitem
                                     iv_bstyp         = lv_bstyp
                           CHANGING  ct_return        = rt_return ).
      READ TABLE rt_return TRANSPORTING NO FIELDS WITH KEY type = 'E'.
      IF sy-subrc IS INITIAL.
        RETURN.
      ENDIF.
    ENDIF.

    IF lv_need_pr = abap_true OR lv_has_fecha = abap_true.
      TRY.
          CALL FUNCTION 'BAPI_PO_GETDETAIL1'
            EXPORTING
              purchaseorder = is_param-iv_purchaseorder
            TABLES
              return        = rt_return
              pocond        = lt_cond
              poschedule    = lt_sched.
        CATCH cx_root INTO DATA(lx_gd1).
          IF lv_need_pr = abap_true.
            APPEND append_exc( lx_gd1 ) TO rt_return.
            RETURN.
          ENDIF.
          CLEAR: rt_return, lt_sched.
          lv_got_sched = abap_false.
      ENDTRY.

      IF lv_got_sched = abap_true.
        CLEAR lv_gd1_err.
        LOOP AT rt_return TRANSPORTING NO FIELDS WHERE type = 'E' OR type = 'A'.
          lv_gd1_err = abap_true.
          EXIT.
        ENDLOOP.

        IF lv_gd1_err = abap_true.
          IF lv_need_pr = abap_true.
            RETURN.
          ENDIF.
          "Contrato L: GETDETAIL1 puede fallar; NFM sigue por TORDERPOS
          CLEAR: rt_return, lt_sched.
          lv_got_sched = abap_false.
        ELSE.
          CLEAR rt_return.
        ENDIF.
      ENDIF.
    ENDIF.

    IF lv_has_fecha = abap_true.
      TRY.
          CALL FUNCTION 'BAPI_PO_GETDETAIL'
            EXPORTING
              purchaseorder = is_param-iv_purchaseorder
            TABLES
              return        = lt_nfm_ret
              nfmetallitms  = lt_nfm.
        CATCH cx_root INTO DATA(lx_nfm).
          IF lv_bstyp <> 'L'.
            APPEND VALUE #( type       = 'E'
                            id         = 'ZCL_MSG_MM_003'
                            number     = '035'
                            message    = lx_nfm->get_text( )
                            message_v1 = is_param-iv_purchaseorder ) TO rt_return.
          ENDIF.
      ENDTRY.

      IF lv_bstyp <> 'L'.
        LOOP AT lt_nfm_ret ASSIGNING FIELD-SYMBOL(<fs_nfm_ret>) WHERE type = 'E' OR type = 'A'.
          APPEND <fs_nfm_ret> TO rt_return.
        ENDLOOP.

        READ TABLE rt_return TRANSPORTING NO FIELDS WITH KEY type = 'E'.
        IF sy-subrc IS INITIAL.
          RETURN.
        ENDIF.
      ELSE.
        CLEAR rt_return.
      ENDIF.

      IF lt_nfm IS INITIAL.
        CLEAR lt_pos_fae.
        LOOP AT is_param-t_poitem ASSIGNING <fs_item>.
          IF <fs_item>-invoice_date IS INITIAL.
            CONTINUE.
          ENDIF.
          APPEND VALUE #( posnr = <fs_item>-po_item ) TO lt_pos_fae.
        ENDLOOP.

        IF lt_pos_fae IS NOT INITIAL.
          SELECT *
            FROM /nfm/torderpos
            FOR ALL ENTRIES IN @lt_pos_fae
            WHERE belnr = @is_param-iv_purchaseorder
              AND posnr = @lt_pos_fae-posnr
            INTO TABLE @lt_db_nfm.
        ENDIF.

        LOOP AT lt_db_nfm ASSIGNING FIELD-SYMBOL(<fs_dbn>).
          APPEND VALUE #( doc_number  = <fs_dbn>-belnr
                          itm_number  = <fs_dbn>-posnr
                          nfmkey      = <fs_dbn>-nes
                          actratedat  = <fs_dbn>-kta
                          ratedetdat  = <fs_dbn>-ndt
                          rate        = <fs_dbn>-nkn
                          ratedoccur  = <fs_dbn>-nku
                          ratedetkey  = <fs_dbn>-nfs
                          exchangekey = <fs_dbn>-bsl
                          ratecurky   = <fs_dbn>-nkw
                          bvalcurkyd  = <fs_dbn>-bcu
                          updtype     = 'U' ) TO lt_nfm.
        ENDLOOP.
      ENDIF.
    ENDIF.

    IF lv_need_pr = abap_true.
      lt_cond_k = lt_cond.

      LOOP AT is_param-t_poitem ASSIGNING <fs_item>.
        READ TABLE lt_itemx ASSIGNING <fs_itemx>
            WITH TABLE KEY po_item = <fs_item>-po_item.

        IF sy-subrc IS NOT INITIAL.
          CONTINUE.
        ENDIF.

        IF <fs_itemx>-net_price <> abap_true.
          CONTINUE.
        ENDIF.

        ls_cond = get_gross_condition( it_cond    = lt_cond_k
                                       iv_po_item = <fs_item>-po_item ).

        IF ls_cond IS INITIAL.
          APPEND VALUE #( type       = 'E'
                          id         = 'ZCL_MSG_MM_003'
                          number     = '026'
                          message_v1 = is_param-iv_purchaseorder
                          message_v2 = <fs_item>-po_item ) TO rt_return.
          RETURN.
        ENDIF.

        ls_cond-cond_value = <fs_item>-net_price.
        IF <fs_item>-price_unit > 0.
          ls_cond-cond_p_unt = <fs_item>-price_unit.
        ENDIF.
        ls_cond-change_id  = 'U'.
        APPEND ls_cond TO lt_pocond.

        APPEND VALUE #( condition_no = ls_cond-condition_no
                        itm_number   = ls_cond-itm_number
                        cond_st_no   = ls_cond-cond_st_no
                        cond_count   = ls_cond-cond_count
                        cond_value   = abap_true
                        cond_p_unt   = COND bapiupdate( WHEN <fs_item>-price_unit > 0 THEN abap_true ELSE abap_false )
                        change_id    = abap_true ) TO lt_pocondx.
      ENDLOOP.
    ENDIF.

    IF lv_has_fecha = abap_true.
      lt_sched_k = lt_sched.
      lt_nfm_k   = lt_nfm.

      LOOP AT is_param-t_poitem ASSIGNING <fs_item>.
        IF <fs_item>-invoice_date IS INITIAL.
          CONTINUE.
        ENDIF.

        CLEAR lv_found.
        lv_po_item  = |{ <fs_item>-po_item ALPHA = IN }|.
        lv_date_ext = |{ <fs_item>-invoice_date+6(2) }.{ <fs_item>-invoice_date+4(2) }.{ <fs_item>-invoice_date(4) }|.

        LOOP AT lt_sched_k ASSIGNING FIELD-SYMBOL(<fs_sched>) USING KEY primary_key
             WHERE po_item = lv_po_item.
          <fs_sched>-delivery_date = lv_date_ext.
          APPEND <fs_sched> TO lt_sched_ch.
          APPEND VALUE #( po_item       = <fs_sched>-po_item
                          sched_line    = <fs_sched>-sched_line
                          po_itemx      = abap_true
                          sched_linex   = abap_true
                          delivery_date = abap_true ) TO lt_schedx.
          lv_found = abap_true.
        ENDLOOP.

        IF lv_found = abap_false AND lv_got_sched = abap_true.
          APPEND VALUE #( type       = 'E'
                          id         = 'ZCL_MSG_MM_003'
                          number     = '029'
                          message_v1 = is_param-iv_purchaseorder
                          message_v2 = <fs_item>-po_item ) TO rt_return.
          RETURN.
        ENDIF.

        IF lv_bstyp = 'L' AND lt_nfm_k IS NOT INITIAL.
          apply_nfm_rates( EXPORTING iv_purchaseorder = is_param-iv_purchaseorder
                                     iv_po_item       = <fs_item>-po_item
                                     iv_invoice_date  = <fs_item>-invoice_date
                           CHANGING  ct_nfm           = lt_nfm_k
                                     ct_nfm_ch        = lt_nfm_ch
                                     ct_return        = rt_return ).

          READ TABLE rt_return TRANSPORTING NO FIELDS WITH KEY type = 'E'.
          IF sy-subrc IS INITIAL.
            RETURN.
          ENDIF.
        ENDIF.
      ENDLOOP.

      "Pedido: cotizacion OICQP con corte EKKO-BEDAT (igual ZMM_SA_NFM)
      IF lv_bstyp <> 'L' AND lt_nfm_k IS NOT INITIAL.
        select_nfm_oicqp( EXPORTING iv_purchaseorder = is_param-iv_purchaseorder
                                    it_poitem        = is_param-t_poitem
                                    it_nfm           = lt_nfm_k
                          CHANGING  ct_nfm_ch        = lt_nfm_ch
                                    ct_return        = rt_return ).

        READ TABLE rt_return TRANSPORTING NO FIELDS WITH KEY type = 'E'.
        IF sy-subrc IS INITIAL.
          RETURN.
        ENDIF.
      ENDIF.

      IF lt_nfm IS NOT INITIAL AND lt_nfm_ch IS INITIAL.
        APPEND VALUE #( type       = 'E'
                        id         = 'ZCL_MSG_MM_003'
                        number     = '031'
                        message_v1 = is_param-iv_purchaseorder
                        message_v2 = lv_po_item ) TO rt_return.
        RETURN.
      ENDIF.
    ENDIF.

    "Contrato L: solo TORDERPOS (Test 6). Pedido F: EKET y NFMETALLITMS en BAPI_PO_CHANGE.
    "No calctype C ni ZNF6 por BAPI; el estandar recalcula ZNF6.
    IF lv_bstyp = 'L' AND lt_nfm_ch IS NOT INITIAL.
      persist_nfm_orderpos( EXPORTING it_nfm_ch = lt_nfm_ch
                                      iv_bstyp  = lv_bstyp
                            CHANGING  ct_return = rt_return ).

      READ TABLE rt_return TRANSPORTING NO FIELDS WITH KEY type = 'E'.
      IF sy-subrc IS INITIAL.
        RETURN.
      ENDIF.

      CALL FUNCTION 'BAPI_TRANSACTION_COMMIT'
        EXPORTING
          wait = abap_true.

      verify_nfm_orderpos( EXPORTING it_nfm_ch = lt_nfm_ch
                           CHANGING  ct_return = rt_return ).

      READ TABLE rt_return TRANSPORTING NO FIELDS WITH KEY type = 'E'.
      IF sy-subrc IS INITIAL.
        RETURN.
      ENDIF.

      APPEND VALUE #( type       = 'S'
                      id         = 'ZCL_MSG_MM_003'
                      number     = '017'
                      message_v1 = is_param-iv_purchaseorder ) TO rt_return.
      RETURN.
    ENDIF.

    ls_header  = is_param-is_poheader.
    ls_headerx = is_param-is_poheaderx.
    IF ls_header-po_number IS INITIAL.
      ls_header-po_number  = is_param-iv_purchaseorder.
      ls_headerx-po_number = abap_true.
    ENDIF.

    TRY.
        CALL FUNCTION 'BAPI_PO_CHANGE'
          EXPORTING
            purchaseorder = is_param-iv_purchaseorder
            poheader      = ls_header
            poheaderx     = ls_headerx
          TABLES
            return        = rt_return
            poitem        = lt_poitem
            poitemx       = lt_poitemx
            pocond        = lt_pocond
            pocondx       = lt_pocondx
            poschedule    = lt_sched_ch
            poschedulex   = lt_schedx
            nfmetallitms  = lt_nfm_ch.
      CATCH cx_root INTO DATA(lx_ch).
        APPEND append_exc( lx_ch ) TO rt_return.
        RETURN.
    ENDTRY.

    LOOP AT rt_return TRANSPORTING NO FIELDS WHERE type = 'E' OR type = 'A'.
      RETURN.
    ENDLOOP.

    CALL FUNCTION 'BAPI_TRANSACTION_COMMIT'
      EXPORTING
        wait = abap_true.

    IF lv_bstyp = 'F' AND lt_nfm_ch IS NOT INITIAL.
      verify_nfm_orderpos( EXPORTING it_nfm_ch = lt_nfm_ch
                           CHANGING  ct_return = rt_return ).
    ENDIF.
  ENDMETHOD.

  METHOD apply_nfm_rates.
    TYPES: BEGIN OF ty_nes,
             nes TYPE /nfm/nes,
           END OF ty_nes,
           BEGIN OF ty_tdef,
             nes TYPE /nfm/nes,
             nfs TYPE /nfm/nfs,
             bcu TYPE /nfm/bcu,
           END OF ty_tdef,
           BEGIN OF ty_rate,
             nes TYPE /nfm/torderpos-nes,
             nku TYPE /nfm/torderpos-nku,
             bmg TYPE /nfm/torderpos-bmg,
             vgw TYPE /nfm/torderpos-vgw,
             vge TYPE /nfm/torderpos-vge,
           END OF ty_rate.

    DATA: lv_item     TYPE /nfm/bapidocitm-itm_number,
          lv_posnr    TYPE /nfm/torderpos-posnr,
          lv_ekorg    TYPE ekorg,
          lv_lifnr    TYPE lifnr,
          lv_boesl    TYPE /nfm/boesl,
          lv_boesl_ln TYPE /nfm/boesl,
          lv_nfs      TYPE /nfm/nfs,
          lv_bcu      TYPE /nfm/bcu,
          lv_vky      TYPE /nfm/vky,
          lv_nfmkey   TYPE /nfm/nes,
          lv_price    TYPE oic_price,
          lv_calc     TYPE decfloat34,
          lv_msg      TYPE bapi_msg,
          lv_matnr    TYPE mara-matnr,
          lv_bprme    TYPE mara-meins,
          lv_lmein    TYPE mara-meins,
          lv_menge    TYPE ekpo-menge,
          lv_menge_cv TYPE ekpo-menge,
          lt_nes      TYPE SORTED TABLE OF ty_nes WITH UNIQUE KEY nes,
          ls_nes      TYPE ty_nes,
          lt_tdef     TYPE SORTED TABLE OF ty_tdef WITH UNIQUE KEY nes,
          ls_tdef     TYPE ty_tdef,
          lt_rate     TYPE SORTED TABLE OF ty_rate WITH NON-UNIQUE KEY nes,
          ls_rate     TYPE ty_rate.

    lv_item  = |{ iv_po_item ALPHA = IN }|.
    lv_posnr = iv_po_item.
    lv_vky   = iv_purchaseorder.

    SELECT SINGLE Supplier, PurchasingOrganization
      FROM zi_mm_wrapper_ekko
      WHERE PurchaseOrder = @iv_purchaseorder
      INTO (@lv_lifnr, @lv_ekorg).

    SELECT SINGLE NfKey
      FROM zi_mm_wrapper_lfm1
      WHERE Supplier               = @lv_lifnr
        AND PurchasingOrganization = @lv_ekorg
      INTO @lv_boesl.

    SELECT SINGLE menge, bprme, lmein, matnr
      FROM ekpo
      WHERE ebeln = @iv_purchaseorder
        AND ebelp = @iv_po_item
      INTO (@lv_menge, @lv_bprme, @lv_lmein, @lv_matnr).

    lv_menge_cv = lv_menge.
    IF lv_bprme <> lv_lmein.
      CLEAR lv_menge_cv.
      CALL FUNCTION 'MD_CONVERT_MATERIAL_UNIT'
        EXPORTING
          i_matnr  = lv_matnr
          i_in_me  = lv_bprme
          i_out_me = lv_lmein
          i_menge  = lv_menge
        IMPORTING
          e_menge  = lv_menge_cv
        EXCEPTIONS
          OTHERS   = 1.
      IF sy-subrc <> 0.
        CLEAR lv_menge_cv.
      ENDIF.
    ENDIF.

    SELECT nes, nku, bmg, vgw, vge
      FROM /nfm/torderpos
      WHERE belnr = @iv_purchaseorder
        AND posnr = @lv_posnr
      INTO TABLE @lt_rate.

    LOOP AT ct_nfm ASSIGNING FIELD-SYMBOL(<fs_nfm>) USING KEY primary_key
         WHERE itm_number = lv_item.
      ls_nes-nes = condense( val = CONV string( <fs_nfm>-nfmkey ) ).
      IF ls_nes-nes IS NOT INITIAL.
        INSERT ls_nes INTO TABLE lt_nes.
      ENDIF.
    ENDLOOP.

    IF lt_nes IS NOT INITIAL.
      SELECT nes, nfs, bcu
        FROM /nfm/tdefault
        FOR ALL ENTRIES IN @lt_nes
        WHERE vtp = 'E'
          AND vky = @lv_vky
          AND nes = @lt_nes-nes
        INTO TABLE @lt_tdef.
    ENDIF.

    LOOP AT ct_nfm ASSIGNING <fs_nfm> USING KEY primary_key
         WHERE itm_number = lv_item.
      CLEAR: lv_nfs, lv_bcu, lv_price, lv_calc, lv_msg, lv_boesl_ln, lv_nfmkey, ls_tdef, ls_rate.

      lv_nfmkey   = condense( val = CONV string( <fs_nfm>-nfmkey ) ).
      lv_boesl_ln = lv_boesl.
      IF <fs_nfm>-exchangekey IS NOT INITIAL.
        lv_boesl_ln = <fs_nfm>-exchangekey.
      ENDIF.

      READ TABLE lt_tdef INTO ls_tdef WITH TABLE KEY nes = lv_nfmkey.
      IF <fs_nfm>-ratedetkey IS NOT INITIAL.
        lv_nfs = <fs_nfm>-ratedetkey.
      ELSE.
        lv_nfs = ls_tdef-nfs.
      ENDIF.

      lv_bcu = CONV /nfm/bcu( <fs_nfm>-ratecurky ).
      IF lv_bcu IS INITIAL.
        lv_bcu = <fs_nfm>-bvalcurkyd.
      ENDIF.
      IF lv_bcu IS INITIAL.
        lv_bcu = ls_tdef-bcu.
      ENDIF.
      IF lv_bcu IS INITIAL.
        APPEND append_nfm_currency_error( iv_belnr = iv_purchaseorder
                                          iv_posnr = lv_item ) TO ct_return.
        RETURN.
      ENDIF.

      IF <fs_nfm>-ratedetkey IS INITIAL AND lv_nfs IS NOT INITIAL.
        <fs_nfm>-ratedetkey = lv_nfs.
      ENDIF.
      IF <fs_nfm>-exchangekey IS INITIAL AND lv_boesl_ln IS NOT INITIAL.
        <fs_nfm>-exchangekey = lv_boesl_ln.
      ENDIF.
      IF <fs_nfm>-ratecurky IS INITIAL.
        <fs_nfm>-ratecurky = lv_bcu.
      ENDIF.
      IF <fs_nfm>-bvalcurkyd IS INITIAL.
        <fs_nfm>-bvalcurkyd = lv_bcu.
      ENDIF.

      IF lv_nfs = '02' AND <fs_nfm>-rate IS NOT INITIAL.
        <fs_nfm>-ratedetdat = iv_invoice_date.
        <fs_nfm>-netrate    = <fs_nfm>-rate.
        <fs_nfm>-ratedoccur = <fs_nfm>-rate.
        <fs_nfm>-updtype    = 'U'.
        APPEND <fs_nfm> TO ct_nfm_ch.
        CONTINUE.
      ENDIF.

      READ TABLE lt_rate INTO ls_rate WITH TABLE KEY nes = lv_nfmkey.
      IF sy-subrc IS INITIAL AND ls_rate-bmg <> 0 AND ls_rate-vge <> 0.
        lv_calc  = CONV decfloat34( lv_menge_cv ) * ls_rate-nku / ls_rate-bmg * ls_rate-vgw / ls_rate-vge.
        lv_price = round( val = lv_calc dec = 5 ).
      ENDIF.

      IF lv_price IS INITIAL.
        lv_msg = |Precio NFM 0 { iv_purchaseorder }/{ lv_item } NES { lv_nfmkey }|.
        APPEND VALUE #( type       = 'E'
                        id         = 'ZCL_MSG_MM_003'
                        number     = '034'
                        message    = lv_msg
                        message_v1 = iv_purchaseorder
                        message_v2 = lv_item
                        message_v3 = iv_invoice_date
                        message_v4 = lv_nfmkey ) TO ct_return.
        RETURN.
      ENDIF.

      <fs_nfm>-ratedetdat = iv_invoice_date.
      <fs_nfm>-actratedat = iv_invoice_date.
      <fs_nfm>-rate       = lv_price.
      <fs_nfm>-ratedoccur = lv_price.
      <fs_nfm>-netrate    = lv_price.
      <fs_nfm>-updtype    = 'U'.
      APPEND <fs_nfm> TO ct_nfm_ch.
    ENDLOOP.
  ENDMETHOD.

  METHOD select_nfm_oicqp.
    TYPES: BEGIN OF ty_pos,
             itm_number   TYPE /nfm/bapidocitm-itm_number,
             ebelp        TYPE ekpo-ebelp,
             invoice_date TYPE dats,
             matnr        TYPE ekpo-matnr,
             werks        TYPE ekpo-werks,
             vky_ea       TYPE /nfm/tdefault-vky,
             vky_ec       TYPE /nfm/tdefault-vky,
           END OF ty_pos,
           BEGIN OF ty_fae,
             ebelp TYPE ekpo-ebelp,
           END OF ty_fae,
           BEGIN OF ty_ekpo,
             ebelp TYPE ekpo-ebelp,
             matnr TYPE ekpo-matnr,
             werks TYPE ekpo-werks,
           END OF ty_ekpo,
           BEGIN OF ty_vky,
             vtp TYPE /nfm/tdefault-vtp,
             vky TYPE /nfm/tdefault-vky,
           END OF ty_vky,
           BEGIN OF ty_tdef,
             vtp TYPE /nfm/tdefault-vtp,
             vky TYPE /nfm/tdefault-vky,
             nes TYPE /nfm/tdefault-nes,
             nfs TYPE /nfm/tdefault-nfs,
             bcu TYPE /nfm/tdefault-bcu,
           END OF ty_tdef,
           BEGIN OF ty_vgw_lif,
             matnr TYPE /nfm/tvgw-matnr,
             nes   TYPE /nfm/tvgw-nes,
           END OF ty_vgw_lif,
           BEGIN OF ty_vgw_wrk,
             matnr TYPE /nfm/tvgw-matnr,
             werks TYPE /nfm/tvgw-werks,
             nes   TYPE /nfm/tvgw-nes,
           END OF ty_vgw_wrk,
           BEGIN OF ty_qkey,
             quotyp TYPE oicqp-quotyp,
             quotno TYPE oicqp-quotno,
           END OF ty_qkey,
           BEGIN OF ty_qp,
             quotyp   TYPE oicqp-quotyp,
             quotno   TYPE oicqp-quotno,
             quotdate TYPE oicqp-quotdate,
             price    TYPE oicqp-price,
             defcurr  TYPE oicqp-defcurr,
           END OF ty_qp,
           BEGIN OF ty_work,
             nfm          TYPE /nfm/bapidocitm,
             nes          TYPE /nfm/nes,
             nfs          TYPE /nfm/tdefault-nfs,
             quotyp       TYPE oicqp-quotyp,
             quotno       TYPE oicqp-quotno,
             invoice_date TYPE dats,
           END OF ty_work.

    DATA: lv_bedat   TYPE ekko-bedat,
          lv_lifnr   TYPE ekko-lifnr,
          lv_ekorg   TYPE ekko-ekorg,
          lv_lme     TYPE lfm1-j_1nboesl,
          lv_nes     TYPE /nfm/nes,
          lv_msg     TYPE bapi_msg,
          lv_err     TYPE abap_bool,
          lt_pos     TYPE HASHED TABLE OF ty_pos WITH UNIQUE KEY itm_number,
          lt_fae     TYPE STANDARD TABLE OF ty_fae WITH DEFAULT KEY,
          lt_ekpo    TYPE SORTED TABLE OF ty_ekpo WITH UNIQUE KEY ebelp,
          lt_vky     TYPE HASHED TABLE OF ty_vky WITH UNIQUE KEY vtp vky,
          lt_tdef    TYPE SORTED TABLE OF ty_tdef WITH NON-UNIQUE KEY vtp vky,
          lt_vgw_lif TYPE SORTED TABLE OF ty_vgw_lif WITH NON-UNIQUE KEY matnr nes,
          lt_vgw_wrk TYPE SORTED TABLE OF ty_vgw_wrk WITH NON-UNIQUE KEY matnr werks nes,
          lt_qkey    TYPE HASHED TABLE OF ty_qkey WITH UNIQUE KEY quotyp quotno,
          lt_qp      TYPE STANDARD TABLE OF ty_qp WITH DEFAULT KEY,
          lt_qp_h    TYPE HASHED TABLE OF ty_qp WITH UNIQUE KEY quotyp quotno,
          lt_work    TYPE STANDARD TABLE OF ty_work WITH DEFAULT KEY,
          ls_work    TYPE ty_work,
          ls_nfm     TYPE /nfm/bapidocitm.

    IF it_nfm IS INITIAL.
      RETURN.
    ENDIF.

    SELECT SINGLE bedat, lifnr, ekorg
      FROM ekko
      WHERE ebeln = @iv_purchaseorder
      INTO (@lv_bedat, @lv_lifnr, @lv_ekorg).

    SELECT SINGLE j_1nboesl
      FROM lfm1
      WHERE lifnr = @lv_lifnr
        AND ekorg = @lv_ekorg
      INTO @lv_lme.

    LOOP AT it_poitem ASSIGNING FIELD-SYMBOL(<fs_item>).
      IF <fs_item>-invoice_date IS INITIAL.
        CONTINUE.
      ENDIF.
      INSERT VALUE #( itm_number   = |{ <fs_item>-po_item ALPHA = IN }|
                      ebelp        = <fs_item>-po_item
                      invoice_date = <fs_item>-invoice_date ) INTO TABLE lt_pos.
      APPEND VALUE #( ebelp = <fs_item>-po_item ) TO lt_fae.
    ENDLOOP.

    IF lt_fae IS NOT INITIAL.
      SELECT ebelp, matnr, werks
        FROM ekpo
        FOR ALL ENTRIES IN @lt_fae
        WHERE ebeln = @iv_purchaseorder
          AND ebelp = @lt_fae-ebelp
        INTO TABLE @lt_ekpo.
    ENDIF.

    LOOP AT lt_pos ASSIGNING FIELD-SYMBOL(<fs_pos>).
      READ TABLE lt_ekpo ASSIGNING FIELD-SYMBOL(<fs_ekpo>)
          WITH TABLE KEY ebelp = <fs_pos>-ebelp.
      IF sy-subrc IS INITIAL.
        <fs_pos>-matnr = <fs_ekpo>-matnr.
        <fs_pos>-werks = <fs_ekpo>-werks.
      ENDIF.
      CONCATENATE lv_ekorg lv_lifnr <fs_pos>-matnr INTO <fs_pos>-vky_ea RESPECTING BLANKS.
      CONCATENATE lv_ekorg <fs_pos>-matnr INTO <fs_pos>-vky_ec RESPECTING BLANKS.
      INSERT VALUE #( vtp = 'EA' vky = <fs_pos>-vky_ea ) INTO TABLE lt_vky.
      INSERT VALUE #( vtp = 'EC' vky = <fs_pos>-vky_ec ) INTO TABLE lt_vky.
    ENDLOOP.

    IF lt_vky IS NOT INITIAL.
      SELECT vtp, vky, nes, nfs, bcu
        FROM /nfm/tdefault
        FOR ALL ENTRIES IN @lt_vky
        WHERE vtp = @lt_vky-vtp
          AND vky = @lt_vky-vky
        INTO TABLE @lt_tdef.
    ENDIF.

    IF lt_ekpo IS NOT INITIAL.
      SELECT matnr, nes
        FROM /nfm/tvgw
        FOR ALL ENTRIES IN @lt_ekpo
        WHERE parnr = @lv_lifnr
          AND matnr = @lt_ekpo-matnr
          AND kappl = 'M'
          AND org   = @lv_ekorg
        INTO TABLE @lt_vgw_lif.

      SELECT matnr, werks, nes
        FROM /nfm/tvgw
        FOR ALL ENTRIES IN @lt_ekpo
        WHERE matnr = @lt_ekpo-matnr
          AND kappl = 'M'
          AND werks = @lt_ekpo-werks
        INTO TABLE @lt_vgw_wrk.
    ENDIF.

    LOOP AT it_nfm ASSIGNING FIELD-SYMBOL(<fs_nfm>).
      READ TABLE lt_pos ASSIGNING <fs_pos>
          WITH TABLE KEY itm_number = <fs_nfm>-itm_number.
      IF sy-subrc IS NOT INITIAL.
        CONTINUE.
      ENDIF.

      CLEAR ls_work.
      lv_nes = condense( val = CONV string( <fs_nfm>-nfmkey ) ).

      READ TABLE lt_tdef ASSIGNING FIELD-SYMBOL(<fs_tdef>)
          WITH TABLE KEY vtp = 'EA' vky = <fs_pos>-vky_ea.
      IF sy-subrc IS NOT INITIAL.
        READ TABLE lt_tdef ASSIGNING <fs_tdef>
            WITH TABLE KEY vtp = 'EC' vky = <fs_pos>-vky_ec.
      ENDIF.

      CLEAR lv_err.
      IF sy-subrc IS NOT INITIAL.
        lv_err = abap_true.
      ELSEIF <fs_tdef>-nfs = '01' OR <fs_tdef>-nfs = '04'.
        READ TABLE lt_vgw_lif TRANSPORTING NO FIELDS
            WITH TABLE KEY matnr = <fs_pos>-matnr nes = lv_nes.
        IF sy-subrc IS NOT INITIAL.
          READ TABLE lt_vgw_wrk TRANSPORTING NO FIELDS
              WITH TABLE KEY matnr = <fs_pos>-matnr werks = <fs_pos>-werks nes = lv_nes.
        ENDIF.
        IF sy-subrc IS NOT INITIAL.
          lv_err = abap_true.
        ENDIF.
      ENDIF.

      IF lv_err = abap_true.
        lv_msg = |Precio NFM 0 { iv_purchaseorder }/{ <fs_nfm>-itm_number } NES { lv_nes }|.
        APPEND VALUE #( type       = 'E'
                        id         = 'ZCL_MSG_MM_003'
                        number     = '034'
                        message    = lv_msg
                        message_v1 = iv_purchaseorder
                        message_v2 = <fs_nfm>-itm_number
                        message_v3 = lv_bedat
                        message_v4 = lv_nes ) TO ct_return.
        RETURN.
      ENDIF.

      ls_work-nfm          = <fs_nfm>.
      ls_work-nes          = lv_nes.
      ls_work-nfs          = <fs_tdef>-nfs.
      ls_work-invoice_date = <fs_pos>-invoice_date.

      IF ls_work-nfs = '01' OR ls_work-nfs = '04'.
        IF ls_work-nfs = '01'.
          CONCATENATE 'T1' lv_lme INTO ls_work-quotyp.
        ELSE.
          CONCATENATE 'M1' lv_lme INTO ls_work-quotyp.
        ENDIF.
        CONCATENATE lv_nes 'M' lv_ekorg <fs_tdef>-bcu INTO ls_work-quotno.
        INSERT VALUE #( quotyp = ls_work-quotyp quotno = ls_work-quotno ) INTO TABLE lt_qkey.
      ENDIF.

      APPEND ls_work TO lt_work.
    ENDLOOP.

    IF lt_qkey IS NOT INITIAL.
      SELECT quotyp, quotno, quotdate, price, defcurr
        FROM oicqp
        FOR ALL ENTRIES IN @lt_qkey
        WHERE quosrc    = 'NF'
          AND quotyp    = @lt_qkey-quotyp
          AND quotno    = @lt_qkey-quotno
          AND quotdate <= @lv_bedat
        INTO TABLE @lt_qp.

      SORT lt_qp BY quotyp ASCENDING quotno ASCENDING quotdate DESCENDING.
      DELETE ADJACENT DUPLICATES FROM lt_qp COMPARING quotyp quotno.
      lt_qp_h = lt_qp.
    ENDIF.

    LOOP AT lt_work ASSIGNING FIELD-SYMBOL(<fs_work>).
      ls_nfm            = <fs_work>-nfm.
      ls_nfm-ratedetdat = <fs_work>-invoice_date.
      ls_nfm-updtype    = 'U'.

      IF <fs_work>-nfs = '01' OR <fs_work>-nfs = '04'.
        READ TABLE lt_qp_h ASSIGNING FIELD-SYMBOL(<fs_qp>)
            WITH TABLE KEY quotyp = <fs_work>-quotyp quotno = <fs_work>-quotno.
        IF sy-subrc IS NOT INITIAL.
          lv_msg = |Precio NFM 0 { iv_purchaseorder }/{ ls_nfm-itm_number } NES { <fs_work>-nes }|.
          APPEND VALUE #( type       = 'E'
                          id         = 'ZCL_MSG_MM_003'
                          number     = '034'
                          message    = lv_msg
                          message_v1 = iv_purchaseorder
                          message_v2 = ls_nfm-itm_number
                          message_v3 = lv_bedat
                          message_v4 = <fs_work>-nes ) TO ct_return.
          RETURN.
        ENDIF.

        ls_nfm-actratedat    = <fs_qp>-quotdate.
        ls_nfm-rate          = <fs_qp>-price.
        ls_nfm-ratecurky     = <fs_qp>-defcurr.
        ls_nfm-ratecurkyiso  = <fs_qp>-defcurr.
        ls_nfm-bvalcurkyd    = <fs_qp>-defcurr.
        ls_nfm-bvalcurkydiso = <fs_qp>-defcurr.
      ENDIF.

      APPEND ls_nfm TO ct_nfm_ch.
    ENDLOOP.
  ENDMETHOD.

  METHOD get_gross_condition.
    DATA(lv_item) = CONV bapimepocond-itm_number( |{ iv_po_item ALPHA = IN }| ).

    LOOP AT it_cond ASSIGNING FIELD-SYMBOL(<fs_cond>) USING KEY primary_key
         WHERE itm_number = lv_item
           AND cond_type  = 'PBXX'.
      IF <fs_cond>-cond_value IS NOT INITIAL.
        rs_cond = <fs_cond>.
        RETURN.
      ENDIF.
    ENDLOOP.

    LOOP AT it_cond ASSIGNING <fs_cond> USING KEY primary_key
         WHERE itm_number = lv_item
           AND cond_type  = 'PB00'.
      IF <fs_cond>-cond_value IS NOT INITIAL.
        rs_cond = <fs_cond>.
        RETURN.
      ENDIF.
    ENDLOOP.

    LOOP AT it_cond ASSIGNING <fs_cond> USING KEY primary_key
         WHERE itm_number = lv_item.
      IF <fs_cond>-cond_st_no = '001' AND <fs_cond>-cond_value IS NOT INITIAL.
        rs_cond = <fs_cond>.
        RETURN.
      ENDIF.
    ENDLOOP.
  ENDMETHOD.

  METHOD call_bapi_new_pos.
    DATA: lt_poitem  TYPE STANDARD TABLE OF bapimepoitem,
          lt_poitemx TYPE STANDARD TABLE OF bapimepoitemx.

    lt_poitem  = CORRESPONDING #( is_param-t_poitem ).
    lt_poitemx = CORRESPONDING #( is_param-t_poitemx ).

    CALL FUNCTION 'ENQUEUE_EMEKPOE'
      EXPORTING
        mode_ekpo      = 'E'
        mandt          = sy-mandt
        ebeln          = is_param-iv_purchaseorder
      EXCEPTIONS
        foreign_lock   = 1
        system_failure = 2
        OTHERS         = 3.

    DATA(lv_max_item) = zcl_mm_wrapper_nfm=>get_max_item( is_param-iv_purchaseorder ).

    LOOP AT is_param-t_poitem ASSIGNING FIELD-SYMBOL(<fs_poitem>).
      lv_max_item += 10.

      APPEND VALUE #( posicion   = lv_max_item
                      net_price  = <fs_poitem>-net_price
                      price_unit = <fs_poitem>-price_unit ) TO et_posicion.

      APPEND VALUE #( po_item    = lv_max_item
                      short_text = <fs_poitem>-short_text
                      material   = <fs_poitem>-material
                      plant      = <fs_poitem>-plant
                      stge_loc   = <fs_poitem>-stge_loc
                      item_cat   = <fs_poitem>-item_cat
                      net_price  = <fs_poitem>-net_price
                      price_unit = <fs_poitem>-price_unit
                      quantity   = <fs_poitem>-quantity
                      po_unit    = <fs_poitem>-po_unit ) TO lt_poitem.

      APPEND VALUE #( po_item    = lv_max_item
                      po_itemx   = abap_true
                      short_text = abap_true
                      material   = abap_true
                      plant      = abap_true
                      stge_loc   = abap_true
                      item_cat   = abap_true
                      net_price  = abap_true
                      price_unit = abap_true
                      quantity   = abap_true
                      po_unit    = abap_true ) TO lt_poitemx.
    ENDLOOP.

    CALL FUNCTION 'BAPI_PO_CHANGE'
      EXPORTING
        purchaseorder = is_param-iv_purchaseorder
        poheader      = is_param-is_poheader
        poheaderx     = is_param-is_poheaderx
      TABLES
        return    = rt_return
        poitem    = lt_poitem
        poitemx   = lt_poitemx.

    READ TABLE rt_return TRANSPORTING NO FIELDS
        WITH KEY type = 'S'.
    IF sy-subrc IS INITIAL.
      CALL FUNCTION 'BAPI_TRANSACTION_COMMIT'
        EXPORTING
          wait = abap_true.
    ENDIF.

    CALL FUNCTION 'DEQUEUE_EMEKPOE'
      EXPORTING
        mode_ekpo = 'E'
        mandt     = sy-mandt
        ebeln     = is_param-iv_purchaseorder.
  ENDMETHOD.
ENDCLASS.
