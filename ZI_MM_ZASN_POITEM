@AccessControl.authorizationCheck: #NOT_REQUIRED
@EndUserText.label: 'ZASN agregada por factura/entrega/OC/pos'
@Metadata.ignorePropagatedAnnotations: true
define view entity ZI_MM_ZASN_POITEM
  as select from ZI_MM_ZASN_POITEM_AGG as agg
    inner join I_DeliveryDocument as dlv
      on dlv.DeliveryDocument = agg.DeliveryDocument
{
  key agg.LifexMin,
  key agg.DeliveryDocument,
  key agg.PurchaseOrder,
  key agg.PurchaseOrderItem,
      agg.Material,
      agg.Plant,
      agg.Proveedor,
      agg.DocumentDate,
      agg.AsnCount,
      agg.LifexMax,
      agg.MonedaZasn,
      agg.CantidadFactura,
      case
        when agg.PrecioMin is not null
         and agg.PrecioMin = agg.PrecioMax
          then agg.PrecioMax
        else cast( 0 as abap.dec(16,5) )
      end as PrecioUnitarioVigente,
      case
        when agg.PrecioMin is not null
         and agg.PrecioMin <> agg.PrecioMax
          then 'X'
        else ''
      end as PrecioConflicto
}
where
  dlv.OverallGoodsMovementStatus = 'A'
