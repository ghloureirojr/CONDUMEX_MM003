@AccessControl.authorizationCheck: #NOT_REQUIRED
@EndUserText.label: 'Entrega em status A por posição'
@Metadata.ignorePropagatedAnnotations: true
define view entity ZI_MM_PO_DELIVERY_EXISTS
  as select from ZI_MM_WRAPPER_EKPO as pos

    inner join   I_DeliveryDocumentItem   as asn on  asn.PurchaseOrder     = pos.PurchaseOrder
                                                 and asn.PurchaseOrderItem = pos.PurchaseOrderItem

    inner join   I_DeliveryDocument       as dlv on dlv.DeliveryDocument = asn.DeliveryDocument

{
  key pos.PurchaseOrder,
  key pos.PurchaseOrderItem,
      min( asn.DeliveryDocument )     as DeliveryDocument,
      min( asn.DeliveryDocumentItem ) as DeliveryDocumentItem
}
where
  dlv.OverallGoodsMovementStatus = 'A'
group by
  pos.PurchaseOrder,
  pos.PurchaseOrderItem
