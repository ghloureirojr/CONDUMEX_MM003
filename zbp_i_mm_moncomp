CLASS lcl_buffer DEFINITION CREATE PRIVATE.
  PUBLIC SECTION.
    TYPES: BEGIN OF ty_excel,
             Sociedad     TYPE bukrs,
             Centro       TYPE ewerk,
             Proveedor    TYPE md_supplier,
             oc           TYPE vdm_purchaseorder,
             pos          TYPE vdm_purchaseorderitem,
             Factura      TYPE c LENGTH 35,
             Material     TYPE matnr,
             Precio       TYPE c LENGTH 20,
             Moneda       TYPE waers,
             Cantidad     TYPE c LENGTH 20,
             FechaFactura TYPE c LENGTH 10,
           END OF ty_excel,
           BEGIN OF ty_posicion,
             posicion  TYPE vdm_purchaseorderitem,
             vbeln     TYPE vbeln_vl,
             factura   TYPE lifex,
             precioOC  TYPE zmm_moncomp_log-precio_anterior,
             precioASN TYPE zmm_moncomp_log-precio_asn,
             monedaASN TYPE waers,
           END OF ty_posicion,
           BEGIN OF ty_id,
             oc    TYPE vdm_purchaseorder,
             t_pos TYPE STANDARD TABLE OF ty_posicion WITH DEFAULT KEY,
           END OF ty_id.

    CLASS-DATA gt_log    TYPE STANDARD TABLE OF zmm_moncomp_log.
    CLASS-DATA gv_failed_action TYPE c LENGTH 10.
    CLASS-DATA gt_sag    TYPE HASHED TABLE OF zcl_mm_wrapper_sag_change=>ty_param
                           WITH UNIQUE KEY iv_purchasingdocument.
    CLASS-DATA gt_sag_id TYPE STANDARD TABLE OF ty_id
                           WITH UNIQUE HASHED KEY id COMPONENTS oc.
ENDCLASS.

CLASS lhc_ZI_MM_MONCOMP DEFINITION INHERITING FROM cl_abap_behavior_handler.
  PRIVATE SECTION.

    METHODS get_instance_authorizations FOR INSTANCE AUTHORIZATION
      IMPORTING keys REQUEST requested_authorizations FOR zi_mm_moncomp RESULT result.

    METHODS get_global_authorizations FOR GLOBAL AUTHORIZATION
      IMPORTING REQUEST requested_authorizations FOR zi_mm_moncomp RESULT result.

    METHODS create FOR MODIFY
      IMPORTING entities FOR CREATE zi_mm_moncomp.

    METHODS update FOR MODIFY
      IMPORTING entities FOR UPDATE zi_mm_moncomp.

    METHODS delete FOR MODIFY
      IMPORTING keys FOR DELETE zi_mm_moncomp.

    METHODS read FOR READ
      IMPORTING keys FOR READ zi_mm_moncomp RESULT result.

    METHODS lock FOR LOCK
      IMPORTING keys FOR LOCK zi_mm_moncomp.

    METHODS get_instance_features FOR INSTANCE FEATURES
      IMPORTING keys REQUEST requested_features FOR zi_mm_moncomp RESULT result.

    METHODS downloadtemplate FOR MODIFY
      IMPORTING keys FOR ACTION zi_mm_moncomp~downloadtemplate.

    METHODS uploadexcel FOR MODIFY
      IMPORTING keys FOR ACTION zi_mm_moncomp~uploadexcel.

    METHODS authprecioasn FOR MODIFY
      IMPORTING keys FOR ACTION zi_mm_moncomp~authprecioasn.

    METHODS authDiscre FOR MODIFY
      IMPORTING keys FOR ACTION zi_mm_moncomp~authdiscre.

    METHODS actualizarpreciopaso8 FOR MODIFY
      IMPORTING keys FOR ACTION zi_mm_moncomp~actualizarpreciopaso8.
ENDCLASS.

CLASS lhc_ZI_MM_MONCOMP IMPLEMENTATION.

  METHOD get_instance_authorizations.
  ENDMETHOD.

  METHOD get_global_authorizations.
  ENDMETHOD.

  METHOD create.
  ENDMETHOD.

  METHOD update.
  ENDMETHOD.

  METHOD delete.
  ENDMETHOD.

  METHOD read.
    SELECT *
      FROM zi_mm_moncomp
      FOR ALL ENTRIES IN @keys
      WHERE oc               = @keys-oc
        AND Posicion         = @keys-Posicion
        AND DeliveryDocument = @keys-DeliveryDocument
        AND FacturaRemision  = @keys-FacturaRemision
      INTO CORRESPONDING FIELDS OF TABLE @result.
  ENDMETHOD.

  METHOD lock.
  ENDMETHOD.

  METHOD get_instance_features.
    result = VALUE #( FOR ls_key IN keys (
                        %tky                  = ls_key-%tky
                        %action-authPrecioASN = if_abap_behv=>fc-o-enabled ) ).
  ENDMETHOD.

  METHOD downloadTemplate.
    "La logica esta en el frontend
  ENDMETHOD.

  METHOD uploadExcel.
    DATA: lt_excel         TYPE STANDARD TABLE OF lcl_buffer=>ty_excel,
          lt_poitem        TYPE HASHED TABLE OF zi_mm_wrapper_ekpo WITH UNIQUE KEY PurchaseOrder PurchaseOrderItem,
          lt_poheader      TYPE HASHED TABLE OF zi_mm_wrapper_ekko WITH UNIQUE KEY PurchaseOrder,
          lt_supplier      TYPE HASHED TABLE OF I_Supplier         WITH UNIQUE KEY Supplier,
          lt_plant         TYPE HASHED TABLE OF I_Plant            WITH UNIQUE KEY Plant,
          lt_product       TYPE HASHED TABLE OF I_Product          WITH UNIQUE KEY Product,
          lt_currency      TYPE HASHED TABLE OF I_Currency         WITH UNIQUE KEY Currency,
          lv_file_content  TYPE xstring,
          lv_precio        TYPE zmm_moncomp_log-precio_asn,
          lv_cantidad      TYPE bprei,
          lv_precio_norm   TYPE string,
          lv_cantidad_norm TYPE string,
          lv_utc           TYPE utclong,
          lv_fecha         TYPE d,
          lv_fecha_raw     TYPE string,
          lv_fecha_ok      TYPE abap_bool.

    TYPES: BEGIN OF ty_excel_ok,
             oc      TYPE vdm_purchaseorder,
             pos     TYPE vdm_purchaseorderitem,
             factura TYPE c LENGTH 35,
             precio  TYPE zmm_moncomp_log-precio_asn,
             moneda  TYPE waers,
             fecha   TYPE d,
           END OF ty_excel_ok.

    DATA lt_excel_ok TYPE STANDARD TABLE OF ty_excel_ok.

    IF keys[ 1 ]-%param-mimeType <> 'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet'.
      failed-zi_mm_moncomp   = VALUE #( ( %cid = keys[ 1 ]-%cid ) ).
      reported-zi_mm_moncomp = VALUE #( ( %cid = keys[ 1 ]-%cid
                                          %msg = new_message( id       = 'ZCL_MSG_MM_003'
                                                              number   = 020
                                                              severity = if_abap_behv_message=>severity-error ) ) ).
      RETURN.
    ENDIF.

    lv_file_content = keys[ 1 ]-%param-fileContent.

    DATA(lo_document)   = xco_cp_xlsx=>document->for_file_content( lv_file_content )->read_access( ).
    DATA(lo_worksheet)  = lo_document->get_workbook( )->worksheet->at_position( 1 ).
    DATA(o_sel_pattern) = xco_cp_xlsx_selection=>pattern_builder->simple_from_to( )->from_row(
                          xco_cp_xlsx=>coordinate->for_numeric_value( 2 ) )->get_pattern( ).

    lo_worksheet->select( o_sel_pattern
                        )->row_stream(
                        )->operation->write_to( REF #( lt_excel )
                        )->set_value_transformation( xco_cp_xlsx_read_access=>value_transformation->string_value )->execute( ).

    DELETE lt_excel WHERE proveedor IS INITIAL
                      AND oc        IS INITIAL
                      AND pos       IS INITIAL.

    IF lt_excel IS INITIAL.
      failed-zi_mm_moncomp   = VALUE #( ( %cid = keys[ 1 ]-%cid ) ).
      reported-zi_mm_moncomp = VALUE #( ( %cid = keys[ 1 ]-%cid
                                          %msg = new_message( id       = 'ZCL_MSG_MM_003'
                                                              number   = 002
                                                              severity = if_abap_behv_message=>severity-error ) ) ).
      RETURN.
    ELSE.
      DATA(lt_oc_pos)    = lt_excel.
      DATA(lt_proveedor) = lt_excel.
      DATA(lt_centro)    = lt_excel.
      DATA(lt_material)  = lt_excel.
      DATA(lt_moneda)    = lt_excel.

      SORT: lt_oc_pos    BY oc pos,
            lt_proveedor BY proveedor,
            lt_centro    BY centro,
            lt_material  BY material,
            lt_moneda    BY moneda.

      DELETE ADJACENT DUPLICATES FROM: lt_oc_pos    COMPARING oc pos,
                                       lt_proveedor COMPARING proveedor,
                                       lt_centro    COMPARING centro,
                                       lt_material  COMPARING material,
                                       lt_moneda    COMPARING moneda.

      lt_proveedor = VALUE #( FOR wa IN lt_excel ( proveedor = |{ wa-proveedor ALPHA = IN WIDTH = 10 }| ) ).
      lt_material  = VALUE #( FOR wa IN lt_excel ( material  = |{ wa-material  ALPHA = IN WIDTH = 18 }| ) ).

      SELECT *                                "#EC CI_ALL_FIELDS_NEEDED
        FROM zi_mm_wrapper_ekko
        FOR ALL ENTRIES IN @lt_oc_pos
        WHERE PurchaseOrder = @lt_oc_pos-oc
        INTO TABLE @lt_poheader.

      SELECT *                                "#EC CI_ALL_FIELDS_NEEDED
        FROM zi_mm_wrapper_ekpo
        FOR ALL ENTRIES IN @lt_oc_pos
        WHERE PurchaseOrder     = @lt_oc_pos-oc
          AND PurchaseOrderItem = @lt_oc_pos-pos
        INTO TABLE @lt_poitem.

      SELECT *                                "#EC CI_ALL_FIELDS_NEEDED
        FROM I_Supplier
        FOR ALL ENTRIES IN @lt_proveedor
        WHERE Supplier = @lt_proveedor-proveedor
        INTO TABLE @lt_supplier.

      SELECT *                                "#EC CI_ALL_FIELDS_NEEDED
        FROM I_Plant
        FOR ALL ENTRIES IN @lt_centro
        WHERE Plant = @lt_centro-centro
        INTO TABLE @lt_plant.

      SELECT *                                "#EC CI_ALL_FIELDS_NEEDED
        FROM I_Product
        FOR ALL ENTRIES IN @lt_material
        WHERE Product = @lt_material-material
        INTO TABLE @lt_product.

      SELECT *                                "#EC CI_ALL_FIELDS_NEEDED
        FROM I_Currency
        FOR ALL ENTRIES IN @lt_moneda
        WHERE Currency = @lt_moneda-moneda
        INTO TABLE @lt_currency.

      LOOP AT lt_excel ASSIGNING FIELD-SYMBOL(<fs_excel>).
        CLEAR: lv_precio, lv_cantidad, lv_precio_norm, lv_cantidad_norm, lv_utc, lv_fecha, lv_fecha_raw, lv_fecha_ok.

        IF <fs_excel>-proveedor IS INITIAL OR <fs_excel>-oc IS INITIAL OR <fs_excel>-pos IS INITIAL.
          failed-zi_mm_moncomp   = VALUE #( ( %cid = keys[ 1 ]-%cid ) ).
          reported-zi_mm_moncomp = VALUE #( ( %cid = keys[ 1 ]-%cid
                                              %msg = new_message( id       = 'ZCL_MSG_MM_003'
                                                                  number   = 003
                                                                  severity = if_abap_behv_message=>severity-error ) ) ).
          CLEAR lcl_buffer=>gt_log.
          RETURN.
        ELSE.
          READ TABLE lt_poitem ASSIGNING FIELD-SYMBOL(<fs_poitem>)
              WITH TABLE KEY PurchaseOrder     = <fs_excel>-oc
                             PurchaseOrderItem = <fs_excel>-pos.

          IF sy-subrc IS NOT INITIAL.
            failed-zi_mm_moncomp   = VALUE #( ( %cid = keys[ 1 ]-%cid ) ).
            reported-zi_mm_moncomp = VALUE #( ( %cid = keys[ 1 ]-%cid
                                                %msg = new_message( id       = 'ZCL_MSG_MM_003'
                                                                    number   = 004
                                                                    v1       = <fs_excel>-oc
                                                                    v2       = <fs_excel>-pos
                                                                    severity = if_abap_behv_message=>severity-error ) ) ).
            CLEAR lcl_buffer=>gt_log.
            RETURN.
          ENDIF.

          READ TABLE lt_poheader ASSIGNING FIELD-SYMBOL(<fs_poheader>)
              WITH TABLE KEY PurchaseOrder = <fs_excel>-oc.

          IF sy-subrc IS NOT INITIAL.
            failed-zi_mm_moncomp   = VALUE #( ( %cid = keys[ 1 ]-%cid ) ).
            reported-zi_mm_moncomp = VALUE #( ( %cid = keys[ 1 ]-%cid
                                                %msg = new_message( id       = 'ZCL_MSG_MM_003'
                                                                    number   = 004
                                                                    v1       = <fs_excel>-oc
                                                                    v2       = <fs_excel>-pos
                                                                    severity = if_abap_behv_message=>severity-error ) ) ).
            CLEAR lcl_buffer=>gt_log.
            RETURN.
          ENDIF.

          "El proveedor del Excel debe coincidir con el de la OC (EKKO-LIFNR)
          IF CONV lifnr( |{ <fs_excel>-proveedor ALPHA = IN WIDTH = 10 }| )
          <> CONV lifnr( |{ <fs_poheader>-Supplier ALPHA = IN WIDTH = 10 }| ).
            failed-zi_mm_moncomp   = VALUE #( ( %cid = keys[ 1 ]-%cid ) ).
            reported-zi_mm_moncomp = VALUE #( ( %cid = keys[ 1 ]-%cid
                                                %msg = new_message( id       = 'ZCL_MSG_MM_003'
                                                                    number   = 021
                                                                    v1       = <fs_excel>-proveedor
                                                                    v2       = <fs_excel>-oc
                                                                    severity = if_abap_behv_message=>severity-error ) ) ).
            CLEAR lcl_buffer=>gt_log.
            RETURN.
          ENDIF.

          "El centro del Excel, si se informa, debe coincidir con el del item (EKPO-WERKS)
          IF <fs_excel>-centro IS NOT INITIAL AND <fs_excel>-centro <> <fs_poitem>-Plant.
            failed-zi_mm_moncomp   = VALUE #( ( %cid = keys[ 1 ]-%cid ) ).
            reported-zi_mm_moncomp = VALUE #( ( %cid = keys[ 1 ]-%cid
                                                %msg = new_message( id       = 'ZCL_MSG_MM_003'
                                                                    number   = 022
                                                                    v1       = <fs_excel>-centro
                                                                    v2       = <fs_excel>-oc
                                                                    v3       = <fs_excel>-pos
                                                                    severity = if_abap_behv_message=>severity-error ) ) ).
            CLEAR lcl_buffer=>gt_log.
            RETURN.
          ENDIF.

          "El material del Excel, si se informa, debe coincidir con el del item (EKPO-MATNR)
          IF <fs_excel>-material IS NOT INITIAL
          AND |{ <fs_excel>-material ALPHA = IN WIDTH = 18 }|
           <> |{ <fs_poitem>-Material ALPHA = IN WIDTH = 18 }|.
            failed-zi_mm_moncomp   = VALUE #( ( %cid = keys[ 1 ]-%cid ) ).
            reported-zi_mm_moncomp = VALUE #( ( %cid = keys[ 1 ]-%cid
                                                %msg = new_message( id       = 'ZCL_MSG_MM_003'
                                                                    number   = 023
                                                                    v1       = <fs_excel>-material
                                                                    v2       = <fs_excel>-oc
                                                                    v3       = <fs_excel>-pos
                                                                    severity = if_abap_behv_message=>severity-error ) ) ).
            CLEAR lcl_buffer=>gt_log.
            RETURN.
          ENDIF.

          READ TABLE lt_supplier TRANSPORTING NO FIELDS
              WITH TABLE KEY Supplier = CONV lifnr( |{ <fs_excel>-proveedor ALPHA = IN WIDTH = 10 }| ).

          IF sy-subrc IS NOT INITIAL.
            failed-zi_mm_moncomp   = VALUE #( ( %cid = keys[ 1 ]-%cid ) ).
            reported-zi_mm_moncomp = VALUE #( ( %cid = keys[ 1 ]-%cid
                                                %msg = new_message( id       = 'ZCL_MSG_MM_003'
                                                                    number   = 005
                                                                    v1       = <fs_excel>-proveedor
                                                                    severity = if_abap_behv_message=>severity-error ) ) ).
            CLEAR lcl_buffer=>gt_log.
            RETURN.
          ENDIF.

          IF <fs_excel>-sociedad IS NOT INITIAL AND <fs_excel>-sociedad <> '1810' AND <fs_excel>-sociedad <> '1820'.
            failed-zi_mm_moncomp   = VALUE #( ( %cid = keys[ 1 ]-%cid ) ).
            reported-zi_mm_moncomp = VALUE #( ( %cid = keys[ 1 ]-%cid
                                                %msg = new_message( id       = 'ZCL_MSG_MM_003'
                                                                    number   = 006
                                                                    severity = if_abap_behv_message=>severity-error ) ) ).
            CLEAR lcl_buffer=>gt_log.
            RETURN.
          ENDIF.

          IF <fs_excel>-centro IS NOT INITIAL.
            READ TABLE lt_plant TRANSPORTING NO FIELDS
                WITH TABLE KEY Plant = <fs_excel>-centro.

            IF sy-subrc IS NOT INITIAL.
              failed-zi_mm_moncomp   = VALUE #( ( %cid = keys[ 1 ]-%cid ) ).
              reported-zi_mm_moncomp = VALUE #( ( %cid = keys[ 1 ]-%cid
                                                  %msg = new_message( id       = 'ZCL_MSG_MM_003'
                                                                      number   = 007
                                                                      v1       = <fs_excel>-centro
                                                                      severity = if_abap_behv_message=>severity-error ) ) ).
              CLEAR lcl_buffer=>gt_log.
              RETURN.
            ENDIF.
          ENDIF.

          IF <fs_excel>-material IS NOT INITIAL.
            READ TABLE lt_product ASSIGNING FIELD-SYMBOL(<fs_product>)
                WITH TABLE KEY Product = |{ <fs_excel>-material ALPHA = IN WIDTH = 18 }|.

            IF sy-subrc IS NOT INITIAL.
              failed-zi_mm_moncomp   = VALUE #( ( %cid = keys[ 1 ]-%cid ) ).
              reported-zi_mm_moncomp = VALUE #( ( %cid = keys[ 1 ]-%cid
                                                  %msg = new_message( id       = 'ZCL_MSG_MM_003'
                                                                      number   = 008
                                                                      v1       = <fs_excel>-material
                                                                      severity = if_abap_behv_message=>severity-error ) ) ).
              CLEAR lcl_buffer=>gt_log.
              RETURN.
            ELSEIF <fs_product>-ProductType <> 'NF' AND <fs_product>-ProductType <> 'ROH'.
              failed-zi_mm_moncomp   = VALUE #( ( %cid = keys[ 1 ]-%cid ) ).
              reported-zi_mm_moncomp = VALUE #( ( %cid = keys[ 1 ]-%cid
                                                  %msg = new_message( id       = 'ZCL_MSG_MM_003'
                                                                      number   = 009
                                                                      v1       = <fs_excel>-material
                                                                      severity = if_abap_behv_message=>severity-error ) ) ).
              CLEAR lcl_buffer=>gt_log.
              RETURN.
            ENDIF.
          ENDIF.

          IF <fs_excel>-moneda IS NOT INITIAL.
            READ TABLE lt_currency TRANSPORTING NO FIELDS
                WITH TABLE KEY Currency = <fs_excel>-moneda.

            IF sy-subrc IS NOT INITIAL.
              failed-zi_mm_moncomp   = VALUE #( ( %cid = keys[ 1 ]-%cid ) ).
              reported-zi_mm_moncomp = VALUE #( ( %cid = keys[ 1 ]-%cid
                                                  %msg = new_message( id       = 'ZCL_MSG_MM_003'
                                                                      number   = 010
                                                                      v1       = <fs_excel>-moneda
                                                                      severity = if_abap_behv_message=>severity-error ) ) ).
              CLEAR lcl_buffer=>gt_log.
              RETURN.
            ENDIF.
          ENDIF.

          IF <fs_excel>-precio IS NOT INITIAL.
            lv_precio_norm = replace( val = <fs_excel>-precio sub = ',' with = '.' ).

            TRY.
                lv_precio = CONV #( lv_precio_norm ).
              CATCH cx_sy_conversion_no_number
                    cx_sy_conversion_overflow
                    cx_sy_conversion_error.
                failed-zi_mm_moncomp   = VALUE #( ( %cid = keys[ 1 ]-%cid ) ).
                reported-zi_mm_moncomp = VALUE #( ( %cid = keys[ 1 ]-%cid
                                                    %msg = new_message( id       = 'ZCL_MSG_MM_003'
                                                                        number   = 011
                                                                        v1       = <fs_excel>-precio
                                                                        severity = if_abap_behv_message=>severity-error ) ) ).
                CLEAR lcl_buffer=>gt_log.
                RETURN.
            ENDTRY.
          ENDIF.

          IF <fs_excel>-cantidad IS NOT INITIAL.
            lv_cantidad_norm = replace( val = <fs_excel>-cantidad sub = ',' with = '.' ).

            TRY.
                lv_cantidad = CONV bprei( lv_cantidad_norm ).
              CATCH cx_sy_conversion_no_number
                    cx_sy_conversion_overflow
                    cx_sy_conversion_error.
                failed-zi_mm_moncomp   = VALUE #( ( %cid = keys[ 1 ]-%cid ) ).
                reported-zi_mm_moncomp = VALUE #( ( %cid = keys[ 1 ]-%cid
                                                    %msg = new_message( id       = 'ZCL_MSG_MM_003'
                                                                        number   = 012
                                                                        v1       = <fs_excel>-cantidad
                                                                        severity = if_abap_behv_message=>severity-error ) ) ).
                CLEAR lcl_buffer=>gt_log.
                RETURN.
            ENDTRY.
          ENDIF.

          IF <fs_excel>-factura IS INITIAL.
            failed-zi_mm_moncomp   = VALUE #( ( %cid = keys[ 1 ]-%cid ) ).
            reported-zi_mm_moncomp = VALUE #( ( %cid = keys[ 1 ]-%cid
                                                %msg = new_message_with_text(
                                                         severity = if_abap_behv_message=>severity-error
                                                         text     = 'Factura obligatoria' ) ) ).
            CLEAR lcl_buffer=>gt_log.
            RETURN.
          ENDIF.

          IF <fs_excel>-fechafactura IS INITIAL.
            failed-zi_mm_moncomp   = VALUE #( ( %cid = keys[ 1 ]-%cid ) ).
            reported-zi_mm_moncomp = VALUE #( ( %cid = keys[ 1 ]-%cid
                                                %msg = new_message_with_text(
                                                         severity = if_abap_behv_message=>severity-error
                                                         text     = 'Fecha de factura obligatoria' ) ) ).
            CLEAR lcl_buffer=>gt_log.
            RETURN.
          ENDIF.

          IF <fs_excel>-fechafactura IS NOT INITIAL.
            lv_fecha_raw = condense( val = <fs_excel>-fechafactura ).

            TRY.
                CASE strlen( lv_fecha_raw ).
                  WHEN 8.
                    lv_fecha = lv_fecha_raw.
                  WHEN 10.
                    IF lv_fecha_raw+4(1) = '-' OR lv_fecha_raw+4(1) = '/'.
                      lv_fecha = lv_fecha_raw+0(4) && lv_fecha_raw+5(2) && lv_fecha_raw+8(2).
                    ELSE.
                      lv_fecha = lv_fecha_raw+6(4) && lv_fecha_raw+3(2) && lv_fecha_raw+0(2).
                    ENDIF.
                  WHEN OTHERS.
                    CLEAR lv_fecha.
                ENDCASE.

                IF lv_fecha IS NOT INITIAL.
                  lv_fecha_ok = abap_true.
                ENDIF.
              CATCH cx_sy_conversion_no_number
                    cx_sy_conversion_overflow
                    cx_sy_conversion_error.
            ENDTRY.

            IF lv_fecha_ok = abap_false.
              failed-zi_mm_moncomp   = VALUE #( ( %cid = keys[ 1 ]-%cid ) ).
              reported-zi_mm_moncomp = VALUE #( ( %cid = keys[ 1 ]-%cid
                                                  %msg = new_message( id       = 'ZCL_MSG_MM_003'
                                                                      number   = 028
                                                                      v1       = <fs_excel>-fechafactura
                                                                      severity = if_abap_behv_message=>severity-error ) ) ).
              CLEAR lcl_buffer=>gt_log.
              RETURN.
            ENDIF.
          ENDIF.

          APPEND VALUE #( oc      = <fs_excel>-oc
                          pos     = <fs_excel>-pos
                          factura = <fs_excel>-factura
                          precio  = lv_precio
                          moneda  = <fs_excel>-moneda
                          fecha   = lv_fecha ) TO lt_excel_ok.
        ENDIF.
      ENDLOOP.

      TYPES: BEGIN OF ty_entrega,
               oc       TYPE vdm_purchaseorder,
               posicion TYPE vdm_purchaseorderitem,
               vbeln    TYPE vbeln_vl,
             END OF ty_entrega.

      DATA: lt_entrega TYPE SORTED TABLE OF ty_entrega WITH UNIQUE KEY oc posicion vbeln,
            lt_zasn    TYPE STANDARD TABLE OF zi_mm_zasn_poitem,
            lv_hits    TYPE i,
            lv_vbeln   TYPE vbeln_vl,
            lv_pr_zasn TYPE zi_mm_zasn_poitem-PrecioUnitarioVigente,
            lv_pr_conf TYPE zi_mm_zasn_poitem-PrecioConflicto.

      SELECT *                                "#EC CI_ALL_FIELDS_NEEDED
        FROM zi_mm_zasn_poitem
        FOR ALL ENTRIES IN @lt_excel_ok
        WHERE PurchaseOrder     = @lt_excel_ok-oc
          AND PurchaseOrderItem = @lt_excel_ok-pos
        INTO TABLE @lt_zasn.

      LOOP AT lt_excel_ok ASSIGNING FIELD-SYMBOL(<fs_ok>).
        CLEAR: lv_hits, lv_vbeln, lv_pr_zasn, lv_pr_conf.

        LOOP AT lt_zasn ASSIGNING FIELD-SYMBOL(<fs_zasn>)
            WHERE PurchaseOrder     = <fs_ok>-oc
              AND PurchaseOrderItem = <fs_ok>-pos
              AND LifexMin          = <fs_ok>-factura
              AND DocumentDate      = <fs_ok>-fecha.
          lv_hits    = lv_hits + 1.
          lv_vbeln   = <fs_zasn>-DeliveryDocument.
          lv_pr_zasn = <fs_zasn>-PrecioUnitarioVigente.
          lv_pr_conf = <fs_zasn>-PrecioConflicto.
        ENDLOOP.

        IF lv_hits = 0.
          failed-zi_mm_moncomp   = VALUE #( ( %cid = keys[ 1 ]-%cid ) ).
          reported-zi_mm_moncomp = VALUE #( ( %cid = keys[ 1 ]-%cid
                                              %msg = new_message_with_text(
                                                       severity = if_abap_behv_message=>severity-error
                                                       text     = |No hay entrega para OC { <fs_ok>-oc } pos { <fs_ok>-pos }| ) ) ).
          CLEAR lcl_buffer=>gt_log.
          RETURN.
        ELSEIF lv_hits > 1.
          failed-zi_mm_moncomp   = VALUE #( ( %cid = keys[ 1 ]-%cid ) ).
          reported-zi_mm_moncomp = VALUE #( ( %cid = keys[ 1 ]-%cid
                                              %msg = new_message_with_text(
                                                       severity = if_abap_behv_message=>severity-error
                                                       text     = |Hay más de una entrega para OC { <fs_ok>-oc } pos { <fs_ok>-pos }| ) ) ).
          CLEAR lcl_buffer=>gt_log.
          RETURN.
        ENDIF.

        IF lv_pr_zasn > 0 OR lv_pr_conf = 'X'.
          failed-zi_mm_moncomp   = VALUE #( ( %cid = keys[ 1 ]-%cid ) ).
          reported-zi_mm_moncomp = VALUE #( ( %cid = keys[ 1 ]-%cid
                                              %msg = new_message_with_text(
                                                       severity = if_abap_behv_message=>severity-error
                                                       text     = 'el precio ya fue inducido mediante el ASN, contacte administrador' ) ) ).
          CLEAR lcl_buffer=>gt_log.
          RETURN.
        ENDIF.

        READ TABLE lt_entrega TRANSPORTING NO FIELDS
            WITH KEY oc       = <fs_ok>-oc
                     posicion = <fs_ok>-pos
                     vbeln    = lv_vbeln.
        IF sy-subrc IS INITIAL.
          failed-zi_mm_moncomp   = VALUE #( ( %cid = keys[ 1 ]-%cid ) ).
          reported-zi_mm_moncomp = VALUE #( ( %cid = keys[ 1 ]-%cid
                                              %msg = new_message_with_text(
                                                       severity = if_abap_behv_message=>severity-error
                                                       text     = |Dos líneas corresponden a la misma entrega { lv_vbeln }| ) ) ).
          CLEAR lcl_buffer=>gt_log.
          RETURN.
        ENDIF.

        INSERT VALUE #( oc       = <fs_ok>-oc
                        posicion = <fs_ok>-pos
                        vbeln    = lv_vbeln ) INTO TABLE lt_entrega.

        lv_utc = utclong_add( val = utclong_current( ) seconds = 1 ).

        APPEND VALUE #( client        = sy-mandt
                        oc            = <fs_ok>-oc
                        posicion      = <fs_ok>-pos
                        vbeln         = lv_vbeln
                        usuario       = cl_abap_context_info=>get_user_technical_name( )
                        fecha_hora    = cl_abap_tstmp=>utclong2tstmp( lv_utc )
                        precio_asn    = <fs_ok>-precio
                        moneda_asn    = <fs_ok>-moneda
                        nota          = <fs_ok>-factura
                        fecha_factura = <fs_ok>-fecha ) TO lcl_buffer=>gt_log.
      ENDLOOP.

    ENDIF.
  ENDMETHOD.

  METHOD authPrecioASN.
    DATA: lt_id         TYPE STANDARD TABLE OF lcl_buffer=>ty_id        WITH UNIQUE HASHED KEY id COMPONENTS oc,
          lt_change_pos TYPE STANDARD TABLE OF zcl_mm_wrapper_po_change=>ty_param,
          lt_result     TYPE STANDARD TABLE OF zcl_mm_parallel_po_change=>ty_return,
          lt_sag        TYPE HASHED TABLE OF zcl_mm_wrapper_sag_change=>ty_param
                          WITH UNIQUE KEY iv_purchasingdocument,
          lt_sag_id     TYPE STANDARD TABLE OF lcl_buffer=>ty_id
                          WITH UNIQUE HASHED KEY id COMPONENTS oc,
          lt_sag_result TYPE STANDARD TABLE OF zcl_mm_parallel_sag_change=>ty_return,
          lv_timestamp  TYPE timestamp,
          lv_buffer     TYPE xstring,
          lv_sag_buffer TYPE xstring,
          lv_last_oc    TYPE vdm_purchaseorder,
          lv_run_bapi   TYPE abap_bool,
          lv_run_sag    TYPE abap_bool,
          lv_sag_ok     TYPE abap_bool,
          lv_pos_err    TYPE abap_bool,
          lv_has_s      TYPE abap_bool,
          lv_row        TYPE bapiret2-row,
          lv_bapi_msg   TYPE abap_bool,
          lv_sag_msg    TYPE abap_bool,
          lv_err_txt    TYPE string,
          lt_in         TYPE cl_abap_parallel=>t_in_tab,
          lv_peinh      TYPE epein,
          lv_monto      TYPE bapicurext.

    FIELD-SYMBOLS: <fs_id>             TYPE lcl_buffer=>ty_id,
                   <fs_sag_id>         TYPE lcl_buffer=>ty_id,
                   <fs_pos>            TYPE lcl_buffer=>ty_posicion,
                   <fs_change_pos>     TYPE zcl_mm_wrapper_po_change=>ty_param,
                   <fs_br>             TYPE bapiret2.

    CONSTANTS lc_msg_dup TYPE string VALUE 'Una misma posición de un documento de compra no puede modificarse más que una vez a la vez, modifique el precio una vez concluya el ciclo y si es necesario entre de nuevo a la app'.

    CLEAR: lcl_buffer=>gt_sag, lcl_buffer=>gt_sag_id.

    READ ENTITIES OF zi_mm_moncomp IN LOCAL MODE
      ENTITY zi_mm_moncomp
        ALL FIELDS WITH CORRESPONDING #( keys )
      RESULT DATA(lt_moncomp).

    SORT lt_moncomp BY oc Posicion.

    TYPES: BEGIN OF ty_pos_cnt,
             oc       TYPE vdm_purchaseorder,
             posicion TYPE vdm_purchaseorderitem,
             cnt      TYPE i,
           END OF ty_pos_cnt.

    DATA: lt_pos_cnt TYPE SORTED TABLE OF ty_pos_cnt WITH UNIQUE KEY oc posicion,
          lt_dup     TYPE SORTED TABLE OF ty_pos_cnt WITH UNIQUE KEY oc posicion.

    LOOP AT lt_moncomp ASSIGNING FIELD-SYMBOL(<fs_cnt_row>).
      READ TABLE lt_pos_cnt ASSIGNING FIELD-SYMBOL(<fs_pos_cnt>)
          WITH TABLE KEY oc       = <fs_cnt_row>-oc
                         posicion = <fs_cnt_row>-Posicion.
      IF sy-subrc IS INITIAL.
        <fs_pos_cnt>-cnt = <fs_pos_cnt>-cnt + 1.
      ELSE.
        INSERT VALUE #( oc       = <fs_cnt_row>-oc
                        posicion = <fs_cnt_row>-Posicion
                        cnt      = 1 ) INTO TABLE lt_pos_cnt.
      ENDIF.
    ENDLOOP.

    LOOP AT lt_pos_cnt ASSIGNING <fs_pos_cnt> WHERE cnt > 1.
      INSERT <fs_pos_cnt> INTO TABLE lt_dup.
    ENDLOOP.

    LOOP AT lt_moncomp ASSIGNING <fs_cnt_row>.
      READ TABLE lt_dup TRANSPORTING NO FIELDS
          WITH TABLE KEY oc       = <fs_cnt_row>-oc
                         posicion = <fs_cnt_row>-Posicion.
      IF sy-subrc IS NOT INITIAL.
        CONTINUE.
      ENDIF.

      reported-zi_mm_moncomp = VALUE #( BASE reported-zi_mm_moncomp (
                                               %tky = keys[ KEY id %key-oc               = <fs_cnt_row>-oc
                                                                   %key-Posicion         = <fs_cnt_row>-Posicion
                                                                   %key-DeliveryDocument = <fs_cnt_row>-DeliveryDocument
                                                                   %key-FacturaRemision  = <fs_cnt_row>-FacturaRemision ]-%tky
                                               %msg = new_message_with_text(
                                                        severity = if_abap_behv_message=>severity-error
                                                        text     = lc_msg_dup ) ) ).

      failed-zi_mm_moncomp = VALUE #( BASE failed-zi_mm_moncomp (
                                             %tky        = keys[ KEY id %key-oc               = <fs_cnt_row>-oc
                                                                        %key-Posicion         = <fs_cnt_row>-Posicion
                                                                        %key-DeliveryDocument = <fs_cnt_row>-DeliveryDocument
                                                                        %key-FacturaRemision  = <fs_cnt_row>-FacturaRemision ]-%tky
                                             %fail-cause = if_abap_behv=>cause-unspecific ) ).
    ENDLOOP.

    LOOP AT lt_moncomp ASSIGNING FIELD-SYMBOL(<fs_moncomp>).
      READ TABLE lt_dup TRANSPORTING NO FIELDS
          WITH TABLE KEY oc       = <fs_moncomp>-oc
                         posicion = <fs_moncomp>-Posicion.
      IF sy-subrc IS INITIAL.
        CONTINUE.
      ENDIF.

      GET TIME STAMP FIELD lv_timestamp.

      IF <fs_moncomp>-oc <> lv_last_oc.
        CLEAR lv_last_oc.
        lv_last_oc = <fs_moncomp>-oc.

        APPEND INITIAL LINE TO lt_id ASSIGNING <fs_id>.
        <fs_id>-oc = <fs_moncomp>-oc.

        IF <fs_moncomp>-TipoDocumento <> 'L'.
          APPEND INITIAL LINE TO lt_change_pos ASSIGNING <fs_change_pos>.
          <fs_change_pos>-iv_purchaseorder       = <fs_moncomp>-oc.
          <fs_change_pos>-is_poheader-po_number  = <fs_moncomp>-oc.
          <fs_change_pos>-is_poheaderx-po_number = abap_true.
        ENDIF.
      ENDIF.

      IF <fs_moncomp>-TipoDocumento = 'L'.
        IF <fs_moncomp>-MonedaOC <> <fs_moncomp>-MonedaASN.
          APPEND VALUE #( client     = sy-mandt
                          oc         = <fs_moncomp>-oc
                          posicion   = <fs_moncomp>-Posicion
                          vbeln      = <fs_moncomp>-DeliveryDocument
                          usuario    = cl_abap_context_info=>get_user_technical_name( )
                          fecha_hora = lv_timestamp
                          accion     = '01'
                          estado     = '03' ) TO lcl_buffer=>gt_log.

          reported-zi_mm_moncomp = VALUE #( BASE reported-zi_mm_moncomp (
                                                   %tky = keys[ KEY id %key-oc               = <fs_moncomp>-oc
                                                                       %key-Posicion         = <fs_moncomp>-Posicion
                                                                       %key-DeliveryDocument = <fs_moncomp>-DeliveryDocument
                                                                       %key-FacturaRemision  = <fs_moncomp>-FacturaRemision ]-%tky
                                                   %msg = new_message( id       = 'ZCL_MSG_MM_003'
                                                                       number   = 015
                                                                       v1       = <fs_moncomp>-oc
                                                                       v2       = <fs_moncomp>-Posicion
                                                                       severity = if_abap_behv_message=>severity-error ) ) ).
          CLEAR lv_timestamp.
          CONTINUE.
        ENDIF.

        IF <fs_moncomp>-FechaFactura IS INITIAL.
          reported-zi_mm_moncomp = VALUE #( BASE reported-zi_mm_moncomp (
                                                   %tky = keys[ KEY id %key-oc               = <fs_moncomp>-oc
                                                                       %key-Posicion         = <fs_moncomp>-Posicion
                                                                       %key-DeliveryDocument = <fs_moncomp>-DeliveryDocument
                                                                       %key-FacturaRemision  = <fs_moncomp>-FacturaRemision ]-%tky
                                                   %msg = new_message( id       = 'ZCL_MSG_MM_003'
                                                                       number   = 030
                                                                       v1       = <fs_moncomp>-oc
                                                                       v2       = <fs_moncomp>-Posicion
                                                                       severity = if_abap_behv_message=>severity-error ) ) ).
          CLEAR lv_timestamp.
          CONTINUE.
        ENDIF.

        READ TABLE lt_sag ASSIGNING FIELD-SYMBOL(<fs_sag>)
            WITH TABLE KEY iv_purchasingdocument = <fs_moncomp>-oc.

        IF sy-subrc IS NOT INITIAL.
          INSERT VALUE #( iv_purchasingdocument = <fs_moncomp>-oc )
                 INTO TABLE lt_sag ASSIGNING <fs_sag>.
          APPEND VALUE #( oc = <fs_moncomp>-oc ) TO lt_sag_id.
        ENDIF.

        CLEAR: lv_peinh, lv_monto.
        lv_peinh = <fs_moncomp>-Cantidad.
        IF lv_peinh > 0.
          lv_monto = round( val = CONV decfloat34( <fs_moncomp>-PrecioASN ) * lv_peinh dec = 2 ).
        ELSE.
          lv_monto = <fs_moncomp>-PrecioASN.
        ENDIF.

        INSERT VALUE #( item         = <fs_moncomp>-Posicion
                        price        = lv_monto
                        currency     = <fs_moncomp>-MonedaASN
                        unit         = <fs_moncomp>-CantidadPedidaUnidad
                        price_unit   = lv_peinh
                        invoice_date = <fs_moncomp>-FechaFactura )
               INTO TABLE <fs_sag>-t_item.

        READ TABLE lt_sag_id ASSIGNING <fs_sag_id>
            WITH TABLE KEY id COMPONENTS oc = <fs_moncomp>-oc.

        APPEND VALUE #( posicion  = <fs_moncomp>-Posicion
                        vbeln     = <fs_moncomp>-DeliveryDocument
                        factura   = <fs_moncomp>-FacturaRemision
                        precioOC  = <fs_moncomp>-PrecioOC
                        precioASN = <fs_moncomp>-PrecioASN
                        monedaASN = <fs_moncomp>-MonedaASN ) TO <fs_sag_id>-t_pos.

        lv_run_sag = abap_true.
        CLEAR lv_timestamp.
        CONTINUE.
      ENDIF.

      IF <fs_moncomp>-IsNfm = 'X'.
        IF <fs_moncomp>-FechaFactura IS INITIAL.
          reported-zi_mm_moncomp = VALUE #( BASE reported-zi_mm_moncomp (
                                                   %tky = keys[ KEY id %key-oc               = <fs_moncomp>-oc
                                                                       %key-Posicion         = <fs_moncomp>-Posicion
                                                                       %key-DeliveryDocument = <fs_moncomp>-DeliveryDocument
                                                                       %key-FacturaRemision  = <fs_moncomp>-FacturaRemision ]-%tky
                                                   %msg = new_message( id       = 'ZCL_MSG_MM_003'
                                                                       number   = 030
                                                                       v1       = <fs_moncomp>-oc
                                                                       v2       = <fs_moncomp>-Posicion
                                                                       severity = if_abap_behv_message=>severity-error ) ) ).
          CLEAR lv_timestamp.
          CONTINUE.
        ENDIF.

        APPEND VALUE #( po_item      = <fs_moncomp>-Posicion
                        invoice_date = <fs_moncomp>-FechaFactura ) TO <fs_change_pos>-t_poitem.

        APPEND VALUE #( po_item  = <fs_moncomp>-Posicion
                        po_itemx = abap_true ) TO <fs_change_pos>-t_poitemx.

        APPEND VALUE #( posicion  = <fs_moncomp>-Posicion
                        vbeln     = <fs_moncomp>-DeliveryDocument
                        factura   = <fs_moncomp>-FacturaRemision
                        precioOC  = <fs_moncomp>-PrecioOC
                        precioASN = <fs_moncomp>-PrecioASN
                        monedaASN = <fs_moncomp>-MonedaASN ) TO <fs_id>-t_pos.

        lv_run_bapi = abap_true.
        CLEAR lv_timestamp.
        CONTINUE.
      ENDIF.

      IF <fs_moncomp>-MonedaOC = <fs_moncomp>-MonedaASN.
        APPEND VALUE #( posicion  = <fs_moncomp>-Posicion
                        vbeln     = <fs_moncomp>-DeliveryDocument
                        factura   = <fs_moncomp>-FacturaRemision
                        precioOC  = <fs_moncomp>-PrecioOC
                        precioASN = <fs_moncomp>-PrecioASN
                        monedaASN = <fs_moncomp>-MonedaASN ) TO <fs_id>-t_pos.

        CLEAR: lv_peinh, lv_monto.
        lv_peinh = <fs_moncomp>-Cantidad.
        IF lv_peinh > 0.
          lv_monto = round( val = CONV decfloat34( <fs_moncomp>-PrecioASN ) * lv_peinh dec = 2 ).
        ELSE.
          lv_monto = <fs_moncomp>-PrecioASN.
        ENDIF.

        APPEND VALUE #( po_item    = <fs_moncomp>-Posicion
                        net_price  = lv_monto
                        price_unit = lv_peinh ) TO <fs_change_pos>-t_poitem.

        APPEND VALUE #( po_item    = <fs_moncomp>-Posicion
                        po_itemx   = abap_true
                        net_price  = abap_true
                        price_unit = abap_true ) TO <fs_change_pos>-t_poitemx.

        lv_run_bapi = abap_true.
      ELSE.
        APPEND VALUE #( client     = sy-mandt
                        oc         = <fs_moncomp>-oc
                        posicion   = <fs_moncomp>-Posicion
                        vbeln      = <fs_moncomp>-DeliveryDocument
                        usuario    = cl_abap_context_info=>get_user_technical_name( )
                        fecha_hora = lv_timestamp
                        accion     = '01'
                        estado     = '03' ) TO lcl_buffer=>gt_log.

        reported-zi_mm_moncomp = VALUE #( BASE reported-zi_mm_moncomp (
                                                 %tky = keys[ KEY id %key-oc               = <fs_moncomp>-oc
                                                                     %key-Posicion         = <fs_moncomp>-Posicion
                                                                     %key-DeliveryDocument = <fs_moncomp>-DeliveryDocument
                                                                     %key-FacturaRemision  = <fs_moncomp>-FacturaRemision ]-%tky
                                                 %msg = new_message( id       = 'ZCL_MSG_MM_003'
                                                                     number   = 015
                                                                     v1       = <fs_moncomp>-oc
                                                                     v2       = <fs_moncomp>-Posicion
                                                                     severity = if_abap_behv_message=>severity-error ) ) ).
      ENDIF.
      CLEAR lv_timestamp.
    ENDLOOP.

    IF lv_run_bapi = abap_true.
      CLEAR lt_in.

      DATA(ls_data) = VALUE zcl_mm_parallel_po_change=>ty_data( change_pos = lt_change_pos ).

      EXPORT data = ls_data TO DATA BUFFER lv_buffer.
      INSERT lv_buffer INTO TABLE lt_in.

      DATA(lo_parallel) = NEW zcl_mm_parallel_po_change( p_local_server = abap_true ).

      TRY.
          lo_parallel->run( EXPORTING p_in_tab  = lt_in
                                      p_debug   = abap_false
                            IMPORTING p_out_tab = DATA(lt_out) ).
        CATCH cx_root INTO DATA(lx_par).
          LOOP AT keys ASSIGNING FIELD-SYMBOL(<fs_key_ex>).
            reported-zi_mm_moncomp = VALUE #( BASE reported-zi_mm_moncomp (
                                                     %tky = <fs_key_ex>-%tky
                                                     %msg = new_message_with_text(
                                                              severity = if_abap_behv_message=>severity-error
                                                              text     = lx_par->get_text( ) ) ) ).
            failed-zi_mm_moncomp = VALUE #( BASE failed-zi_mm_moncomp (
                                                   %tky        = <fs_key_ex>-%tky
                                                   %fail-cause = if_abap_behv=>cause-unspecific ) ).
            lv_bapi_msg = abap_true.
          ENDLOOP.
      ENDTRY.

      READ TABLE lt_out ASSIGNING FIELD-SYMBOL(<fs_out>) INDEX 1.

      IF sy-subrc IS INITIAL AND <fs_out>-result IS NOT INITIAL.
        IMPORT return = lt_result FROM DATA BUFFER <fs_out>-result.

        LOOP AT lt_result ASSIGNING FIELD-SYMBOL(<fs_result>).
          READ TABLE lt_id ASSIGNING <fs_id>
            WITH TABLE KEY id COMPONENTS oc = <fs_result>-oc.

          IF sy-subrc IS INITIAL.
            IF line_exists( <fs_result>-bapiret[ type = 'E' ] )
            OR line_exists( <fs_result>-bapiret[ type = 'A' ] )
            OR NOT line_exists( <fs_result>-bapiret[ type = 'S' ] ).
              CLEAR lv_err_txt.
              LOOP AT <fs_result>-bapiret ASSIGNING <fs_br>.
                IF <fs_br>-type = 'E' OR <fs_br>-type = 'A'.
                  lv_err_txt = <fs_br>-message.
                  IF lv_err_txt IS INITIAL.
                    lv_err_txt = |{ <fs_br>-id }/{ <fs_br>-number } { <fs_br>-message_v1 } { <fs_br>-message_v2 }|.
                  ENDIF.
                  EXIT.
                ENDIF.
              ENDLOOP.

              LOOP AT <fs_id>-t_pos ASSIGNING <fs_pos>.
                GET TIME STAMP FIELD lv_timestamp.

                APPEND VALUE #( client     = sy-mandt
                                oc         = <fs_result>-oc
                                posicion   = <fs_pos>-posicion
                                vbeln      = <fs_pos>-vbeln
                                usuario    = cl_abap_context_info=>get_user_technical_name( )
                                fecha_hora = lv_timestamp ) TO lcl_buffer=>gt_log.

                IF lv_err_txt IS INITIAL.
                  reported-zi_mm_moncomp = VALUE #( BASE reported-zi_mm_moncomp (
                                                           %tky = keys[ KEY id %key-oc               = <fs_result>-oc
                                                                               %key-Posicion         = <fs_pos>-posicion
                                                                               %key-DeliveryDocument = <fs_pos>-vbeln
                                                                               %key-FacturaRemision  = <fs_pos>-factura ]-%tky
                                                           %msg = new_message( id       = 'ZCL_MSG_MM_003'
                                                                               number   = 016
                                                                               v1       = <fs_result>-oc
                                                                               v2       = <fs_pos>-posicion
                                                                               severity = if_abap_behv_message=>severity-error ) ) ).
                ELSE.
                  reported-zi_mm_moncomp = VALUE #( BASE reported-zi_mm_moncomp (
                                                           %tky = keys[ KEY id %key-oc               = <fs_result>-oc
                                                                               %key-Posicion         = <fs_pos>-posicion
                                                                               %key-DeliveryDocument = <fs_pos>-vbeln
                                                                               %key-FacturaRemision  = <fs_pos>-factura ]-%tky
                                                           %msg = new_message_with_text(
                                                                    severity = if_abap_behv_message=>severity-error
                                                                    text     = lv_err_txt ) ) ).
                ENDIF.

                failed-zi_mm_moncomp = VALUE #( BASE failed-zi_mm_moncomp (
                                                       %tky        = keys[ KEY id %key-oc               = <fs_result>-oc
                                                                                  %key-Posicion         = <fs_pos>-posicion
                                                                                  %key-DeliveryDocument = <fs_pos>-vbeln
                                                                                  %key-FacturaRemision  = <fs_pos>-factura ]-%tky
                                                       %fail-cause = if_abap_behv=>cause-unspecific ) ).
                lv_bapi_msg = abap_true.
                CLEAR lv_timestamp.
              ENDLOOP.
            ELSE.
              LOOP AT <fs_id>-t_pos ASSIGNING <fs_pos>.
                GET TIME STAMP FIELD lv_timestamp.

                APPEND VALUE #( client          = sy-mandt
                                oc              = <fs_result>-oc
                                posicion        = <fs_pos>-posicion
                                vbeln           = <fs_pos>-vbeln
                                usuario         = cl_abap_context_info=>get_user_technical_name( )
                                fecha_hora      = lv_timestamp
                                precio_asn      = <fs_pos>-PrecioASN
                                moneda_asn      = <fs_pos>-MonedaASN
                                accion          = '01'
                                estado          = '06'
                                precio_anterior = <fs_pos>-preciooc
                                precio_nuevo    = <fs_pos>-precioasn ) TO lcl_buffer=>gt_log.

                reported-zi_mm_moncomp = VALUE #( BASE reported-zi_mm_moncomp (
                                                         %tky = keys[ KEY id %key-oc               = <fs_result>-oc
                                                                             %key-Posicion         = <fs_pos>-posicion
                                                                             %key-DeliveryDocument = <fs_pos>-vbeln
                                                                             %key-FacturaRemision  = <fs_pos>-factura ]-%tky
                                                         %msg = new_message( id       = 'ZCL_MSG_MM_003'
                                                                             number   = 017
                                                                             v1       = <fs_result>-oc
                                                                             v2       = <fs_pos>-posicion
                                                                             severity = if_abap_behv_message=>severity-success ) ) ).
                lv_bapi_msg = abap_true.
                CLEAR lv_timestamp.
              ENDLOOP.
            ENDIF.
          ENDIF.
        ENDLOOP.
      ENDIF.

      IF lv_bapi_msg = abap_false.
        LOOP AT keys ASSIGNING FIELD-SYMBOL(<fs_key_sil>).
          reported-zi_mm_moncomp = VALUE #( BASE reported-zi_mm_moncomp (
                                                   %tky = <fs_key_sil>-%tky
                                                   %msg = new_message_with_text(
                                                            severity = if_abap_behv_message=>severity-error
                                                            text     = |Sin respuesta BAPI_PO_CHANGE OC { <fs_key_sil>-Oc } pos { <fs_key_sil>-Posicion }| ) ) ).
          failed-zi_mm_moncomp = VALUE #( BASE failed-zi_mm_moncomp (
                                                 %tky        = <fs_key_sil>-%tky
                                                 %fail-cause = if_abap_behv=>cause-unspecific ) ).
        ENDLOOP.
      ENDIF.
    ENDIF.

    IF lv_run_sag = abap_true.
      CLEAR: lt_in, lv_sag_buffer.

      DATA(ls_sag_data) = VALUE zcl_mm_parallel_sag_change=>ty_data( sag_change = CORRESPONDING #( lt_sag ) ).

      EXPORT data = ls_sag_data TO DATA BUFFER lv_sag_buffer.
      INSERT lv_sag_buffer INTO TABLE lt_in.

      DATA(lo_sag_parallel) = NEW zcl_mm_parallel_sag_change( p_local_server = abap_true ).

      TRY.
          lo_sag_parallel->run( EXPORTING p_in_tab  = lt_in
                                          p_debug   = abap_false
                                IMPORTING p_out_tab = DATA(lt_sag_out) ).
        CATCH cx_root INTO DATA(lx_sag).
          LOOP AT keys ASSIGNING FIELD-SYMBOL(<fs_key_sag>).
            reported-zi_mm_moncomp = VALUE #( BASE reported-zi_mm_moncomp (
                                                     %tky = <fs_key_sag>-%tky
                                                     %msg = new_message_with_text(
                                                              severity = if_abap_behv_message=>severity-error
                                                              text     = lx_sag->get_text( ) ) ) ).
            failed-zi_mm_moncomp = VALUE #( BASE failed-zi_mm_moncomp (
                                                   %tky        = <fs_key_sag>-%tky
                                                   %fail-cause = if_abap_behv=>cause-unspecific ) ).
            lv_sag_msg = abap_true.
          ENDLOOP.
      ENDTRY.

      READ TABLE lt_sag_out ASSIGNING FIELD-SYMBOL(<fs_sag_out>) INDEX 1.

      IF sy-subrc IS INITIAL AND <fs_sag_out>-result IS NOT INITIAL.
        IMPORT return = lt_sag_result FROM DATA BUFFER <fs_sag_out>-result.

        LOOP AT lt_sag_result ASSIGNING FIELD-SYMBOL(<fs_sag_res>).
          READ TABLE lt_sag_id ASSIGNING <fs_sag_id>
              WITH TABLE KEY id COMPONENTS oc = <fs_sag_res>-oc.

          IF sy-subrc IS NOT INITIAL.
            CONTINUE.
          ENDIF.

          LOOP AT <fs_sag_id>-t_pos ASSIGNING <fs_pos>.
            GET TIME STAMP FIELD lv_timestamp.

            lv_row = <fs_pos>-posicion.
            CLEAR: lv_err_txt, lv_pos_err, lv_has_s.

            LOOP AT <fs_sag_res>-bapiret ASSIGNING <fs_br>.
              IF <fs_br>-type = 'E' OR <fs_br>-type = 'A'.
                IF <fs_br>-row IS NOT INITIAL AND <fs_br>-row <> lv_row.
                  CONTINUE.
                ENDIF.
                IF lv_pos_err = abap_false.
                  lv_pos_err = abap_true.
                  lv_err_txt = <fs_br>-message.
                  IF lv_err_txt IS INITIAL.
                    lv_err_txt = |{ <fs_br>-id }/{ <fs_br>-number } { <fs_br>-message_v1 }|.
                  ENDIF.
                ENDIF.
              ELSEIF <fs_br>-type = 'S' AND <fs_br>-row = lv_row.
                lv_has_s = abap_true.
              ENDIF.
            ENDLOOP.

            lv_sag_ok = xsdbool( lv_pos_err = abap_false AND lv_has_s = abap_true ).

            IF lv_sag_ok = abap_true.
              APPEND VALUE #( client          = sy-mandt
                              oc              = <fs_sag_res>-oc
                              posicion        = <fs_pos>-posicion
                              vbeln           = <fs_pos>-vbeln
                              usuario         = cl_abap_context_info=>get_user_technical_name( )
                              fecha_hora      = lv_timestamp
                              precio_asn      = <fs_pos>-precioasn
                              moneda_asn      = <fs_pos>-monedaasn
                              accion          = '01'
                              estado          = '06'
                              precio_anterior = <fs_pos>-preciooc
                              precio_nuevo    = <fs_pos>-precioasn ) TO lcl_buffer=>gt_log.

              reported-zi_mm_moncomp = VALUE #( BASE reported-zi_mm_moncomp (
                                                       %tky = keys[ KEY id %key-oc               = <fs_sag_res>-oc
                                                                           %key-Posicion         = <fs_pos>-posicion
                                                                           %key-DeliveryDocument = <fs_pos>-vbeln
                                                                           %key-FacturaRemision  = <fs_pos>-factura ]-%tky
                                                       %msg = new_message( id       = 'ZCL_MSG_MM_003'
                                                                           number   = 017
                                                                           v1       = <fs_sag_res>-oc
                                                                           v2       = <fs_pos>-posicion
                                                                           severity = if_abap_behv_message=>severity-success ) ) ).
            ELSE.
              IF lv_err_txt IS INITIAL.
                reported-zi_mm_moncomp = VALUE #( BASE reported-zi_mm_moncomp (
                                                         %tky = keys[ KEY id %key-oc               = <fs_sag_res>-oc
                                                                             %key-Posicion         = <fs_pos>-posicion
                                                                             %key-DeliveryDocument = <fs_pos>-vbeln
                                                                             %key-FacturaRemision  = <fs_pos>-factura ]-%tky
                                                         %msg = new_message( id       = 'ZCL_MSG_MM_003'
                                                                             number   = 016
                                                                             v1       = <fs_sag_res>-oc
                                                                             v2       = <fs_pos>-posicion
                                                                             severity = if_abap_behv_message=>severity-error ) ) ).
              ELSE.
                reported-zi_mm_moncomp = VALUE #( BASE reported-zi_mm_moncomp (
                                                         %tky = keys[ KEY id %key-oc               = <fs_sag_res>-oc
                                                                             %key-Posicion         = <fs_pos>-posicion
                                                                             %key-DeliveryDocument = <fs_pos>-vbeln
                                                                             %key-FacturaRemision  = <fs_pos>-factura ]-%tky
                                                         %msg = new_message_with_text(
                                                                  severity = if_abap_behv_message=>severity-error
                                                                  text     = lv_err_txt ) ) ).
              ENDIF.

              failed-zi_mm_moncomp = VALUE #( BASE failed-zi_mm_moncomp (
                                                     %tky        = keys[ KEY id %key-oc               = <fs_sag_res>-oc
                                                                                %key-Posicion         = <fs_pos>-posicion
                                                                                %key-DeliveryDocument = <fs_pos>-vbeln
                                                                                %key-FacturaRemision  = <fs_pos>-factura ]-%tky
                                                     %fail-cause = if_abap_behv=>cause-unspecific ) ).
            ENDIF.

            lv_sag_msg = abap_true.
            CLEAR lv_timestamp.
          ENDLOOP.
        ENDLOOP.
      ENDIF.

      IF lv_sag_msg = abap_false.
        LOOP AT keys ASSIGNING FIELD-SYMBOL(<fs_key_ss>).
          reported-zi_mm_moncomp = VALUE #( BASE reported-zi_mm_moncomp (
                                                   %tky = <fs_key_ss>-%tky
                                                   %msg = new_message_with_text(
                                                            severity = if_abap_behv_message=>severity-error
                                                            text     = |Sin respuesta BAPI_SAG_CHANGE OC { <fs_key_ss>-Oc } pos { <fs_key_ss>-Posicion }| ) ) ).
          failed-zi_mm_moncomp = VALUE #( BASE failed-zi_mm_moncomp (
                                                 %tky        = <fs_key_ss>-%tky
                                                 %fail-cause = if_abap_behv=>cause-unspecific ) ).
        ENDLOOP.
      ENDIF.
    ENDIF.
  ENDMETHOD.

  METHOD authDiscre.
    DATA lv_timestamp TYPE timestamp.

    READ ENTITIES OF zi_mm_moncomp IN LOCAL MODE
      ENTITY zi_mm_moncomp
        ALL FIELDS WITH CORRESPONDING #( keys )
      RESULT DATA(lt_moncomp).

    LOOP AT lt_moncomp ASSIGNING FIELD-SYMBOL(<fs_moncomp>).
      GET TIME STAMP FIELD lv_timestamp.

      APPEND VALUE #( client          = sy-mandt
                      oc              = <fs_moncomp>-oc
                      posicion        = <fs_moncomp>-Posicion
                      vbeln           = <fs_moncomp>-DeliveryDocument
                      usuario         = cl_abap_context_info=>get_user_technical_name( )
                      fecha_hora      = lv_timestamp
                      precio_asn      = <fs_moncomp>-PrecioASN
                      moneda_asn      = <fs_moncomp>-MonedaASN
                      accion          = '02'
                      nota            = keys[ KEY id oc                = <fs_moncomp>-oc
                                                      Posicion         = <fs_moncomp>-Posicion
                                                      DeliveryDocument = <fs_moncomp>-DeliveryDocument
                                                      FacturaRemision  = <fs_moncomp>-FacturaRemision ]-%param-Nota
                      estado          = '06' ) TO lcl_buffer=>gt_log.

      CLEAR lv_timestamp.
    ENDLOOP.
  ENDMETHOD.

  METHOD actualizarPrecioPaso8.
    TYPES: BEGIN OF ty_ocpos,
             oc       TYPE vdm_purchaseorder,
             posicion TYPE vdm_purchaseorderitem,
           END OF ty_ocpos.

    DATA: lt_rows       TYPE STANDARD TABLE OF zi_mm_moncomp_paso8 WITH EMPTY KEY,
          lt_id         TYPE STANDARD TABLE OF lcl_buffer=>ty_id WITH UNIQUE HASHED KEY id COMPONENTS oc,
          lt_change_pos TYPE STANDARD TABLE OF zcl_mm_wrapper_po_change=>ty_param,
          lt_result     TYPE STANDARD TABLE OF zcl_mm_parallel_po_change=>ty_return,
          lt_sag        TYPE HASHED TABLE OF zcl_mm_wrapper_sag_change=>ty_param
                          WITH UNIQUE KEY iv_purchasingdocument,
          lt_sag_id     TYPE STANDARD TABLE OF lcl_buffer=>ty_id
                          WITH UNIQUE HASHED KEY id COMPONENTS oc,
          lt_sag_result TYPE STANDARD TABLE OF zcl_mm_parallel_sag_change=>ty_return,
          lt_ok         TYPE SORTED TABLE OF ty_ocpos WITH UNIQUE KEY oc posicion,
          lt_err        TYPE SORTED TABLE OF ty_ocpos WITH UNIQUE KEY oc posicion,
          lt_in         TYPE cl_abap_parallel=>t_in_tab,
          ls_first      TYPE zi_mm_moncomp_paso8,
          lv_timestamp  TYPE timestamp,
          lv_buffer     TYPE xstring,
          lv_sag_buffer TYPE xstring,
          lv_run_bapi   TYPE abap_bool,
          lv_run_sag    TYPE abap_bool,
          lv_exc_po     TYPE abap_bool,
          lv_exc_sag    TYPE abap_bool,
          lv_dup        TYPE abap_bool,
          lv_sag_ok     TYPE abap_bool,
          lv_pos_err    TYPE abap_bool,
          lv_has_s      TYPE abap_bool,
          lv_row        TYPE bapiret2-row,
          lv_err_txt    TYPE string,
          lv_fecha      TYPE zi_mm_moncomp_paso8-FechaFactura,
          lv_last_pos   TYPE vdm_purchaseorderitem,
          lv_peinh      TYPE epein,
          lv_monto      TYPE bapicurext,
          lv_n          TYPE i,
          lv_m          TYPE i.

    FIELD-SYMBOLS: <fs_id>         TYPE lcl_buffer=>ty_id,
                   <fs_sag_id>     TYPE lcl_buffer=>ty_id,
                   <fs_pos>        TYPE lcl_buffer=>ty_posicion,
                   <fs_change_pos> TYPE zcl_mm_wrapper_po_change=>ty_param,
                   <fs_result>     TYPE zcl_mm_parallel_po_change=>ty_return,
                   <fs_br>         TYPE bapiret2.

    lcl_buffer=>gv_failed_action = 'PASO8'.

    IF keys IS INITIAL.
      RETURN.
    ENDIF.

    DATA(ls_param) = keys[ 1 ]-%param.
    DATA(lv_cid)   = keys[ 1 ]-%cid.

    DATA(lv_fil_centro)  = xsdbool( ls_param-Centro IS NOT INITIAL ).
    DATA(lv_fil_mat)     = xsdbool( ls_param-Material IS NOT INITIAL ).
    DATA(lv_fil_prov)    = xsdbool( ls_param-Proveedor IS NOT INITIAL ).
    DATA(lv_fil_oc)      = xsdbool( ls_param-OrdenCompra IS NOT INITIAL ).
    DATA(lv_fil_entrega) = xsdbool( ls_param-Entrega IS NOT INITIAL ).
    DATA(lv_fil_desde)   = xsdbool( ls_param-FechaFacturaDesde IS NOT INITIAL ).
    DATA(lv_fil_hasta)   = xsdbool( ls_param-FechaFacturaHasta IS NOT INITIAL ).

    "Validaciones del filtro
    IF ls_param-Sociedad IS INITIAL.
      reported-zi_mm_moncomp = VALUE #( BASE reported-zi_mm_moncomp (
                                               %cid = lv_cid
                                               %msg = new_message_with_text(
                                                        severity = if_abap_behv_message=>severity-error
                                                        text     = 'Informe la sociedad.' ) ) ).
      failed-zi_mm_moncomp = VALUE #( BASE failed-zi_mm_moncomp (
                                             %cid        = lv_cid
                                             %fail-cause = if_abap_behv=>cause-unspecific ) ).
      RETURN.
    ENDIF.

    IF ls_param-Sociedad <> '1810' AND ls_param-Sociedad <> '1820'.
      reported-zi_mm_moncomp = VALUE #( BASE reported-zi_mm_moncomp (
                                               %cid = lv_cid
                                               %msg = new_message_with_text(
                                                        severity = if_abap_behv_message=>severity-error
                                                        text     = 'La sociedad debe ser 1810 o 1820.' ) ) ).
      failed-zi_mm_moncomp = VALUE #( BASE failed-zi_mm_moncomp (
                                             %cid        = lv_cid
                                             %fail-cause = if_abap_behv=>cause-unspecific ) ).
      RETURN.
    ENDIF.

    IF ls_param-FechaFacturaDesde IS NOT INITIAL
   AND ls_param-FechaFacturaHasta IS NOT INITIAL
   AND ls_param-FechaFacturaDesde > ls_param-FechaFacturaHasta.
      reported-zi_mm_moncomp = VALUE #( BASE reported-zi_mm_moncomp (
                                               %cid = lv_cid
                                               %msg = new_message_with_text(
                                                        severity = if_abap_behv_message=>severity-error
                                                        text     = 'La fecha desde es mayor que la fecha hasta.' ) ) ).
      failed-zi_mm_moncomp = VALUE #( BASE failed-zi_mm_moncomp (
                                             %cid        = lv_cid
                                             %fail-cause = if_abap_behv=>cause-unspecific ) ).
      RETURN.
    ENDIF.

    SELECT FROM zi_mm_moncomp_paso8
      FIELDS *
      WHERE Sociedad = @ls_param-Sociedad
        AND ( @lv_fil_centro  = @abap_false OR Centro           =  @ls_param-Centro )
        AND ( @lv_fil_mat     = @abap_false OR Material         =  @ls_param-Material )
        AND ( @lv_fil_prov    = @abap_false OR Proveedor        =  @ls_param-Proveedor )
        AND ( @lv_fil_oc      = @abap_false OR OC               =  @ls_param-OrdenCompra )
        AND ( @lv_fil_entrega = @abap_false OR DeliveryDocument =  @ls_param-Entrega )
        AND ( @lv_fil_desde   = @abap_false OR FechaFactura     >= @ls_param-FechaFacturaDesde )
        AND ( @lv_fil_hasta   = @abap_false OR FechaFactura     <= @ls_param-FechaFacturaHasta )
      INTO TABLE @lt_rows.

    IF lt_rows IS INITIAL.
      reported-zi_mm_moncomp = VALUE #( BASE reported-zi_mm_moncomp (
                                               %cid = lv_cid
                                               %msg = new_message( id       = 'ZCL_MSG_MM_003'
                                                                   number   = 039
                                                                   severity = if_abap_behv_message=>severity-information ) ) ).
      RETURN.
    ENDIF.

    SORT lt_rows BY OC Posicion DeliveryDocument FacturaRemision.

    "Una entrada por OC + posicion; las entregas quedan para el log
    LOOP AT lt_rows ASSIGNING FIELD-SYMBOL(<fs_row>)
         GROUP BY ( oc       = <fs_row>-OC
                    posicion = <fs_row>-Posicion )
         ASSIGNING FIELD-SYMBOL(<fs_grp>).

      CLEAR: ls_first, lv_dup, lv_fecha.

      LOOP AT GROUP <fs_grp> ASSIGNING FIELD-SYMBOL(<fs_mem>).
        IF ls_first IS INITIAL.
          ls_first = <fs_mem>.
        ELSEIF <fs_mem>-PrecioASN <> ls_first-PrecioASN.
          lv_dup = abap_true.
        ENDIF.
        IF lv_fecha IS INITIAL.
          lv_fecha = <fs_mem>-FechaFactura.
        ENDIF.
      ENDLOOP.

      IF lv_dup = abap_true.
        reported-zi_mm_moncomp = VALUE #( BASE reported-zi_mm_moncomp (
                                                 %cid = lv_cid
                                                 %msg = new_message_with_text(
                                                          severity = if_abap_behv_message=>severity-error
                                                          text     = |OC { <fs_grp>-oc } posición { <fs_grp>-posicion }: el precio ASN no es único entre las entregas.| ) ) ).
        INSERT VALUE ty_ocpos( oc = <fs_grp>-oc posicion = <fs_grp>-posicion ) INTO TABLE lt_err.
        CONTINUE.
      ENDIF.

      "NFM: el paso 8 no graba el precio neto
      IF ls_first-IsNfm = 'X'.
        reported-zi_mm_moncomp = VALUE #( BASE reported-zi_mm_moncomp (
                                                 %cid = lv_cid
                                                 %msg = new_message( id       = 'ZCL_MSG_MM_003'
                                                                     number   = 040
                                                                     v1       = <fs_grp>-oc
                                                                     v2       = <fs_grp>-posicion
                                                                     severity = if_abap_behv_message=>severity-error ) ) ).
        INSERT VALUE ty_ocpos( oc = <fs_grp>-oc posicion = <fs_grp>-posicion ) INTO TABLE lt_err.
        CONTINUE.
      ENDIF.

      CLEAR: lv_peinh, lv_monto.
      lv_peinh = ls_first-Cantidad.
      IF lv_peinh > 0.
        lv_monto = round( val = CONV decfloat34( ls_first-PrecioASN ) * lv_peinh dec = 2 ).
      ELSE.
        lv_monto = ls_first-PrecioASN.
      ENDIF.

      IF ls_first-TipoDocumento = 'L'.
        IF lv_fecha IS INITIAL.
          reported-zi_mm_moncomp = VALUE #( BASE reported-zi_mm_moncomp (
                                                   %cid = lv_cid
                                                   %msg = new_message( id       = 'ZCL_MSG_MM_003'
                                                                       number   = 030
                                                                       v1       = <fs_grp>-oc
                                                                       v2       = <fs_grp>-posicion
                                                                       severity = if_abap_behv_message=>severity-error ) ) ).
          INSERT VALUE ty_ocpos( oc = <fs_grp>-oc posicion = <fs_grp>-posicion ) INTO TABLE lt_err.
          CONTINUE.
        ENDIF.

        READ TABLE lt_sag ASSIGNING FIELD-SYMBOL(<fs_sag>)
            WITH TABLE KEY iv_purchasingdocument = <fs_grp>-oc.

        IF sy-subrc IS NOT INITIAL.
          INSERT VALUE #( iv_purchasingdocument = <fs_grp>-oc )
                 INTO TABLE lt_sag ASSIGNING <fs_sag>.
          APPEND VALUE #( oc = <fs_grp>-oc ) TO lt_sag_id.
        ENDIF.

        INSERT VALUE #( item         = <fs_grp>-posicion
                        price        = lv_monto
                        currency     = ls_first-MonedaASN
                        unit         = ls_first-CantidadPedidaUnidad
                        price_unit   = lv_peinh
                        invoice_date = lv_fecha )
               INTO TABLE <fs_sag>-t_item.

        READ TABLE lt_sag_id ASSIGNING <fs_sag_id>
            WITH TABLE KEY id COMPONENTS oc = <fs_grp>-oc.

        LOOP AT GROUP <fs_grp> ASSIGNING <fs_mem>.
          APPEND VALUE #( posicion  = <fs_mem>-Posicion
                          vbeln     = <fs_mem>-DeliveryDocument
                          factura   = <fs_mem>-FacturaRemision
                          precioOC  = <fs_mem>-PrecioOC
                          precioASN = <fs_mem>-PrecioASN
                          monedaASN = <fs_mem>-MonedaASN ) TO <fs_sag_id>-t_pos.
        ENDLOOP.

        lv_run_sag = abap_true.
        CONTINUE.
      ENDIF.

      READ TABLE lt_id ASSIGNING <fs_id>
          WITH TABLE KEY id COMPONENTS oc = <fs_grp>-oc.

      IF sy-subrc IS NOT INITIAL.
        APPEND INITIAL LINE TO lt_id ASSIGNING <fs_id>.
        <fs_id>-oc = <fs_grp>-oc.

        APPEND INITIAL LINE TO lt_change_pos ASSIGNING <fs_change_pos>.
        <fs_change_pos>-iv_purchaseorder       = <fs_grp>-oc.
        <fs_change_pos>-is_poheader-po_number  = <fs_grp>-oc.
        <fs_change_pos>-is_poheaderx-po_number = abap_true.
      ELSE.
        READ TABLE lt_change_pos ASSIGNING <fs_change_pos>
            WITH KEY iv_purchaseorder = <fs_grp>-oc.
      ENDIF.

      APPEND VALUE #( po_item    = <fs_grp>-posicion
                      net_price  = lv_monto
                      price_unit = lv_peinh ) TO <fs_change_pos>-t_poitem.

      APPEND VALUE #( po_item    = <fs_grp>-posicion
                      po_itemx   = abap_true
                      net_price  = abap_true
                      price_unit = abap_true ) TO <fs_change_pos>-t_poitemx.

      LOOP AT GROUP <fs_grp> ASSIGNING <fs_mem>.
        APPEND VALUE #( posicion  = <fs_mem>-Posicion
                        vbeln     = <fs_mem>-DeliveryDocument
                        factura   = <fs_mem>-FacturaRemision
                        precioOC  = <fs_mem>-PrecioOC
                        precioASN = <fs_mem>-PrecioASN
                        monedaASN = <fs_mem>-MonedaASN ) TO <fs_id>-t_pos.
      ENDLOOP.

      lv_run_bapi = abap_true.
    ENDLOOP.

    "Ordenes de compra (BAPI_PO_CHANGE)
    IF lv_run_bapi = abap_true.
      CLEAR lt_in.

      DATA(ls_data) = VALUE zcl_mm_parallel_po_change=>ty_data( change_pos = lt_change_pos ).

      EXPORT data = ls_data TO DATA BUFFER lv_buffer.
      INSERT lv_buffer INTO TABLE lt_in.

      DATA(lo_parallel) = NEW zcl_mm_parallel_po_change( p_local_server = abap_true ).

      TRY.
          lo_parallel->run( EXPORTING p_in_tab  = lt_in
                                      p_debug   = abap_false
                            IMPORTING p_out_tab = DATA(lt_out) ).
        CATCH cx_root INTO DATA(lx_par).
          lv_exc_po = abap_true.
          reported-zi_mm_moncomp = VALUE #( BASE reported-zi_mm_moncomp (
                                                   %cid = lv_cid
                                                   %msg = new_message_with_text(
                                                            severity = if_abap_behv_message=>severity-error
                                                            text     = lx_par->get_text( ) ) ) ).
      ENDTRY.

      IF lv_exc_po = abap_false.
        READ TABLE lt_out ASSIGNING FIELD-SYMBOL(<fs_out>) INDEX 1.
        IF sy-subrc IS INITIAL AND <fs_out>-result IS NOT INITIAL.
          IMPORT return = lt_result FROM DATA BUFFER <fs_out>-result.
        ENDIF.
      ENDIF.

      LOOP AT lt_id ASSIGNING <fs_id>.
        IF lv_exc_po = abap_true.
          LOOP AT <fs_id>-t_pos ASSIGNING <fs_pos>.
            INSERT VALUE ty_ocpos( oc = <fs_id>-oc posicion = <fs_pos>-posicion ) INTO TABLE lt_err.
          ENDLOOP.
          CONTINUE.
        ENDIF.

        CLEAR lv_err_txt.
        UNASSIGN <fs_result>.
        READ TABLE lt_result ASSIGNING <fs_result>
            WITH KEY oc = <fs_id>-oc.

        IF sy-subrc IS INITIAL
       AND NOT line_exists( <fs_result>-bapiret[ type = 'E' ] )
       AND NOT line_exists( <fs_result>-bapiret[ type = 'A' ] )
       AND line_exists( <fs_result>-bapiret[ type = 'S' ] ).
          LOOP AT <fs_id>-t_pos ASSIGNING <fs_pos>.
            GET TIME STAMP FIELD lv_timestamp.

            APPEND VALUE #( client          = sy-mandt
                            oc              = <fs_id>-oc
                            posicion        = <fs_pos>-posicion
                            vbeln           = <fs_pos>-vbeln
                            usuario         = cl_abap_context_info=>get_user_technical_name( )
                            fecha_hora      = lv_timestamp
                            precio_asn      = <fs_pos>-precioasn
                            moneda_asn      = <fs_pos>-monedaasn
                            accion          = '01'
                            estado          = '05'
                            precio_anterior = <fs_pos>-preciooc
                            precio_nuevo    = <fs_pos>-precioasn ) TO lcl_buffer=>gt_log.

            INSERT VALUE ty_ocpos( oc = <fs_id>-oc posicion = <fs_pos>-posicion ) INTO TABLE lt_ok.
            CLEAR lv_timestamp.
          ENDLOOP.
          CONTINUE.
        ENDIF.

        IF <fs_result> IS ASSIGNED.
          LOOP AT <fs_result>-bapiret ASSIGNING <fs_br>.
            IF <fs_br>-type = 'E' OR <fs_br>-type = 'A'.
              lv_err_txt = <fs_br>-message.
              IF lv_err_txt IS INITIAL.
                lv_err_txt = |{ <fs_br>-id }/{ <fs_br>-number } { <fs_br>-message_v1 } { <fs_br>-message_v2 }|.
              ENDIF.
              EXIT.
            ENDIF.
          ENDLOOP.
        ENDIF.

        IF lv_err_txt IS INITIAL.
          lv_err_txt = |Sin respuesta al actualizar la OC { <fs_id>-oc }.|.
        ELSE.
          lv_err_txt = |OC { <fs_id>-oc }: { lv_err_txt }|.
        ENDIF.

        reported-zi_mm_moncomp = VALUE #( BASE reported-zi_mm_moncomp (
                                                 %cid = lv_cid
                                                 %msg = new_message_with_text(
                                                          severity = if_abap_behv_message=>severity-error
                                                          text     = lv_err_txt ) ) ).

        LOOP AT <fs_id>-t_pos ASSIGNING <fs_pos>.
          INSERT VALUE ty_ocpos( oc = <fs_id>-oc posicion = <fs_pos>-posicion ) INTO TABLE lt_err.
        ENDLOOP.
      ENDLOOP.
    ENDIF.

    "Contratos marco (SAG)
    IF lv_run_sag = abap_true.
      CLEAR: lt_in, lv_sag_buffer.

      DATA(ls_sag_data) = VALUE zcl_mm_parallel_sag_change=>ty_data( sag_change = CORRESPONDING #( lt_sag ) ).

      EXPORT data = ls_sag_data TO DATA BUFFER lv_sag_buffer.
      INSERT lv_sag_buffer INTO TABLE lt_in.

      DATA(lo_sag_parallel) = NEW zcl_mm_parallel_sag_change( p_local_server = abap_true ).

      TRY.
          lo_sag_parallel->run( EXPORTING p_in_tab  = lt_in
                                          p_debug   = abap_false
                                IMPORTING p_out_tab = DATA(lt_sag_out) ).
        CATCH cx_root INTO DATA(lx_sag).
          lv_exc_sag = abap_true.
          reported-zi_mm_moncomp = VALUE #( BASE reported-zi_mm_moncomp (
                                                   %cid = lv_cid
                                                   %msg = new_message_with_text(
                                                            severity = if_abap_behv_message=>severity-error
                                                            text     = lx_sag->get_text( ) ) ) ).
      ENDTRY.

      IF lv_exc_sag = abap_false.
        READ TABLE lt_sag_out ASSIGNING FIELD-SYMBOL(<fs_sag_out>) INDEX 1.
        IF sy-subrc IS INITIAL AND <fs_sag_out>-result IS NOT INITIAL.
          IMPORT return = lt_sag_result FROM DATA BUFFER <fs_sag_out>-result.
        ENDIF.
      ENDIF.

      LOOP AT lt_sag_id ASSIGNING <fs_sag_id>.
        READ TABLE lt_sag_result ASSIGNING FIELD-SYMBOL(<fs_sag_res>)
            WITH KEY oc = <fs_sag_id>-oc.

        IF lv_exc_sag = abap_true OR sy-subrc IS NOT INITIAL.
          IF lv_exc_sag = abap_false.
            reported-zi_mm_moncomp = VALUE #( BASE reported-zi_mm_moncomp (
                                                     %cid = lv_cid
                                                     %msg = new_message_with_text(
                                                              severity = if_abap_behv_message=>severity-error
                                                              text     = |Sin respuesta al actualizar la OC { <fs_sag_id>-oc }.| ) ) ).
          ENDIF.
          LOOP AT <fs_sag_id>-t_pos ASSIGNING <fs_pos>.
            INSERT VALUE ty_ocpos( oc = <fs_sag_id>-oc posicion = <fs_pos>-posicion ) INTO TABLE lt_err.
          ENDLOOP.
          CONTINUE.
        ENDIF.

        CLEAR: lv_last_pos, lv_sag_ok.

        LOOP AT <fs_sag_id>-t_pos ASSIGNING <fs_pos>.
          "El resultado se evalua una vez por posicion
          IF <fs_pos>-posicion <> lv_last_pos.
            lv_last_pos = <fs_pos>-posicion.
            lv_row      = <fs_pos>-posicion.
            CLEAR: lv_err_txt, lv_pos_err, lv_has_s.

            LOOP AT <fs_sag_res>-bapiret ASSIGNING <fs_br>.
              IF <fs_br>-type = 'E' OR <fs_br>-type = 'A'.
                IF <fs_br>-row IS NOT INITIAL AND <fs_br>-row <> lv_row.
                  CONTINUE.
                ENDIF.
                IF lv_pos_err = abap_false.
                  lv_pos_err = abap_true.
                  lv_err_txt = <fs_br>-message.
                  IF lv_err_txt IS INITIAL.
                    lv_err_txt = |{ <fs_br>-id }/{ <fs_br>-number } { <fs_br>-message_v1 }|.
                  ENDIF.
                ENDIF.
              ELSEIF <fs_br>-type = 'S' AND <fs_br>-row = lv_row.
                lv_has_s = abap_true.
              ENDIF.
            ENDLOOP.

            lv_sag_ok = xsdbool( lv_pos_err = abap_false AND lv_has_s = abap_true ).

            IF lv_sag_ok = abap_false.
              IF lv_err_txt IS INITIAL.
                lv_err_txt = |Sin respuesta al actualizar la OC { <fs_sag_id>-oc }.|.
              ELSE.
                lv_err_txt = |OC { <fs_sag_id>-oc } posición { <fs_pos>-posicion }: { lv_err_txt }|.
              ENDIF.

              reported-zi_mm_moncomp = VALUE #( BASE reported-zi_mm_moncomp (
                                                       %cid = lv_cid
                                                       %msg = new_message_with_text(
                                                                severity = if_abap_behv_message=>severity-error
                                                                text     = lv_err_txt ) ) ).
              INSERT VALUE ty_ocpos( oc = <fs_sag_id>-oc posicion = <fs_pos>-posicion ) INTO TABLE lt_err.
            ENDIF.
          ENDIF.

          IF lv_sag_ok = abap_true.
            GET TIME STAMP FIELD lv_timestamp.

            APPEND VALUE #( client          = sy-mandt
                            oc              = <fs_sag_id>-oc
                            posicion        = <fs_pos>-posicion
                            vbeln           = <fs_pos>-vbeln
                            usuario         = cl_abap_context_info=>get_user_technical_name( )
                            fecha_hora      = lv_timestamp
                            precio_asn      = <fs_pos>-precioasn
                            moneda_asn      = <fs_pos>-monedaasn
                            accion          = '01'
                            estado          = '05'
                            precio_anterior = <fs_pos>-preciooc
                            precio_nuevo    = <fs_pos>-precioasn ) TO lcl_buffer=>gt_log.

            INSERT VALUE ty_ocpos( oc = <fs_sag_id>-oc posicion = <fs_pos>-posicion ) INTO TABLE lt_ok.
            CLEAR lv_timestamp.
          ENDIF.
        ENDLOOP.
      ENDLOOP.
    ENDIF.

    "Falla del paralelo sin ningun exito: no hay log que grabar
    IF ( lv_exc_po = abap_true OR lv_exc_sag = abap_true ) AND lt_ok IS INITIAL.
      failed-zi_mm_moncomp = VALUE #( BASE failed-zi_mm_moncomp (
                                             %cid        = lv_cid
                                             %fail-cause = if_abap_behv=>cause-unspecific ) ).
    ENDIF.

    lv_n = lines( lt_ok ).
    lv_m = lines( lt_err ).

    reported-zi_mm_moncomp = VALUE #( BASE reported-zi_mm_moncomp (
                                             %cid = lv_cid
                                             %msg = new_message_with_text(
                                                      severity = COND #( WHEN lv_m = 0
                                                                         THEN if_abap_behv_message=>severity-success
                                                                         ELSE if_abap_behv_message=>severity-error )
                                                      text     = |{ lv_n } posiciones actualizadas, { lv_m } con error.| ) ) ).
  ENDMETHOD.

ENDCLASS.

CLASS lsc_ZI_MM_MONCOMP DEFINITION INHERITING FROM cl_abap_behavior_saver_failed.
  PROTECTED SECTION.

    METHODS finalize REDEFINITION.

    METHODS check_before_save REDEFINITION.

    METHODS save REDEFINITION.

    METHODS cleanup REDEFINITION.

    METHODS cleanup_finalize REDEFINITION.

ENDCLASS.

CLASS lsc_ZI_MM_MONCOMP IMPLEMENTATION.

  METHOD finalize.
  ENDMETHOD.

  METHOD check_before_save.
  ENDMETHOD.

  METHOD save.
    IF lcl_buffer=>gt_log IS NOT INITIAL.
      INSERT zmm_moncomp_log FROM TABLE @lcl_buffer=>gt_log.

      IF sy-subrc IS INITIAL.
        reported-zi_mm_moncomp = VALUE #( ( %msg = new_message( id       = 'ZCL_MSG_MM_003'
                                                                number   = 013
                                                                severity = if_abap_behv_message=>severity-success ) ) ).
      ELSE.
        IF lcl_buffer=>gv_failed_action = 'PASO8'.
          failed-zi_mm_moncomp = VALUE #( ( %action-actualizarPrecioPaso8 = 1 ) ).
        ELSE.
          failed-zi_mm_moncomp = VALUE #( ( %action-uploadExcel = 1 ) ).
        ENDIF.
        reported-zi_mm_moncomp = VALUE #( ( %msg = new_message( id       = 'ZCL_MSG_MM_003'
                                                                number   = 014
                                                                severity = if_abap_behv_message=>severity-error ) ) ).
      ENDIF.
    ENDIF.
  ENDMETHOD.

  METHOD cleanup.
    CLEAR: lcl_buffer=>gt_log,
           lcl_buffer=>gt_sag,
           lcl_buffer=>gt_sag_id,
           lcl_buffer=>gv_failed_action.
  ENDMETHOD.

  METHOD cleanup_finalize.
  ENDMETHOD.

ENDCLASS.
