CLASS lcl_buffer DEFINITION CREATE PRIVATE.
  PUBLIC SECTION.
    TYPES: BEGIN OF ty_excel,
             Sociedad     TYPE bukrs,
             Centro       TYPE ewerk,
             Proveedor    TYPE md_supplier,
             oc           TYPE vdm_purchaseorder,
             pos          TYPE vdm_purchaseorderitem,
             Factura      TYPE c LENGTH 35,
             Material     TYPE matnr,
             Precio       TYPE c LENGTH 20,
             Moneda       TYPE waers,
             FechaFactura TYPE c LENGTH 10,
           END OF ty_excel,
           BEGIN OF ty_posicion,
             posicion  TYPE vdm_purchaseorderitem,
             vbeln     TYPE vbeln_vl,
             factura   TYPE lifex,
             precioOC  TYPE zmm_moncomp_log-precio_anterior,
             precioASN TYPE zmm_moncomp_log-precio_asn,
             monedaASN TYPE waers,
           END OF ty_posicion,
           BEGIN OF ty_id,
             oc    TYPE vdm_purchaseorder,
             t_pos TYPE STANDARD TABLE OF ty_posicion WITH DEFAULT KEY,
           END OF ty_id.

    CLASS-DATA gt_log    TYPE STANDARD TABLE OF zmm_moncomp_log.
    CLASS-DATA gv_failed_action TYPE c LENGTH 10.
    CLASS-DATA gt_sag    TYPE HASHED TABLE OF zcl_mm_wrapper_sag_change=>ty_param
                           WITH UNIQUE KEY iv_purchasingdocument.
    CLASS-DATA gt_sag_id TYPE STANDARD TABLE OF ty_id
                           WITH UNIQUE HASHED KEY id COMPONENTS oc.

    CLASS-METHODS bapi_text
      IMPORTING is_ret         TYPE bapiret2
      RETURNING VALUE(rv_text) TYPE string.
ENDCLASS.

CLASS lcl_buffer IMPLEMENTATION.
  METHOD bapi_text.
    DATA(lv_full) = |{ is_ret-message_v1 }{ is_ret-message_v2 }{ is_ret-message_v3 }{ is_ret-message_v4 }|.
    rv_text = is_ret-message.
    IF rv_text IS INITIAL.
      rv_text = condense( |{ is_ret-id }/{ is_ret-number } { lv_full }| ).
    ELSEIF is_ret-message_v2 IS NOT INITIAL
       AND ( rv_text = is_ret-message_v1 OR strlen( lv_full ) > strlen( rv_text ) ).
      rv_text = lv_full.
    ENDIF.
  ENDMETHOD.
ENDCLASS.

CLASS lcl_xlsx_cell DEFINITION.
  PUBLIC SECTION.
    TYPES: BEGIN OF ty_cell,
             row TYPE i,
             col TYPE i,
             val TYPE string,
           END OF ty_cell.
    TYPES tt_cell TYPE HASHED TABLE OF ty_cell WITH UNIQUE KEY row col.

    CLASS-METHODS grid_of
      IMPORTING iv_content     TYPE xstring
      RETURNING VALUE(rt_cell) TYPE tt_cell.

    CLASS-METHODS text_of
      IMPORTING iv_raw         TYPE string
                iv_column      TYPE i
      RETURNING VALUE(rv_text) TYPE string.
  PRIVATE SECTION.
    CONSTANTS: c_col_precio TYPE i VALUE 8,
               c_col_fecha  TYPE i VALUE 10.

    CLASS-METHODS zip_text
      IMPORTING io_zip         TYPE REF TO cl_abap_zip
                iv_name        TYPE string
      RETURNING VALUE(rv_xml)  TYPE string.

    CLASS-METHODS first_sheet
      IMPORTING io_zip         TYPE REF TO cl_abap_zip
      RETURNING VALUE(rv_name) TYPE string.

    CLASS-METHODS unescape
      IMPORTING iv_text        TYPE string
      RETURNING VALUE(rv_text) TYPE string.

    CLASS-METHODS attr_of
      IMPORTING iv_tag          TYPE string
                iv_name         TYPE string
      RETURNING VALUE(rv_value) TYPE string.

    CLASS-METHODS texts_of
      IMPORTING iv_xml         TYPE string
                iv_tag         TYPE string
      RETURNING VALUE(rv_text) TYPE string.

    CLASS-METHODS shared_strings
      IMPORTING iv_xml         TYPE string
      RETURNING VALUE(rt_text) TYPE string_table.

    CLASS-METHODS ref_parts
      IMPORTING iv_ref       TYPE string
      EXPORTING ev_col      TYPE i
                ev_row      TYPE i
                ev_ok       TYPE abap_bool.

    CLASS-METHODS cell_value
      IMPORTING iv_inner       TYPE string
                iv_type        TYPE string
                it_shared      TYPE string_table
      RETURNING VALUE(rv_text) TYPE string.

    CLASS-METHODS normalize
      IMPORTING iv_text        TYPE string
                iv_column      TYPE i
      RETURNING VALUE(rv_text) TYPE string.

    CLASS-METHODS from_number
      IMPORTING iv_number      TYPE decfloat34
                iv_column      TYPE i
      RETURNING VALUE(rv_text) TYPE string.

    CLASS-METHODS is_plain_number
      IMPORTING iv_text       TYPE string
      RETURNING VALUE(rv_yes) TYPE abap_bool.

    CLASS-METHODS plain_number
      IMPORTING iv_text        TYPE string
                iv_column      TYPE i
      RETURNING VALUE(rv_text) TYPE string.

    CLASS-METHODS serial_to_date
      IMPORTING iv_number      TYPE decfloat34
      RETURNING VALUE(rv_text) TYPE string.
ENDCLASS.

CLASS lcl_xlsx_cell IMPLEMENTATION.
  METHOD text_of.
    rv_text = normalize( iv_text = iv_raw iv_column = iv_column ).
  ENDMETHOD.

  METHOD grid_of.
    DATA lo_zip TYPE REF TO cl_abap_zip.
    DATA lv_sheet TYPE string.
    DATA lv_xml TYPE string.
    DATA lt_shared TYPE string_table.
    DATA lv_from TYPE i.
    DATA lv_at TYPE i.
    DATA lv_gt TYPE i.
    DATA lv_end TYPE i.
    DATA lv_tag TYPE string.
    DATA lv_inner TYPE string.
    DATA lv_type TYPE string.
    DATA lv_ref TYPE string.
    DATA lv_col TYPE i.
    DATA lv_row TYPE i.
    DATA lv_ok TYPE abap_bool.
    DATA lv_val TYPE string.
    DATA lv_len TYPE i.
    DATA lv_off TYPE i.
    DATA lv_sub TYPE i.

    CREATE OBJECT lo_zip.
    lo_zip->load( EXPORTING zip = iv_content
                  EXCEPTIONS zip_parse_error = 1
                             others          = 2 ).
    IF sy-subrc <> 0.
      RETURN.
    ENDIF.

    lv_xml = zip_text( io_zip = lo_zip iv_name = `xl/sharedStrings.xml` ).
    lt_shared = shared_strings( lv_xml ).
    lv_sheet = first_sheet( lo_zip ).
    lv_xml = zip_text( io_zip = lo_zip iv_name = lv_sheet ).
    lv_len = strlen( lv_xml ).

    WHILE lv_from < lv_len.
      lv_at = find( val = lv_xml sub = `<c ` off = lv_from ).
      IF lv_at < 0.
        EXIT.
      ENDIF.
      lv_gt = find( val = lv_xml sub = `>` off = lv_at ).
      IF lv_gt < 0.
        EXIT.
      ENDIF.
      lv_sub = lv_gt - lv_at + 1.
      lv_tag = lv_xml+lv_at(lv_sub).
      lv_ref = attr_of( iv_tag = lv_tag iv_name = `r` ).
      lv_type = attr_of( iv_tag = lv_tag iv_name = `t` ).
      lv_type = to_lower( lv_type ).
      CLEAR lv_inner.
      lv_off = lv_gt - 1.
      IF lv_gt > lv_at AND lv_xml+lv_off(1) = `/`.
        lv_from = lv_gt + 1.
      ELSE.
        lv_end = find( val = lv_xml sub = `</c>` off = lv_gt ).
        IF lv_end < 0.
          EXIT.
        ENDIF.
        lv_off = lv_gt + 1.
        lv_sub = lv_end - lv_off.
        IF lv_sub > 0.
          lv_inner = lv_xml+lv_off(lv_sub).
        ENDIF.
        lv_from = lv_end + 4.
      ENDIF.

      ref_parts( EXPORTING iv_ref = lv_ref
                 IMPORTING ev_col = lv_col
                           ev_row = lv_row
                           ev_ok  = lv_ok ).
      IF lv_ok = abap_false OR lv_col < 1 OR lv_col > 10 OR lv_row < 2 OR lv_row > 5000.
        CONTINUE.
      ENDIF.

      lv_val = cell_value( iv_inner  = lv_inner
                           iv_type   = lv_type
                           it_shared = lt_shared ).
      IF lv_val IS INITIAL.
        CONTINUE.
      ENDIF.
      INSERT VALUE #( row = lv_row col = lv_col val = lv_val ) INTO TABLE rt_cell.
    ENDWHILE.
  ENDMETHOD.

  METHOD zip_text.
    DATA lv_want TYPE string.
    DATA lv_have TYPE string.
    DATA lv_bs TYPE c LENGTH 1 VALUE '\'.
    DATA lv_x TYPE xstring.
    DATA lv_off TYPE i.

    lv_want = to_lower( iv_name ).
    LOOP AT io_zip->files INTO DATA(ls_zip).
      lv_have = ls_zip-name.
      REPLACE ALL OCCURRENCES OF lv_bs IN lv_have WITH `/`.
      IF lv_have IS NOT INITIAL AND lv_have+0(1) = `/`.
        lv_off = 1.
        lv_have = lv_have+lv_off.
      ENDIF.
      IF to_lower( lv_have ) <> lv_want.
        CONTINUE.
      ENDIF.
      CLEAR lv_x.
      io_zip->get( EXPORTING name    = ls_zip-name
                   IMPORTING content = lv_x
                   EXCEPTIONS zip_index_error = 1
                              others          = 2 ).
      IF sy-subrc <> 0.
        CONTINUE.
      ENDIF.
      IF lv_x IS NOT INITIAL.
        rv_xml = cl_abap_conv_codepage=>create_in( )->convert( lv_x ).
      ENDIF.
      RETURN.
    ENDLOOP.
  ENDMETHOD.

  METHOD first_sheet.
    DATA lv_book TYPE string.
    DATA lv_rels TYPE string.
    DATA lv_rid TYPE string.
    DATA lv_tag TYPE string.
    DATA lv_target TYPE string.
    DATA lv_from TYPE i.
    DATA lv_at TYPE i.
    DATA lv_gt TYPE i.
    DATA lv_len TYPE i.
    DATA lv_off TYPE i.
    DATA lv_sub TYPE i.

    rv_name = `xl/worksheets/sheet1.xml`.
    lv_book = zip_text( io_zip = io_zip iv_name = `xl/workbook.xml` ).
    lv_rels = zip_text( io_zip = io_zip iv_name = `xl/_rels/workbook.xml.rels` ).
    IF lv_book IS INITIAL OR lv_rels IS INITIAL.
      RETURN.
    ENDIF.

    lv_at = find( val = lv_book sub = `<sheet ` ).
    IF lv_at < 0.
      RETURN.
    ENDIF.
    lv_gt = find( val = lv_book sub = `>` off = lv_at ).
    IF lv_gt < 0.
      RETURN.
    ENDIF.
    lv_sub = lv_gt - lv_at + 1.
    lv_tag = lv_book+lv_at(lv_sub).
    lv_rid = attr_of( iv_tag = lv_tag iv_name = `r:id` ).
    IF lv_rid IS INITIAL.
      RETURN.
    ENDIF.

    lv_len = strlen( lv_rels ).
    WHILE lv_from < lv_len.
      lv_at = find( val = lv_rels sub = `<Relationship` off = lv_from ).
      IF lv_at < 0.
        EXIT.
      ENDIF.
      lv_gt = find( val = lv_rels sub = `>` off = lv_at ).
      IF lv_gt < 0.
        EXIT.
      ENDIF.
      lv_sub = lv_gt - lv_at + 1.
      lv_tag = lv_rels+lv_at(lv_sub).
      IF attr_of( iv_tag = lv_tag iv_name = `Id` ) = lv_rid.
        lv_target = attr_of( iv_tag = lv_tag iv_name = `Target` ).
        EXIT.
      ENDIF.
      lv_from = lv_gt + 1.
    ENDWHILE.

    IF lv_target IS INITIAL.
      RETURN.
    ENDIF.
    IF lv_target+0(1) = `/`.
      lv_off = 1.
      lv_target = lv_target+lv_off.
    ENDIF.
    IF find( val = to_lower( lv_target ) sub = `xl/` ) <> 0.
      lv_target = |xl/{ lv_target }|.
    ENDIF.
    rv_name = lv_target.
  ENDMETHOD.

  METHOD unescape.
    DATA lv TYPE string.
    DATA lv_nl TYPE string.

    lv_nl = cl_abap_char_utilities=>newline.
    lv = iv_text.
    lv = replace( val = lv sub = `&lt;`   with = `<` occ = 0 ).
    lv = replace( val = lv sub = `&gt;`   with = `>` occ = 0 ).
    lv = replace( val = lv sub = `&quot;` with = `"` occ = 0 ).
    lv = replace( val = lv sub = `&apos;` with = `'` occ = 0 ).
    lv = replace( val = lv sub = `&#10;`  with = lv_nl occ = 0 ).
    lv = replace( val = lv sub = `&#xA;`  with = lv_nl occ = 0 ).
    lv = replace( val = lv sub = `&#xa;`  with = lv_nl occ = 0 ).
    lv = replace( val = lv sub = `&#13;`  with = `` occ = 0 ).
    lv = replace( val = lv sub = `&#xD;`  with = `` occ = 0 ).
    lv = replace( val = lv sub = `&#xd;`  with = `` occ = 0 ).
    lv = replace( val = lv sub = `_x000D_` with = `` occ = 0 ).
    lv = replace( val = lv sub = `_x000A_` with = lv_nl occ = 0 ).
    lv = replace( val = lv sub = `&amp;`  with = `&` occ = 0 ).
    rv_text = lv.
  ENDMETHOD.

  METHOD attr_of.
    DATA lv_key TYPE string.
    DATA lv_at TYPE i.
    DATA lv_q TYPE i.
    DATA lv_start TYPE i.
    DATA lv_sub TYPE i.
    DATA lv_raw TYPE string.

    lv_key = |{ iv_name }="|.
    lv_at = find( val = iv_tag sub = lv_key ).
    IF lv_at < 0.
      RETURN.
    ENDIF.
    lv_start = lv_at + strlen( lv_key ).
    lv_q = find( val = iv_tag sub = `"` off = lv_start ).
    IF lv_q < 0.
      RETURN.
    ENDIF.
    lv_sub = lv_q - lv_start.
    lv_raw = iv_tag+lv_start(lv_sub).
    rv_value = unescape( lv_raw ).
  ENDMETHOD.

  METHOD texts_of.
    DATA lv_from TYPE i.
    DATA lv_len TYPE i.
    DATA lv_at TYPE i.
    DATA lv_gt TYPE i.
    DATA lv_end TYPE i.
    DATA lv_open TYPE string.
    DATA lv_close TYPE string.
    DATA lv_nch TYPE c LENGTH 1.
    DATA lv_piece TYPE string.
    DATA lv_off TYPE i.
    DATA lv_sub TYPE i.

    lv_open = |<{ iv_tag }|.
    lv_close = |</{ iv_tag }>|.
    lv_len = strlen( iv_xml ).
    WHILE lv_from < lv_len.
      lv_at = find( val = iv_xml sub = lv_open off = lv_from ).
      IF lv_at < 0.
        EXIT.
      ENDIF.
      IF lv_at + strlen( lv_open ) >= lv_len.
        EXIT.
      ENDIF.
      lv_end = lv_at + strlen( lv_open ).
      lv_nch = iv_xml+lv_end(1).
      IF lv_nch <> `>` AND lv_nch <> `/` AND lv_nch <> ` `.
        lv_from = lv_at + strlen( lv_open ).
        CONTINUE.
      ENDIF.
      lv_gt = find( val = iv_xml sub = `>` off = lv_at ).
      IF lv_gt < 0.
        EXIT.
      ENDIF.
      lv_off = lv_gt - 1.
      IF lv_gt > lv_at AND iv_xml+lv_off(1) = `/`.
        lv_from = lv_gt + 1.
        CONTINUE.
      ENDIF.
      lv_end = find( val = iv_xml sub = lv_close off = lv_gt ).
      IF lv_end < 0.
        EXIT.
      ENDIF.
      lv_off = lv_gt + 1.
      lv_sub = lv_end - lv_off.
      IF lv_sub > 0.
        lv_piece = iv_xml+lv_off(lv_sub).
      ELSE.
        CLEAR lv_piece.
      ENDIF.
      lv_piece = unescape( lv_piece ).
      rv_text = |{ rv_text }{ lv_piece }|.
      lv_from = lv_end + strlen( lv_close ).
    ENDWHILE.
  ENDMETHOD.

  METHOD shared_strings.
    DATA lv_from TYPE i.
    DATA lv_len TYPE i.
    DATA lv_at TYPE i.
    DATA lv_end TYPE i.
    DATA lv_nch TYPE c LENGTH 1.
    DATA lv_inner TYPE string.
    DATA lv_sub TYPE i.

    lv_len = strlen( iv_xml ).
    WHILE lv_from < lv_len.
      lv_at = find( val = iv_xml sub = `<si` off = lv_from ).
      IF lv_at < 0.
        EXIT.
      ENDIF.
      IF lv_at + 3 >= lv_len.
        EXIT.
      ENDIF.
      lv_end = lv_at + 3.
      lv_nch = iv_xml+lv_end(1).
      IF lv_nch <> `>` AND lv_nch <> ` `.
        lv_from = lv_at + 3.
        CONTINUE.
      ENDIF.
      lv_end = find( val = iv_xml sub = `</si>` off = lv_at ).
      IF lv_end < 0.
        EXIT.
      ENDIF.
      lv_sub = lv_end - lv_at.
      lv_inner = iv_xml+lv_at(lv_sub).
      APPEND texts_of( iv_xml = lv_inner iv_tag = `t` ) TO rt_text.
      lv_from = lv_end + 5.
    ENDWHILE.
  ENDMETHOD.

  METHOD ref_parts.
    DATA lv_len TYPE i.
    DATA lv_i TYPE i.
    DATA lv_j TYPE i.
    DATA lv_n TYPE i.
    DATA lv_off TYPE i.
    DATA lv_llen TYPE i.
    DATA lv_ch TYPE c LENGTH 1.
    DATA lv_letters TYPE string.
    DATA lv_digits TYPE string.
    CONSTANTS lc_abc TYPE string VALUE `ABCDEFGHIJKLMNOPQRSTUVWXYZ`.

    CLEAR: ev_col, ev_row, ev_ok.
    lv_len = strlen( iv_ref ).
    WHILE lv_i < lv_len.
      lv_ch = to_upper( iv_ref+lv_i(1) ).
      IF lv_ch >= `A` AND lv_ch <= `Z`.
        lv_letters = |{ lv_letters }{ lv_ch }|.
      ELSE.
        EXIT.
      ENDIF.
      lv_i = lv_i + 1.
    ENDWHILE.
    IF lv_letters IS INITIAL OR lv_i >= lv_len.
      RETURN.
    ENDIF.
    lv_digits = iv_ref+lv_i.
    lv_llen = strlen( lv_letters ).
    WHILE lv_j < lv_llen.
      lv_ch = lv_letters+lv_j(1).
      lv_off = find( val = lc_abc sub = lv_ch ).
      IF lv_off < 0.
        RETURN.
      ENDIF.
      lv_n = lv_n * 26 + lv_off + 1.
      lv_j = lv_j + 1.
    ENDWHILE.
    TRY.
        ev_row = lv_digits.
      CATCH cx_sy_conversion_error cx_root.
        RETURN.
    ENDTRY.
    ev_col = lv_n.
    ev_ok = abap_true.
  ENDMETHOD.

  METHOD cell_value.
    DATA lv_v TYPE string.
    DATA lv_idx TYPE i.
    DATA lv_len TYPE i.

    lv_v = condense( val = texts_of( iv_xml = iv_inner iv_tag = `v` ) ).
    IF iv_type = `s`.
      IF lv_v IS INITIAL.
        RETURN.
      ENDIF.
      TRY.
          lv_idx = lv_v.
        CATCH cx_sy_conversion_error cx_root.
          RETURN.
      ENDTRY.
      IF lv_idx < 0.
        RETURN.
      ENDIF.
      READ TABLE it_shared INTO rv_text INDEX lv_idx + 1.
      IF sy-subrc <> 0.
        CLEAR rv_text.
      ENDIF.
      RETURN.
    ENDIF.

    IF iv_type = `b`.
      IF lv_v = `1`.
        rv_text = `X`.
      ENDIF.
      RETURN.
    ENDIF.

    IF iv_type = `inlinestr`.
      rv_text = texts_of( iv_xml = iv_inner iv_tag = `t` ).
      RETURN.
    ENDIF.

    IF iv_type = `e`.
      RETURN.
    ENDIF.

    IF iv_type = `d`.
      lv_len = strlen( lv_v ).
      IF lv_len >= 10 AND lv_v+4(1) = `-`.
        rv_text = lv_v+0(10).
        RETURN.
      ENDIF.
    ENDIF.

    rv_text = lv_v.
  ENDMETHOD.

  METHOD normalize.

    DATA(lv_text) = condense( val = iv_text ).
    IF lv_text IS INITIAL.
      RETURN.
    ENDIF.

    IF iv_column = c_col_fecha.
      DATA(lv_len) = strlen( lv_text ).
      IF lv_len = 8 OR lv_len = 10.
        rv_text = lv_text.
        RETURN.
      ENDIF.
    ENDIF.

    IF is_plain_number( lv_text ) = abap_false.
      rv_text = lv_text.
      RETURN.
    ENDIF.

    IF iv_column = c_col_fecha.
      DATA lv_serial TYPE decfloat34.
      TRY.
          lv_serial = lv_text.
          rv_text = serial_to_date( lv_serial ).
        CATCH cx_sy_conversion_error cx_root.
          rv_text = lv_text.
      ENDTRY.
      RETURN.
    ENDIF.

    rv_text = plain_number( iv_text = lv_text iv_column = iv_column ).
  ENDMETHOD.

  METHOD from_number.
    IF iv_column = c_col_fecha.
      TRY.
          DATA(lv_digits) = CONV i( trunc( abs( iv_number ) ) ).
          IF lv_digits >= 10000000.
            rv_text = |{ CONV int8( trunc( iv_number ) ) }|.
          ELSE.
            rv_text = serial_to_date( iv_number ).
          ENDIF.
        CATCH cx_sy_conversion_error cx_sy_arithmetic_error cx_root.
          rv_text = condense( val = |{ iv_number STYLE = SIMPLE }| ).
      ENDTRY.
      RETURN.
    ENDIF.

    IF iv_column = c_col_precio OR iv_number <> trunc( iv_number ).
      rv_text = condense( val = |{ iv_number STYLE = SIMPLE }| ).
      RETURN.
    ENDIF.

    TRY.
        rv_text = |{ CONV int8( trunc( iv_number ) ) }|.
      CATCH cx_sy_conversion_error cx_root.
        rv_text = condense( val = |{ iv_number STYLE = SIMPLE }| ).
    ENDTRY.
  ENDMETHOD.

  METHOD is_plain_number.
    DATA(lv_text) = condense( val = iv_text ).
    DATA(lv_len) = strlen( lv_text ).
    IF lv_len = 0.
      RETURN.
    ENDIF.

    DATA(lv_off) = 0.
    IF lv_text+0(1) = '-' OR lv_text+0(1) = '+'.
      lv_off = 1.
    ENDIF.
    IF lv_off >= lv_len.
      RETURN.
    ENDIF.

    DATA(lv_body) = lv_text+lv_off.
    DATA(lv_exp) = ``.
    DATA(lv_e) = find( val = to_upper( lv_body ) sub = 'E' ).
    IF lv_e = 0.
      RETURN.
    ELSEIF lv_e > 0.
      lv_exp = lv_body+lv_e.
      lv_body = lv_body(lv_e).
    ENDIF.

    IF lv_body IS INITIAL.
      RETURN.
    ENDIF.
    IF strlen( lv_body ) > 1 AND lv_body+0(1) = '0' AND lv_body+1(1) <> '.'.
      RETURN.
    ENDIF.

    DATA: lv_dot   TYPE i,
          lv_digit TYPE abap_bool,
          lv_i     TYPE i.
    DATA(lv_blen) = strlen( lv_body ).
    WHILE lv_i < lv_blen.
      DATA(lv_ch) = lv_body+lv_i(1).
      IF lv_ch = '.'.
        lv_dot = lv_dot + 1.
        IF lv_dot > 1.
          RETURN.
        ENDIF.
      ELSEIF lv_ch >= '0' AND lv_ch <= '9'.
        lv_digit = abap_true.
      ELSE.
        RETURN.
      ENDIF.
      lv_i = lv_i + 1.
    ENDWHILE.

    IF lv_digit = abap_false.
      RETURN.
    ENDIF.

    IF lv_exp IS NOT INITIAL.
      DATA(lv_elen) = strlen( lv_exp ).
      DATA(lv_eoff) = 1.
      IF lv_elen < 2.
        RETURN.
      ENDIF.
      IF lv_exp+1(1) = '+' OR lv_exp+1(1) = '-'.
        lv_eoff = 2.
      ENDIF.
      IF lv_eoff >= lv_elen.
        RETURN.
      ENDIF.
      lv_digit = abap_false.
      lv_i = lv_eoff.
      WHILE lv_i < lv_elen.
        lv_ch = lv_exp+lv_i(1).
        IF lv_ch < '0' OR lv_ch > '9'.
          RETURN.
        ENDIF.
        lv_digit = abap_true.
        lv_i = lv_i + 1.
      ENDWHILE.
      IF lv_digit = abap_false.
        RETURN.
      ENDIF.
    ENDIF.

    rv_yes = abap_true.
  ENDMETHOD.

  METHOD plain_number.
    DATA lv_num TYPE decfloat34.
    TRY.
        lv_num = iv_text.
      CATCH cx_sy_conversion_error cx_root.
        rv_text = iv_text.
        RETURN.
    ENDTRY.
    rv_text = from_number( iv_number = lv_num iv_column = iv_column ).
  ENDMETHOD.

  METHOD serial_to_date.
    TRY.
        DATA(lv_days) = CONV i( trunc( iv_number ) ).
        DATA(lv_date) = CONV d( '18991230' ).
        lv_date = lv_date + lv_days.
        rv_text = lv_date.
      CATCH cx_sy_conversion_error cx_sy_arithmetic_error cx_root.
        rv_text = condense( val = |{ iv_number STYLE = SIMPLE }| ).
    ENDTRY.
  ENDMETHOD.
ENDCLASS.

