"Pacote ZGAP_MM_003_T2, linguagem Standard ABAP; liberar contrato C1 (Use in Cloud Development).
CLASS zcl_mm_wrapper_nfm_orderpos DEFINITION
  PUBLIC
  FINAL
  CREATE PUBLIC.

  PUBLIC SECTION.
    TYPES: BEGIN OF ty_rate,
             blt      TYPE zi_mm_wrapper_torderpos-DocumentCategory,
             belnr    TYPE zi_mm_wrapper_torderpos-DocumentNumber,
             posnr    TYPE zi_mm_wrapper_torderpos-DocumentItem,
             bukrs    TYPE zi_mm_wrapper_torderpos-CompanyCode,
             gjahr    TYPE zi_mm_wrapper_torderpos-FiscalYear,
             nes      TYPE zi_mm_wrapper_torderpos-NfmKey,
             kta      TYPE zi_mm_wrapper_torderpos-ActualRateDate,
             ndt      TYPE zi_mm_wrapper_torderpos-RateDeterminationDate,
             nmo      TYPE zi_mm_wrapper_torderpos-RateMonth,
             nku      TYPE zi_mm_wrapper_oicqp-Price,
             nno      TYPE zi_mm_wrapper_oicqp-Price,
             nkn      TYPE zi_mm_wrapper_oicqp-Price,
             upd_kta  TYPE abap_bool,
           END OF ty_rate.

    CLASS-METHODS update_rates
      IMPORTING is_rate           TYPE ty_rate
      RETURNING VALUE(rv_updated) TYPE abap_bool.
  PROTECTED SECTION.
  PRIVATE SECTION.
ENDCLASS.

CLASS zcl_mm_wrapper_nfm_orderpos IMPLEMENTATION.
  METHOD update_rates.
    IF is_rate-upd_kta = abap_true.
      UPDATE /nfm/torderpos
        SET kta = @is_rate-kta,
            ndt = @is_rate-ndt,
            nku = @is_rate-nku,
            nno = @is_rate-nno,
            nkn = @is_rate-nkn
        WHERE blt   = @is_rate-blt
          AND belnr = @is_rate-belnr
          AND posnr = @is_rate-posnr
          AND bukrs = @is_rate-bukrs
          AND gjahr = @is_rate-gjahr
          AND nes   = @is_rate-nes.
    ELSE.
      UPDATE /nfm/torderpos
        SET nmo = @is_rate-nmo,
            ndt = @is_rate-ndt,
            nku = @is_rate-nku,
            nno = @is_rate-nno,
            nkn = @is_rate-nkn
        WHERE blt   = @is_rate-blt
          AND belnr = @is_rate-belnr
          AND posnr = @is_rate-posnr
          AND bukrs = @is_rate-bukrs
          AND gjahr = @is_rate-gjahr
          AND nes   = @is_rate-nes.
    ENDIF.
    rv_updated = xsdbool( sy-subrc = 0 ).
  ENDMETHOD.
ENDCLASS.
