CLASS zcl_mm_wrapper_sag_change DEFINITION
  PUBLIC
  FINAL
  CREATE PUBLIC.

  PUBLIC SECTION.
    TYPES: BEGIN OF ty_item,
             item         TYPE ebelp,
             price        TYPE bapicurext,
             currency     TYPE waers,
             unit         TYPE meins,
             price_unit   TYPE epein,
             invoice_date TYPE dats,
           END OF ty_item,
           tt_item TYPE SORTED TABLE OF ty_item WITH UNIQUE KEY item,
           BEGIN OF ty_param,
             iv_purchasingdocument TYPE ebeln,
             iv_nfm                TYPE abap_bool,
             t_item                TYPE tt_item,
           END OF ty_param,
           tt_return TYPE STANDARD TABLE OF bapiret2 WITH DEFAULT KEY.

    CLASS-METHODS call_bapi_change
      IMPORTING is_param         TYPE ty_param
      RETURNING VALUE(rt_return) TYPE tt_return.
  PROTECTED SECTION.
  PRIVATE SECTION.
    TYPES: tt_sched TYPE SORTED TABLE OF bapimeoutschedule
                    WITH NON-UNIQUE KEY item_no,
           tt_validity TYPE SORTED TABLE OF bapimeoutvalidity
                       WITH NON-UNIQUE KEY item_no valid_from,
           tt_cond     TYPE SORTED TABLE OF bapimeoutcondition
                       WITH NON-UNIQUE KEY item_no serial_id cond_type.

    CLASS-METHODS last_day_of_month
      IMPORTING iv_date        TYPE dats
      RETURNING VALUE(rv_date) TYPE dats.

    CLASS-METHODS append_exc
      IMPORTING io_exc           TYPE REF TO cx_root
      RETURNING VALUE(rs_return) TYPE bapiret2.

    CLASS-METHODS get_gross_condition
      IMPORTING it_cond        TYPE tt_cond
                iv_item        TYPE ebelp
                iv_serial_id   TYPE bapimeoutcondition-serial_id
      RETURNING VALUE(rs_cond) TYPE bapimeoutcondition.

    CLASS-METHODS change_nfm_schedule
      IMPORTING is_param         TYPE ty_param
      RETURNING VALUE(rt_return) TYPE tt_return.
ENDCLASS.

CLASS zcl_mm_wrapper_sag_change IMPLEMENTATION.
  METHOD append_exc.
    DATA(lv_text) = io_exc->get_text( ).
    rs_return-type       = 'E'.
    rs_return-id         = 'ZCL_MSG_MM_003'.
    rs_return-number     = '016'.
    rs_return-message    = lv_text.
    rs_return-message_v1 = lv_text.
  ENDMETHOD.

  METHOD last_day_of_month.
    DATA(lv_first) = iv_date.
    lv_first+6(2) = '01'.
    lv_first = lv_first + 32.
    lv_first+6(2) = '01'.
    rv_date = lv_first - 1.
  ENDMETHOD.

  METHOD get_gross_condition.
    DATA lv_ebelp TYPE ebelp.

    "Help SAP: misma clase de condicion del plan (PB00 o PBXX). PB00 primero.
    LOOP AT it_cond ASSIGNING FIELD-SYMBOL(<fs_cond>) USING KEY primary_key.
      lv_ebelp = <fs_cond>-item_no.
      IF lv_ebelp <> iv_item OR <fs_cond>-serial_id <> iv_serial_id.
        CONTINUE.
      ENDIF.
      IF <fs_cond>-cond_type = 'PB00' AND <fs_cond>-cond_value IS NOT INITIAL.
        rs_cond = <fs_cond>.
        RETURN.
      ENDIF.
    ENDLOOP.

    LOOP AT it_cond ASSIGNING <fs_cond> USING KEY primary_key.
      lv_ebelp = <fs_cond>-item_no.
      IF lv_ebelp <> iv_item OR <fs_cond>-serial_id <> iv_serial_id.
        CONTINUE.
      ENDIF.
      IF <fs_cond>-cond_type = 'PBXX' AND <fs_cond>-cond_value IS NOT INITIAL.
        rs_cond = <fs_cond>.
        RETURN.
      ENDIF.
    ENDLOOP.

    LOOP AT it_cond ASSIGNING <fs_cond> USING KEY primary_key.
      lv_ebelp = <fs_cond>-item_no.
      IF lv_ebelp <> iv_item OR <fs_cond>-cond_type <> 'PB00'.
        CONTINUE.
      ENDIF.
      IF <fs_cond>-cond_value IS NOT INITIAL.
        rs_cond = <fs_cond>.
        RETURN.
      ENDIF.
    ENDLOOP.

    LOOP AT it_cond ASSIGNING <fs_cond> USING KEY primary_key.
      lv_ebelp = <fs_cond>-item_no.
      IF lv_ebelp <> iv_item OR <fs_cond>-cond_type <> 'PBXX'.
        CONTINUE.
      ENDIF.
      IF <fs_cond>-cond_value IS NOT INITIAL.
        rs_cond = <fs_cond>.
        RETURN.
      ENDIF.
    ENDLOOP.
  ENDMETHOD.

  METHOD call_bapi_change.
    DATA: lt_return_get TYPE tt_return,
          lt_val        TYPE STANDARD TABLE OF bapimeoutvalidity,
          lt_cond       TYPE STANDARD TABLE OF bapimeoutcondition,
          lt_val_k      TYPE tt_validity,
          lt_cond_k     TYPE tt_cond,
          lt_val_ch     TYPE STANDARD TABLE OF bapimeoutvalidity,
          lt_valx_ch    TYPE STANDARD TABLE OF bapimeoutvalidityx,
          lt_cond_ch    TYPE STANDARD TABLE OF bapimeoutcondition,
          lt_condx_ch   TYPE STANDARD TABLE OF bapimeoutconditionx,
          ls_current    TYPE bapimeoutvalidity,
          ls_new_val    TYPE bapimeoutvalidity,
          ls_cond       TYPE bapimeoutcondition,
          lv_invoice    TYPE dats,
          lv_prev       TYPE dats,
          lv_valid_to   TYPE dats,
          lv_next_from  TYPE dats,
          lv_before     TYPE dats,
          lv_gd_err     TYPE abap_bool,
          lv_serial     TYPE bapimeoutvalidity-serial_id,
          lv_row        TYPE bapiret2-row,
          lv_ebelp      TYPE ebelp,
          lv_after      TYPE dats,
          lv_new_from   TYPE dats,
          lv_new_prev   TYPE dats,
          lv_orig_to    TYPE dats,
          lv_price_to   TYPE dats,
          lv_tail_from  TYPE dats,
          lv_chg_to     TYPE abap_bool,
          lv_serial_tail TYPE bapimeoutvalidity-serial_id,
          ls_cond_old   TYPE bapimeoutcondition,
          lv_bapi_err   TYPE abap_bool,
          ls_left       TYPE bapimeoutvalidity,
          lt_bapi_ret   TYPE tt_return,
          lt_item_err   TYPE tt_return,
          lx_ch         TYPE REF TO cx_root.

    IF is_param-iv_nfm = abap_true.
      rt_return = change_nfm_schedule( is_param ).
      RETURN.
    ENDIF.

    TRY.
        CALL FUNCTION 'BAPI_SAG_GETDETAIL'
          EXPORTING
            purchasingdocument = is_param-iv_purchasingdocument
            item_data          = abap_true
            condition_data     = abap_true
          TABLES
            return             = lt_return_get
            item_cond_validity = lt_val
            item_condition     = lt_cond.
      CATCH cx_root INTO DATA(lx_gd).
        APPEND append_exc( lx_gd ) TO rt_return.
        RETURN.
    ENDTRY.

    CLEAR lv_gd_err.
    LOOP AT lt_return_get ASSIGNING FIELD-SYMBOL(<fs_get>).
      IF <fs_get>-type = 'E' OR <fs_get>-type = 'A'.
        APPEND <fs_get> TO rt_return.
        lv_gd_err = abap_true.
      ENDIF.
    ENDLOOP.
    IF lv_gd_err = abap_true.
      RETURN.
    ENDIF.

    lt_val_k  = lt_val.
    lt_cond_k = lt_cond.

    LOOP AT is_param-t_item ASSIGNING FIELD-SYMBOL(<fs_item>).
      CLEAR: ls_current, ls_new_val, ls_cond, ls_left, lv_next_from, lv_before, lv_serial, lv_after,
             lv_new_from, lv_new_prev, lv_orig_to, lv_price_to, lv_tail_from, lv_chg_to,
             lv_serial_tail, ls_cond_old,
             lv_bapi_err, lt_val_ch, lt_valx_ch, lt_cond_ch, lt_condx_ch, lt_bapi_ret.
      lv_invoice = <fs_item>-invoice_date.
      lv_row     = <fs_item>-item.

      IF lv_invoice IS INITIAL.
        APPEND VALUE #( type       = 'E'
                        id         = 'ZCL_MSG_MM_003'
                        number     = '030'
                        message_v1 = is_param-iv_purchasingdocument
                        message_v2 = <fs_item>-item
                        row        = lv_row ) TO rt_return.
        RETURN.
      ENDIF.

      lv_prev     = lv_invoice.
      lv_prev     = lv_prev - 1.
      lv_valid_to = last_day_of_month( lv_invoice ).
      lv_valid_to = lv_valid_to - 1.
      IF lv_valid_to < lv_invoice.
        lv_valid_to = last_day_of_month( lv_invoice ).
      ENDIF.

      LOOP AT lt_val_k ASSIGNING FIELD-SYMBOL(<fs_nxt>) USING KEY primary_key.
        lv_ebelp = <fs_nxt>-item_no.
        IF lv_ebelp <> <fs_item>-item.
          CONTINUE.
        ENDIF.
        IF <fs_nxt>-valid_from > lv_invoice
           AND ( lv_next_from IS INITIAL OR <fs_nxt>-valid_from < lv_next_from ).
          lv_next_from = <fs_nxt>-valid_from.
        ENDIF.
      ENDLOOP.

      IF lv_next_from IS NOT INITIAL.
        lv_before = lv_next_from.
        lv_before = lv_before - 1.
        IF lv_before < lv_valid_to.
          lv_valid_to = lv_before.
        ENDIF.
      ENDIF.

      LOOP AT lt_val_k ASSIGNING FIELD-SYMBOL(<fs_val>) USING KEY primary_key.
        lv_ebelp = <fs_val>-item_no.
        IF lv_ebelp <> <fs_item>-item.
          CONTINUE.
        ENDIF.
        IF <fs_val>-valid_from <= lv_invoice AND <fs_val>-valid_to >= lv_invoice.
          ls_current = <fs_val>.
          EXIT.
        ENDIF.
      ENDLOOP.

      IF ls_current IS INITIAL.
        LOOP AT lt_val_k ASSIGNING <fs_val> USING KEY primary_key.
          lv_ebelp = <fs_val>-item_no.
          IF lv_ebelp = <fs_item>-item.
            ls_current = <fs_val>.
          ENDIF.
        ENDLOOP.
      ENDIF.

      IF ls_current IS INITIAL.
        APPEND VALUE #( type       = 'E'
                        id         = 'ZCL_MSG_MM_003'
                        number     = '027'
                        message_v1 = is_param-iv_purchasingdocument
                        message_v2 = <fs_item>-item
                        row        = lv_row ) TO lt_item_err.
        CONTINUE.
      ENDIF.

      ls_cond = get_gross_condition( it_cond      = lt_cond_k
                                     iv_item      = <fs_item>-item
                                     iv_serial_id = ls_current-serial_id ).

      IF ls_cond IS INITIAL.
        APPEND VALUE #( type       = 'E'
                        id         = 'ZCL_MSG_MM_003'
                        number     = '026'
                        message_v1 = is_param-iv_purchasingdocument
                        message_v2 = <fs_item>-item
                        row        = lv_row ) TO lt_item_err.
        CONTINUE.
      ENDIF.

      "SERIAL_ID temporario por posicion. MAX+1 reusaba un KNUMH de la otra posicion.
      "99998 fica para o rabo, para nao repetir a serial do periodo novo na mesma chamada.
      lv_serial      = |99999{ <fs_item>-item }|.
      lv_serial_tail = |99998{ <fs_item>-item }|.

      "Guillermo: precio nuevo desde FechaFactura hasta el dia anterior al siguiente (30.10).
      "CL_API_MASTER_CONDITION_MM=>PROCESS (ME 816 + 06 170): rejeita KONH novo com
      "KDATB < sy-datum e rejeita alterar VALID_FROM de uma serial existente.
      ls_cond_old = ls_cond.
      lv_orig_to  = ls_current-valid_to.

      IF ls_current-valid_from = lv_invoice.
        "O periodo ja comeca na data da fatura. Atualiza essa serial (preco e valid_to).
        "O preco novo vale desde 01.10 sem criar KDATB no passado.
        lv_price_to = lv_valid_to.
        lv_tail_from = lv_valid_to.
        lv_tail_from = lv_tail_from + 1.

        IF lv_orig_to > lv_valid_to AND lv_tail_from < sy-datum AND lv_orig_to >= sy-datum.
          lv_price_to  = sy-datum.
          lv_price_to  = lv_price_to - 1.
          lv_tail_from = sy-datum.
        ELSEIF lv_orig_to > lv_valid_to AND lv_tail_from < sy-datum.
          CLEAR lv_tail_from.
        ENDIF.

        IF lv_price_to < ls_current-valid_from.
          CLEAR lt_val_ch.
        ELSE.
          ls_cond-serial_id  = ls_current-serial_id.
          ls_cond-cond_value = <fs_item>-price.
          IF <fs_item>-currency IS NOT INITIAL.
            ls_cond-currency = <fs_item>-currency.
          ENDIF.

          IF lv_orig_to <> lv_price_to.
            ls_current-valid_to = lv_price_to.
            lv_chg_to = abap_true.
          ENDIF.
          APPEND ls_current TO lt_val_ch.
          APPEND VALUE #( item_no   = ls_current-item_no
                          serial_id = ls_current-serial_id
                          item_nox  = abap_true
                          valid_to  = lv_chg_to ) TO lt_valx_ch.
          APPEND ls_cond TO lt_cond_ch.
          APPEND VALUE #( item_no    = ls_cond-item_no
                          serial_id  = ls_cond-serial_id
                          item_nox   = abap_true
                          cond_value = abap_true
                          currency   = abap_true ) TO lt_condx_ch.

          IF lv_tail_from IS NOT INITIAL AND lv_tail_from <= lv_orig_to AND lv_tail_from > lv_price_to.
            ls_left = ls_current.
            ls_left-serial_id  = lv_serial_tail.
            ls_left-valid_from = lv_tail_from.
            ls_left-valid_to   = lv_orig_to.
            APPEND ls_left TO lt_val_ch.
            APPEND VALUE #( item_no    = ls_left-item_no
                            serial_id  = ls_left-serial_id
                            item_nox   = abap_true
                            valid_from = abap_true
                            valid_to   = abap_true ) TO lt_valx_ch.

            ls_cond_old-serial_id  = lv_serial_tail.
            ls_cond_old-cond_count = '01'.
            APPEND ls_cond_old TO lt_cond_ch.
            APPEND VALUE #( item_no    = ls_cond_old-item_no
                            serial_id  = ls_cond_old-serial_id
                            cond_count = ls_cond_old-cond_count
                            item_nox   = abap_true
                            cond_type  = abap_true
                            cond_value = abap_true
                            currency   = abap_true ) TO lt_condx_ch.
          ENDIF.
        ENDIF.
      ELSE.
        "Periodo atual comeca antes da fatura. KDATB novo nao pode ser anterior a hoje.
        lv_new_from = lv_invoice.
        IF lv_new_from < sy-datum.
          lv_new_from = sy-datum.
        ENDIF.
        lv_new_prev = lv_new_from.
        lv_new_prev = lv_new_prev - 1.

        IF lv_new_from > lv_valid_to.
          CLEAR lt_val_ch.
        ELSE.
          IF ls_current-valid_from < lv_new_from AND ls_current-valid_to >= lv_new_from.
            ls_current-valid_to = lv_new_prev.
            APPEND ls_current TO lt_val_ch.
            APPEND VALUE #( item_no   = ls_current-item_no
                            serial_id = ls_current-serial_id
                            item_nox  = abap_true
                            valid_to  = abap_true ) TO lt_valx_ch.
          ENDIF.

          ls_new_val = ls_current.
          ls_new_val-serial_id  = lv_serial.
          ls_new_val-valid_from = lv_new_from.
          ls_new_val-valid_to   = lv_valid_to.
          APPEND ls_new_val TO lt_val_ch.
          APPEND VALUE #( item_no    = ls_new_val-item_no
                          serial_id  = ls_new_val-serial_id
                          item_nox   = abap_true
                          valid_from = abap_true
                          valid_to   = abap_true ) TO lt_valx_ch.

          ls_cond-serial_id  = lv_serial.
          ls_cond-cond_count = '01'.
          ls_cond-cond_value = <fs_item>-price.
          IF <fs_item>-currency IS NOT INITIAL.
            ls_cond-currency = <fs_item>-currency.
          ENDIF.
          APPEND ls_cond TO lt_cond_ch.
          APPEND VALUE #( item_no    = ls_cond-item_no
                          serial_id  = ls_cond-serial_id
                          cond_count = ls_cond-cond_count
                          item_nox   = abap_true
                          cond_type  = abap_true
                          cond_value = abap_true
                          currency   = abap_true ) TO lt_condx_ch.

          lv_tail_from = lv_valid_to.
          lv_tail_from = lv_tail_from + 1.
          IF lv_tail_from < sy-datum.
            lv_tail_from = sy-datum.
          ENDIF.
          IF lv_tail_from <= lv_orig_to AND lv_tail_from > lv_valid_to.
            ls_left = ls_current.
            ls_left-serial_id  = lv_serial_tail.
            ls_left-valid_from = lv_tail_from.
            ls_left-valid_to   = lv_orig_to.
            APPEND ls_left TO lt_val_ch.
            APPEND VALUE #( item_no    = ls_left-item_no
                            serial_id  = ls_left-serial_id
                            item_nox   = abap_true
                            valid_from = abap_true
                            valid_to   = abap_true ) TO lt_valx_ch.

            ls_cond_old-serial_id  = lv_serial_tail.
            ls_cond_old-cond_count = '01'.
            APPEND ls_cond_old TO lt_cond_ch.
            APPEND VALUE #( item_no    = ls_cond_old-item_no
                            serial_id  = ls_cond_old-serial_id
                            cond_count = ls_cond_old-cond_count
                            item_nox   = abap_true
                            cond_type  = abap_true
                            cond_value = abap_true
                            currency   = abap_true ) TO lt_condx_ch.
          ENDIF.
        ENDIF.
      ENDIF.

      IF lt_val_ch IS INITIAL.
        APPEND VALUE #( type       = 'E'
                        id         = 'ZCL_MSG_MM_003'
                        number     = '016'
                        message_v1 = is_param-iv_purchasingdocument
                        message_v2 = <fs_item>-item
                        row        = lv_row ) TO lt_item_err.
        CONTINUE.
      ENDIF.

      TRY.
          CALL FUNCTION 'BAPI_SAG_CHANGE'
            EXPORTING
              purchasingdocument  = is_param-iv_purchasingdocument
            TABLES
              return              = lt_bapi_ret
              item_cond_validity  = lt_val_ch
              item_cond_validityx = lt_valx_ch
              item_condition      = lt_cond_ch
              item_conditionx     = lt_condx_ch.
        CATCH cx_root INTO lx_ch.
          APPEND append_exc( lx_ch ) TO rt_return.
          rt_return[ lines( rt_return ) ]-row = lv_row.
          CALL FUNCTION 'BAPI_TRANSACTION_ROLLBACK'.
          CONTINUE.
      ENDTRY.

      LOOP AT lt_bapi_ret ASSIGNING FIELD-SYMBOL(<fs_ret>).
        <fs_ret>-row = lv_row.
        APPEND <fs_ret> TO rt_return.
        IF <fs_ret>-type = 'E' OR <fs_ret>-type = 'A'.
          lv_bapi_err = abap_true.
        ENDIF.
      ENDLOOP.
      IF lv_bapi_err = abap_true.
        CALL FUNCTION 'BAPI_TRANSACTION_ROLLBACK'.
        CONTINUE.
      ENDIF.

      CALL FUNCTION 'BAPI_TRANSACTION_COMMIT'
        EXPORTING
          wait = abap_true.

      APPEND VALUE #( type       = 'S'
                      id         = 'ZCL_MSG_MM_003'
                      number     = '017'
                      message_v1 = is_param-iv_purchasingdocument
                      message_v2 = <fs_item>-item
                      row        = lv_row ) TO rt_return.
    ENDLOOP.

    APPEND LINES OF lt_item_err TO rt_return.
  ENDMETHOD.

  METHOD change_nfm_schedule.
    DATA: lt_sched    TYPE STANDARD TABLE OF bapimeoutschedule,
          lt_sched_k  TYPE tt_sched,
          lt_sched_ch TYPE STANDARD TABLE OF bapimeoutschedule,
          lt_schedx   TYPE STANDARD TABLE OF bapimeoutschedulex,
          lv_item     TYPE bapimeoutschedule-item_no,
          lv_found    TYPE abap_bool,
          lv_deliv    TYPE bapimeoutschedule-delivery_date.

    LOOP AT is_param-t_item ASSIGNING FIELD-SYMBOL(<fs_chk>).
      IF <fs_chk>-invoice_date IS INITIAL.
        APPEND VALUE #( type       = 'E'
                        id         = 'ZCL_MSG_MM_003'
                        number     = '030'
                        message_v1 = is_param-iv_purchasingdocument
                        message_v2 = <fs_chk>-item ) TO rt_return.
        RETURN.
      ENDIF.
    ENDLOOP.

    TRY.
        CALL FUNCTION 'BAPI_SAG_GETDETAIL'
          EXPORTING
            purchasingdocument = is_param-iv_purchasingdocument
            schedule_data      = abap_true
          TABLES
            return             = rt_return
            schedule           = lt_sched.
      CATCH cx_root INTO DATA(lx_gd).
        APPEND append_exc( lx_gd ) TO rt_return.
        RETURN.
    ENDTRY.

    LOOP AT rt_return ASSIGNING FIELD-SYMBOL(<fs_gd>).
      IF <fs_gd>-type = 'E' OR <fs_gd>-type = 'A'.
        RETURN.
      ENDIF.
    ENDLOOP.

    CLEAR rt_return.
    lt_sched_k = lt_sched.

    LOOP AT is_param-t_item ASSIGNING FIELD-SYMBOL(<fs_item>).
      CLEAR lv_found.
      lv_item  = |{ <fs_item>-item ALPHA = IN }|.
      lv_deliv = |{ <fs_item>-invoice_date DATE = USER }|.

      LOOP AT lt_sched_k ASSIGNING FIELD-SYMBOL(<fs_sched>) USING KEY primary_key
           WHERE item_no = lv_item.
        <fs_sched>-delivery_date = lv_deliv.
        <fs_sched>-stat_date     = <fs_item>-invoice_date.
        APPEND <fs_sched> TO lt_sched_ch.
        APPEND VALUE #( item_no       = <fs_sched>-item_no
                        sched_line    = <fs_sched>-sched_line
                        item_nox      = abap_true
                        sched_linex   = abap_true
                        delivery_date = abap_true
                        stat_date     = abap_true ) TO lt_schedx.
        lv_found = abap_true.
      ENDLOOP.

      IF lv_found = abap_false.
        APPEND VALUE #( type       = 'E'
                        id         = 'ZCL_MSG_MM_003'
                        number     = '029'
                        message_v1 = is_param-iv_purchasingdocument
                        message_v2 = <fs_item>-item ) TO rt_return.
        RETURN.
      ENDIF.
    ENDLOOP.

    TRY.
        CALL FUNCTION 'BAPI_SAG_CHANGE'
          EXPORTING
            purchasingdocument = is_param-iv_purchasingdocument
          TABLES
            return             = rt_return
            schedule           = lt_sched_ch
            schedulex          = lt_schedx.
      CATCH cx_root INTO DATA(lx_ch).
        APPEND append_exc( lx_ch ) TO rt_return.
        CALL FUNCTION 'BAPI_TRANSACTION_ROLLBACK'.
        RETURN.
    ENDTRY.

    LOOP AT rt_return ASSIGNING FIELD-SYMBOL(<fs_ret>).
      IF <fs_ret>-type = 'E' OR <fs_ret>-type = 'A'.
        CALL FUNCTION 'BAPI_TRANSACTION_ROLLBACK'.
        RETURN.
      ENDIF.
    ENDLOOP.

    CALL FUNCTION 'BAPI_TRANSACTION_COMMIT'
      EXPORTING
        wait = abap_true.
  ENDMETHOD.
ENDCLASS.
