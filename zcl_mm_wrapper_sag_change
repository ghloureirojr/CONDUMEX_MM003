CLASS zcl_mm_wrapper_sag_change DEFINITION
  PUBLIC
  FINAL
  CREATE PUBLIC.

  PUBLIC SECTION.
    TYPES: BEGIN OF ty_item,
             item         TYPE ebelp,
             price        TYPE bapicurext,
             currency     TYPE waers,
             invoice_date TYPE dats,
           END OF ty_item,
           tt_item TYPE SORTED TABLE OF ty_item WITH UNIQUE KEY item,
           BEGIN OF ty_param,
             iv_purchasingdocument TYPE ebeln,
             t_item                TYPE tt_item,
           END OF ty_param,
           tt_return TYPE STANDARD TABLE OF bapiret2 WITH DEFAULT KEY.

    CLASS-METHODS call_bapi_change
      IMPORTING is_param         TYPE ty_param
      RETURNING VALUE(rt_return) TYPE tt_return.
  PROTECTED SECTION.
  PRIVATE SECTION.
    TYPES: tt_validity TYPE SORTED TABLE OF bapimeoutvalidity
                       WITH NON-UNIQUE KEY item_no valid_from,
           tt_cond     TYPE SORTED TABLE OF bapimeoutcondition
                       WITH NON-UNIQUE KEY item_no serial_id cond_type.

    CLASS-METHODS get_gross_condition
      IMPORTING it_cond        TYPE tt_cond
                iv_item        TYPE ebelp
                iv_serial_id   TYPE bapimeoutcondition-serial_id
      RETURNING VALUE(rs_cond) TYPE bapimeoutcondition.

    CLASS-METHODS last_day_of_month
      IMPORTING iv_date        TYPE dats
      RETURNING VALUE(rv_date) TYPE dats.

    CLASS-METHODS append_exc
      IMPORTING io_exc           TYPE REF TO cx_root
      RETURNING VALUE(rs_return) TYPE bapiret2.
ENDCLASS.

CLASS zcl_mm_wrapper_sag_change IMPLEMENTATION.
  METHOD append_exc.
    DATA(lv_text) = io_exc->get_text( ).
    rs_return-type       = 'E'.
    rs_return-id         = 'ZCL_MSG_MM_003'.
    rs_return-number     = '016'.
    rs_return-message    = lv_text.
    rs_return-message_v1 = lv_text.
  ENDMETHOD.

  METHOD last_day_of_month.
    DATA(lv_first) = iv_date.
    lv_first+6(2) = '01'.
    lv_first = lv_first + 32.
    lv_first+6(2) = '01'.
    rv_date = lv_first - 1.
  ENDMETHOD.

  METHOD call_bapi_change.
    DATA: lt_return_get TYPE tt_return,
          lt_val        TYPE STANDARD TABLE OF bapimeoutvalidity,
          lt_cond       TYPE STANDARD TABLE OF bapimeoutcondition,
          lt_val_k      TYPE tt_validity,
          lt_cond_k     TYPE tt_cond,
          lt_val_ch     TYPE STANDARD TABLE OF bapimeoutvalidity,
          lt_valx_ch    TYPE STANDARD TABLE OF bapimeoutvalidityx,
          lt_cond_ch    TYPE STANDARD TABLE OF bapimeoutcondition,
          lt_condx_ch   TYPE STANDARD TABLE OF bapimeoutconditionx,
          ls_current    TYPE bapimeoutvalidity,
          ls_new_val    TYPE bapimeoutvalidity,
          ls_cond       TYPE bapimeoutcondition,
          lv_invoice    TYPE dats,
          lv_prev       TYPE dats,
          lv_valid_to   TYPE dats,
          lv_item       TYPE bapimeoutvalidity-item_no.

    TRY.
        CALL FUNCTION 'BAPI_SAG_GETDETAIL'
          EXPORTING
            purchasingdocument = is_param-iv_purchasingdocument
          TABLES
            return             = lt_return_get
            item_cond_validity = lt_val
            item_condition     = lt_cond.
      CATCH cx_root INTO DATA(lx_gd).
        APPEND append_exc( lx_gd ) TO rt_return.
        RETURN.
    ENDTRY.

    LOOP AT lt_return_get ASSIGNING FIELD-SYMBOL(<fs_get>) WHERE type = 'E' OR type = 'A'.
      APPEND <fs_get> TO rt_return.
    ENDLOOP.
    READ TABLE rt_return TRANSPORTING NO FIELDS WITH KEY type = 'E'.
    IF sy-subrc IS INITIAL.
      RETURN.
    ENDIF.

    lt_val_k  = lt_val.
    lt_cond_k = lt_cond.

    LOOP AT is_param-t_item ASSIGNING FIELD-SYMBOL(<fs_item>).
      CLEAR: ls_current, ls_new_val, ls_cond.
      lv_item    = |{ <fs_item>-item ALPHA = IN }|.
      lv_invoice = <fs_item>-invoice_date.

      IF lv_invoice IS INITIAL.
        APPEND VALUE #( type       = 'E'
                        id         = 'ZCL_MSG_MM_003'
                        number     = '030'
                        message_v1 = is_param-iv_purchasingdocument
                        message_v2 = <fs_item>-item ) TO rt_return.
        RETURN.
      ENDIF.

      lv_prev     = lv_invoice - 1.
      lv_valid_to = last_day_of_month( lv_invoice ).

      LOOP AT lt_val_k ASSIGNING FIELD-SYMBOL(<fs_val>) USING KEY primary_key
           WHERE item_no = lv_item.
        IF <fs_val>-valid_from <= lv_invoice AND <fs_val>-valid_to >= lv_invoice.
          ls_current = <fs_val>.
          EXIT.
        ENDIF.
      ENDLOOP.

      IF ls_current IS INITIAL.
        LOOP AT lt_val_k ASSIGNING <fs_val> USING KEY primary_key
             WHERE item_no = lv_item.
          ls_current = <fs_val>.
        ENDLOOP.
      ENDIF.

      IF ls_current IS NOT INITIAL AND ls_current-valid_from < lv_invoice.
        ls_current-valid_to = lv_prev.
        APPEND ls_current TO lt_val_ch.
        APPEND VALUE #( item_no   = ls_current-item_no
                        serial_id = ls_current-serial_id
                        item_nox  = abap_true
                        valid_to  = abap_true ) TO lt_valx_ch.
      ENDIF.

      IF ls_current IS NOT INITIAL.
        ls_new_val = ls_current.
        CLEAR ls_new_val-serial_id.
      ELSE.
        CLEAR ls_new_val.
        ls_new_val-item_no = lv_item.
      ENDIF.

      ls_new_val-valid_from = lv_invoice.
      ls_new_val-valid_to   = lv_valid_to.
      APPEND ls_new_val TO lt_val_ch.
      APPEND VALUE #( item_no    = ls_new_val-item_no
                      item_nox   = abap_true
                      valid_from = abap_true
                      valid_to   = abap_true ) TO lt_valx_ch.

      ls_cond = get_gross_condition( it_cond      = lt_cond_k
                                     iv_item      = <fs_item>-item
                                     iv_serial_id = ls_current-serial_id ).

      IF ls_cond IS INITIAL.
        CLEAR ls_cond.
        ls_cond-item_no   = lv_item.
        ls_cond-cond_type = 'PBXX'.
      ENDIF.

      ls_cond-cond_value = <fs_item>-price.
      IF <fs_item>-currency IS NOT INITIAL.
        ls_cond-currency = <fs_item>-currency.
      ENDIF.
      CLEAR ls_cond-serial_id.
      APPEND ls_cond TO lt_cond_ch.
      APPEND VALUE #( item_no    = ls_cond-item_no
                      item_nox   = abap_true
                      cond_type  = abap_true
                      cond_value = abap_true
                      currency   = abap_true ) TO lt_condx_ch.
    ENDLOOP.

    TRY.
        CALL FUNCTION 'BAPI_SAG_CHANGE'
          EXPORTING
            purchasingdocument  = is_param-iv_purchasingdocument
          TABLES
            return              = rt_return
            item_cond_validity  = lt_val_ch
            item_cond_validityx = lt_valx_ch
            item_condition      = lt_cond_ch
            item_conditionx     = lt_condx_ch.
      CATCH cx_root INTO DATA(lx_ch).
        APPEND append_exc( lx_ch ) TO rt_return.
        RETURN.
    ENDTRY.

    LOOP AT rt_return TRANSPORTING NO FIELDS WHERE type = 'E' OR type = 'A'.
      RETURN.
    ENDLOOP.

    CALL FUNCTION 'BAPI_TRANSACTION_COMMIT'
      EXPORTING
        wait = abap_true.
  ENDMETHOD.

  METHOD get_gross_condition.
    DATA(lv_item) = CONV bapimeoutcondition-item_no( |{ iv_item ALPHA = IN }| ).

    LOOP AT it_cond ASSIGNING FIELD-SYMBOL(<fs_cond>) USING KEY primary_key
         WHERE item_no   = lv_item
           AND serial_id = iv_serial_id
           AND cond_type = 'PBXX'.
      IF <fs_cond>-cond_value IS NOT INITIAL.
        rs_cond = <fs_cond>.
        RETURN.
      ENDIF.
    ENDLOOP.

    LOOP AT it_cond ASSIGNING <fs_cond> USING KEY primary_key
         WHERE item_no   = lv_item
           AND serial_id = iv_serial_id
           AND cond_type = 'PB00'.
      IF <fs_cond>-cond_value IS NOT INITIAL.
        rs_cond = <fs_cond>.
        RETURN.
      ENDIF.
    ENDLOOP.

    LOOP AT it_cond ASSIGNING <fs_cond> USING KEY primary_key
         WHERE item_no   = lv_item
           AND cond_type = 'PBXX'.
      IF <fs_cond>-cond_value IS NOT INITIAL.
        rs_cond = <fs_cond>.
        RETURN.
      ENDIF.
    ENDLOOP.

    LOOP AT it_cond ASSIGNING <fs_cond> USING KEY primary_key
         WHERE item_no   = lv_item
           AND cond_type = 'PB00'.
      IF <fs_cond>-cond_value IS NOT INITIAL.
        rs_cond = <fs_cond>.
        RETURN.
      ENDIF.
    ENDLOOP.
  ENDMETHOD.
ENDCLASS.
