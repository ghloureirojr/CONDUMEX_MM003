CLASS zcl_mm_wrapper_sag_change DEFINITION
  PUBLIC
  FINAL
  CREATE PUBLIC.

  PUBLIC SECTION.
    TYPES: BEGIN OF ty_item,
             item         TYPE ebelp,
             price        TYPE bapicurext,
             currency     TYPE waers,
             unit         TYPE meins,
             price_unit   TYPE epein,
             invoice_date TYPE dats,
           END OF ty_item,
           tt_item TYPE SORTED TABLE OF ty_item WITH UNIQUE KEY item,
           BEGIN OF ty_param,
             iv_purchasingdocument TYPE ebeln,
             t_item                TYPE tt_item,
           END OF ty_param,
           tt_return TYPE STANDARD TABLE OF bapiret2 WITH DEFAULT KEY.

    CLASS-METHODS call_bapi_change
      IMPORTING is_param         TYPE ty_param
      RETURNING VALUE(rt_return) TYPE tt_return.
  PROTECTED SECTION.
  PRIVATE SECTION.
    CLASS-METHODS last_day_of_month
      IMPORTING iv_date        TYPE dats
      RETURNING VALUE(rv_date) TYPE dats.

    CLASS-METHODS append_exc
      IMPORTING io_exc           TYPE REF TO cx_root
      RETURNING VALUE(rs_return) TYPE bapiret2.
ENDCLASS.

CLASS zcl_mm_wrapper_sag_change IMPLEMENTATION.
  METHOD append_exc.
    DATA(lv_text) = io_exc->get_text( ).
    rs_return-type       = 'E'.
    rs_return-id         = 'ZCL_MSG_MM_003'.
    rs_return-number     = '016'.
    rs_return-message    = lv_text.
    rs_return-message_v1 = lv_text.
  ENDMETHOD.

  METHOD last_day_of_month.
    DATA(lv_first) = iv_date.
    lv_first+6(2) = '01'.
    lv_first = lv_first + 32.
    lv_first+6(2) = '01'.
    rv_date = lv_first - 1.
  ENDMETHOD.

  METHOD call_bapi_change.
    DATA: lt_val_ch    TYPE STANDARD TABLE OF bapimeoutvalidity,
          lt_valx_ch   TYPE STANDARD TABLE OF bapimeoutvalidityx,
          lt_cond_ch   TYPE STANDARD TABLE OF bapimeoutcondition,
          lt_condx_ch  TYPE STANDARD TABLE OF bapimeoutconditionx,
          lv_invoice   TYPE dats,
          lv_valid_to  TYPE dats,
          lv_item      TYPE bapimeoutvalidity-item_no,
          lv_price_unt TYPE epein.

    LOOP AT is_param-t_item ASSIGNING FIELD-SYMBOL(<fs_item>).
      lv_item    = |{ <fs_item>-item ALPHA = IN }|.
      lv_invoice = <fs_item>-invoice_date.

      IF lv_invoice IS INITIAL.
        APPEND VALUE #( type       = 'E'
                        id         = 'ZCL_MSG_MM_003'
                        number     = '030'
                        message_v1 = is_param-iv_purchasingdocument
                        message_v2 = <fs_item>-item ) TO rt_return.
        RETURN.
      ENDIF.

      lv_valid_to = last_day_of_month( lv_invoice ).

      IF <fs_item>-price_unit IS INITIAL.
        lv_price_unt = 1.
      ELSE.
        lv_price_unt = <fs_item>-price_unit.
      ENDIF.

      APPEND VALUE #( item_no    = lv_item
                      valid_from = lv_invoice
                      valid_to   = lv_valid_to ) TO lt_val_ch.

      APPEND VALUE #( item_no    = lv_item
                      item_nox   = abap_true
                      valid_from = abap_true
                      valid_to   = abap_true ) TO lt_valx_ch.

      APPEND VALUE #( item_no     = lv_item
                      cond_type   = 'PB00'
                      cond_value  = <fs_item>-price
                      currency    = <fs_item>-currency
                      cond_p_unt  = lv_price_unt
                      cond_unit   = <fs_item>-unit
                      numerator   = 1
                      denominator = 1
                      change_id   = 'I' ) TO lt_cond_ch.

      APPEND VALUE #( item_no     = lv_item
                      item_nox    = abap_true
                      cond_type   = abap_true
                      cond_value  = abap_true
                      currency    = abap_true
                      cond_p_unt  = abap_true
                      cond_unit   = abap_true
                      numerator   = abap_true
                      denominator = abap_true ) TO lt_condx_ch.
    ENDLOOP.

    TRY.
        CALL FUNCTION 'BAPI_SAG_CHANGE'
          EXPORTING
            purchasingdocument  = is_param-iv_purchasingdocument
          TABLES
            return              = rt_return
            item_cond_validity  = lt_val_ch
            item_cond_validityx = lt_valx_ch
            item_condition      = lt_cond_ch
            item_conditionx     = lt_condx_ch.
      CATCH cx_root INTO DATA(lx_ch).
        APPEND append_exc( lx_ch ) TO rt_return.
        CALL FUNCTION 'BAPI_TRANSACTION_ROLLBACK'.
        RETURN.
    ENDTRY.

    LOOP AT rt_return ASSIGNING FIELD-SYMBOL(<fs_ret>).
      IF <fs_ret>-type = 'E' OR <fs_ret>-type = 'A'.
        CALL FUNCTION 'BAPI_TRANSACTION_ROLLBACK'.
        RETURN.
      ENDIF.
    ENDLOOP.

    CALL FUNCTION 'BAPI_TRANSACTION_COMMIT'
      EXPORTING
        wait = abap_true.
  ENDMETHOD.
ENDCLASS.
