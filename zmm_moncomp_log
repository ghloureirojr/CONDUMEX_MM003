@EndUserText.label : 'Tabla Buffer de precios ASN y log del monitor'
@AbapCatalog.enhancement.category : #NOT_EXTENSIBLE
@AbapCatalog.tableCategory : #TRANSPARENT
@AbapCatalog.deliveryClass : #A
@AbapCatalog.dataMaintenance : #RESTRICTED
define table zmm_moncomp_log {

  key client      : abap.clnt not null;
  key oc          : vdm_purchaseorder not null;
  key posicion    : vdm_purchaseorderitem not null;
  key usuario     : abap.char(12) not null;
  key fecha_hora  : abp_lastchange_tstmpl not null;
  precio_asn      : abap.dec(16,5);
  moneda_asn      : waers;
  accion          : z_asn_mm_de_accion;
  nota            : abap.char(100);
  fecha_factura   : abap.dats;
  estado          : z_asn_mm_de_estado;
  precio_anterior : abap.dec(16,5);
  precio_nuevo    : abap.dec(16,5);

}
